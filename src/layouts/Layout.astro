---
import "../styles/global.css";

interface Props {
	title?: string;
}

const { title = "SpectroDinner™" } = Astro.props;
---

<!doctype html>
<html lang="en">

	<head>

		<meta charset="UTF-8" />

		<meta
			name="viewport"
			content="width=device-width, initial-scale=1.0"
		/>

		<title>
			{title}
		</title>


		<link
			rel="icon"
			type="image/png"
			href="/logo.png"
		/>

	</head>


	<body>

		<div class="background"></div>

		<slot />


		<style is:global>

			* {

				box-sizing:border-box;

			}



			html {

				scroll-behavior:smooth;

			}



			body {

				margin:0;

				padding:0;

				background:#050505;

				color:white;


				font-family:

					Inter,

					system-ui,

					sans-serif;

			}



			.background {

				position:fixed;

				inset:0;

				z-index:-1;

				overflow:hidden;


				background:

					radial-gradient(

						circle at 50% -20%,

						rgba(10,132,255,.35),

						transparent 40%

					),

					radial-gradient(

						circle at 10% 80%,

						rgba(10,132,255,.12),

						transparent 35%

					),

					radial-gradient(

						circle at 90% 70%,

						rgba(10,132,255,.10),

						transparent 40%

					),

					#050505;

			}



			.background::before {

				content:"";


				position:absolute;

				inset:0;


				background-image:

					radial-gradient(

						rgba(255,255,255,.08) 1px,

						transparent 1px

					);


				background-size:

					45px 45px;


				opacity:.15;

			}



			.background::after {

				content:"";


				position:absolute;

				inset:-50%;


				background:

					linear-gradient(

						120deg,

						transparent 40%,

						rgba(10,132,255,.05),

						transparent 60%

					);


				animation:

					backgroundMove 18s linear infinite;

			}



			@keyframes backgroundMove {

				from {

					transform:translateX(-20%);

				}


				to {

					transform:translateX(20%);

				}

			}

		</style>

	</body>

</html>