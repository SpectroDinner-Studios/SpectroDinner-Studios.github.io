---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout
	title="About | SpectroDinner™"
	description="Learn about SpectroDinner™, an independent development studio, and the people behind it."
>

	<Navbar />

	<main class="container">

		<section class="hero">
			<h1>
				<span data-lang="es">Sobre SpectroDinner Studios</span>
				<span data-lang="en">About SpectroDinner Studios</span>
			</h1>

			<p>
				<span data-lang="es">
					Un estudio de desarrollo independiente centrado
					en software, videojuegos, Minecraft y tecnología
					experimental.
				</span>
				<span data-lang="en">
					An independent development studio focused on
					software, games, Minecraft and experimental
					technology.
				</span>
			</p>
		</section>


		<section class="content">

			<div class="card reveal spotlight">
				<h2>
					<span data-lang="es">Quiénes somos</span>
					<span data-lang="en">Who We Are</span>
				</h2>

				<p>
					<span data-lang="es">
						SpectroDinner Studios es un estudio de
						desarrollo independiente. No somos una gran
						corporación — somos un equipo pequeño que crea
						proyectos reales a través de código, creatividad
						y tecnología.
					</span>
					<span data-lang="en">
						SpectroDinner Studios is an independent
						development studio. We're not a large
						corporation — we're a small team building real
						projects through code, creativity and
						technology.
					</span>
				</p>
			</div>


			<div class="card reveal spotlight">
				<h2>
					<span data-lang="es">Qué desarrollamos</span>
					<span data-lang="en">What We Develop</span>
				</h2>

				<p>
					<span data-lang="es">
						Trabajamos en cuatro áreas: ingeniería de
						software, desarrollo de videojuegos, desarrollo
						de Minecraft y tecnología experimental. También
						ofrecemos un servicio de configuración de
						servidores de Discord.
					</span>
					<span data-lang="en">
						We work across four areas: software engineering,
						game development, Minecraft development and
						experimental technology. We also offer a Discord
						server setup service.
					</span>
				</p>
			</div>


			<div class="card reveal spotlight">
				<h2>
					<span data-lang="es">Nuestro enfoque</span>
					<span data-lang="en">Our Approach</span>
				</h2>

				<p>
					<span data-lang="es">
						Cada proyecto sigue los mismos principios:
						arquitectura limpia, rendimiento y mantenibilidad
						a largo plazo — ya sea un plugin de Minecraft,
						una herramienta de software o la configuración
						de un servidor de Discord.
					</span>
					<span data-lang="en">
						Every project follows the same principles: clean
						architecture, performance and long-term
						maintainability — whether it's a Minecraft
						plugin, a software tool, or a Discord server
						setup.
					</span>
				</p>
			</div>

		</section>


		<section class="founder-cta reveal">
			<h2>
				<span data-lang="es">Detrás del estudio</span>
				<span data-lang="en">Behind the Studio</span>
			</h2>

			<p>
				<span data-lang="es">
					SpectroDinner Studios fue fundado en 2024 por
					Elmoderador, Founder, CEO & Lead Developer.
				</span>
				<span data-lang="en">
					SpectroDinner Studios was founded in 2024 by
					Elmoderador, Founder, CEO & Lead Developer.
				</span>
			</p>

			<div class="founder-links">
				<a href="/projects">
					<span data-lang="es">Ver Proyectos →</span>
					<span data-lang="en">View Projects →</span>
				</a>

				<a
					href="https://github.com/Elmoderador"
					target="_blank"
					rel="noopener noreferrer"
				>
					<span data-lang="es">Perfil de GitHub ↗</span>
					<span data-lang="en">GitHub Profile ↗</span>
				</a>
			</div>
		</section>

	</main>

	<Footer />

</Layout>


<style>
.container {
	max-width: 1200px;
	margin: 100px auto;
	padding: 0 32px;
}


.hero {
	text-align:center;
	margin-bottom:70px;
}


h1 {
	font-size:4rem;
	margin-bottom:20px;

	background:linear-gradient(
		90deg,
		var(--text),
		var(--primary)
	);

	-webkit-background-clip:text;
	-webkit-text-fill-color:transparent;
}


.hero p {
	color:var(--text-muted);
	font-size:1.2rem;
	max-width:680px;
	margin:0 auto;
	line-height:1.8;
}


.content {
	display:grid;

	grid-template-columns:
		repeat(auto-fit, minmax(280px, 1fr));

	gap:25px;
}

.content .card:nth-child(2) { transition-delay: .08s; }
.content .card:nth-child(3) { transition-delay: .16s; }


.card {
	padding:30px;

	background:var(--surface-2);

	border:1px solid var(--border-1);

	border-radius:20px;

	backdrop-filter:blur(15px);

	transition:.25s ease;
}


.card:hover {
	transform:translateY(-5px);

	border-color:color-mix(in srgb, var(--primary) 50%, transparent);
}


.card h2 {
	margin-top:0;
	color:var(--text);
}


.card p {
	color:var(--text-muted);
	line-height:1.6;
}


.founder-cta {
	margin-top:60px;
	padding:50px;

	text-align:center;

	background:var(--surface-1);

	border:1px solid var(--border-1);

	border-radius:28px;

	backdrop-filter:blur(15px);
}


.founder-cta h2 {
	margin:0 0 16px;
	color:var(--text);
}


.founder-cta p {
	color:var(--text-muted);
	line-height:1.8;
	max-width:600px;
	margin:0 auto;
}


.founder-links {
	display:flex;
	justify-content:center;
	gap:16px;
	margin-top:32px;
	flex-wrap:wrap;
}


.founder-links a {
	padding:14px 28px;

	border-radius:14px;

	border:1px solid var(--border-2);

	color:var(--text);

	text-decoration:none;

	font-weight:600;

	transition:.25s ease;
}


.founder-links a:hover {
	background:var(--surface-3);

	transform:translateY(-3px);
}


@media (max-width:700px) {
	.container {
		margin:70px auto;
		padding:0 20px;
	}

	h1 {
		font-size:2.6rem;
	}

	.founder-cta {
		padding:32px;
	}
}
</style>
