---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import T from "../components/T.astro";
import SectionHeader from "../components/SectionHeader.astro";

const blocks = [
	{
		icon: "👥",
		title: { es: "Quiénes somos", en: "Who we are" },
		text: {
			es: "SpectroDinner Studios es un estudio de desarrollo independiente. No somos una gran corporación — somos un equipo pequeño que crea proyectos reales a través de código, creatividad y tecnología.",
			en: "SpectroDinner Studios is an independent development studio. We're not a large corporation — we're a small team building real projects through code, creativity and technology.",
		},
	},
	{
		icon: "🛠️",
		title: { es: "Qué desarrollamos", en: "What we develop" },
		text: {
			es: "Trabajamos en cuatro áreas: ingeniería de software, desarrollo de videojuegos, desarrollo de Minecraft y tecnología experimental. También ofrecemos un servicio de configuración de servidores de Discord.",
			en: "We work across four areas: software engineering, game development, Minecraft development and experimental technology. We also offer a Discord server setup service.",
		},
	},
	{
		icon: "🎯",
		title: { es: "Nuestro enfoque", en: "Our approach" },
		text: {
			es: "Cada proyecto sigue los mismos principios: arquitectura limpia, rendimiento y mantenibilidad a largo plazo — ya sea un plugin de Minecraft, una herramienta de software o la configuración de un servidor de Discord.",
			en: "Every project follows the same principles: clean architecture, performance and long-term maintainability — whether it's a Minecraft plugin, a software tool, or a Discord server setup.",
		},
	},
];

const timeline = [
	{ year: "2024", text: { es: "Nace SpectroDinner Studios.", en: "SpectroDinner Studios is founded." } },
	{ year: "T.E.P.", text: { es: "Se publica TimeEconomyPlugin en Modrinth y GitHub.", en: "TimeEconomyPlugin is released on Modrinth and GitHub." } },
	{ year: "Discord", text: { es: "Se abre el servicio de servidores de Discord.", en: "The Discord server service opens." } },
	{ year: "Minecraft", text: { es: "Se suma el servicio de configuración de servidores de Minecraft.", en: "The Minecraft server setup service is added." } },
];
---

<Layout
	title="About | SpectroDinner™"
	description="Learn about SpectroDinner™, an independent development studio, and the people behind it."
>

	<Navbar />

	<main>

		<section class="page-top">

			<div class="container">

				<SectionHeader
					as="h1"
					eyebrow={{ es: "Sobre nosotros", en: "About us" }}
					title={{ es: "Sobre SpectroDinner Studios", en: "About SpectroDinner Studios" }}
				>
					<T
						es="Un estudio de desarrollo independiente centrado en software, videojuegos, Minecraft y tecnología experimental."
						en="An independent development studio focused on software, games, Minecraft and experimental technology."
					/>
				</SectionHeader>

			</div>

		</section>

		<section class="section-sm">

			<div class="container blocks">

				{blocks.map((block, i) => (
					<article class="hud-card interactive reveal" style={`--reveal-delay:${i * 80}ms`}>
						<span class="icon-tile">{block.icon}</span>
						<h2><T {...block.title} /></h2>
						<p><T {...block.text} /></p>
					</article>
				))}

			</div>

		</section>

		<section class="section">

			<div class="container story">

				<SectionHeader
					index="01"
					eyebrow={{ es: "Partida guardada", en: "Save file" }}
					title={{ es: "El camino hasta aquí.", en: "The road so far." }}
				/>

				<ol class="timeline">
					{timeline.map((step, i) => (
						<li class="reveal" style={`--reveal-delay:${i * 80}ms`}>
							<span class="node" aria-hidden="true"></span>
							<span class="year">{step.year}</span>
							<p><T {...step.text} /></p>
						</li>
					))}
				</ol>

			</div>

		</section>

		<section class="section-sm">

			<div class="container">

				<div class="founder hud-card reveal">

					<img
						src="https://avatars.githubusercontent.com/Elmoderador"
						alt="Elmoderador"
						width="120"
						height="120"
						loading="lazy"
					/>

					<div class="founder-copy">
						<span class="eyebrow"><T es="Detrás del estudio" en="Behind the studio" /></span>
						<h2 class="title"><T es="Fundado por Elmoderador" en="Founded by Elmoderador" /></h2>
						<p>
							<T
								es="SpectroDinner Studios fue fundado en 2024 por Elmoderador, Founder & Lead Developer."
								en="SpectroDinner Studios was founded in 2024 by Elmoderador, Founder & Lead Developer."
							/>
						</p>
					</div>

					<div class="actions">
						<a href="/projects" class="btn btn-primary">
							<T es="Ver proyectos" en="View projects" /> →
						</a>
						<a
							href="https://github.com/Elmoderador"
							target="_blank"
							rel="noopener noreferrer"
							class="btn btn-ghost"
						>
							<T es="Perfil de GitHub ↗" en="GitHub Profile ↗" />
						</a>
					</div>

				</div>

			</div>

		</section>

	</main>

	<Footer />

</Layout>

<style>

.blocks {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 18px;
}

.blocks .hud-card {
	display: flex;
	flex-direction: column;
	gap: 14px;
}

.blocks h2 {
	font-size: 1.35rem;
	font-weight: 600;
}

.blocks p {
	color: var(--text-muted);
	line-height: 1.75;
}


/* Timeline */

.timeline {
	position: relative;

	display: grid;
	grid-template-columns: repeat(4, 1fr);
	gap: 18px;

	margin: 0;
	padding: 0;

	list-style: none;
}

.timeline::before {
	content: "";
	position: absolute;
	top: 9px;
	left: 0;
	right: 0;
	height: 2px;
	background: repeating-linear-gradient(90deg, var(--border-3) 0 8px, transparent 8px 16px);
}

.timeline li {
	position: relative;

	display: flex;
	flex-direction: column;
	gap: 10px;

	padding-top: 34px;
}

.node {
	position: absolute;
	top: 0;
	left: 0;

	width: 20px;
	height: 20px;

	background: var(--bg-elevated);
	border: 3px solid var(--primary);
	box-shadow: 0 0 12px var(--primary-glow);
}

.timeline li:first-child .node {
	background: var(--primary);
}

.year {
	font-family: var(--font-display);
	font-size: 1.5rem;
	font-weight: 700;
	color: var(--primary-light);
}

.timeline p {
	color: var(--text-muted);
	line-height: 1.6;
}


/* Founder */

.founder {
	display: grid;
	grid-template-columns: auto 1fr auto;
	align-items: center;
	gap: 32px;

	padding: 32px 36px;
}

.founder img {
	width: 120px;
	height: 120px;
	object-fit: cover;

	border: 3px solid var(--primary);
	clip-path: polygon(12px 0, 100% 0, 100% calc(100% - 12px), calc(100% - 12px) 100%, 0 100%, 0 12px);
}

.founder-copy {
	display: flex;
	flex-direction: column;
	gap: 10px;
}

.founder .title {
	font-size: clamp(1.6rem, 3vw, 2.2rem);
}

.founder p {
	color: var(--text-muted);
}


@media (max-width: 960px) {

	.blocks {
		grid-template-columns: 1fr;
	}

	.timeline {
		grid-template-columns: 1fr 1fr;
		row-gap: 32px;
	}

	.timeline::before {
		display: none;
	}

	.founder {
		grid-template-columns: 1fr;
		justify-items: start;
	}
}

@media (max-width: 520px) {

	.timeline {
		grid-template-columns: 1fr;
	}
}

</style>
