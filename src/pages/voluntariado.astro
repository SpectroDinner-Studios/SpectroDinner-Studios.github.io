---
import Layout from "../layouts/Layout.astro";
import "../styles/wizard.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import T from "../components/T.astro";
import Wizard from "../components/forms/Wizard.astro";
import Step from "../components/forms/Step.astro";
import Field from "../components/forms/Field.astro";
import Choices from "../components/forms/Choices.astro";

const steps = [
	{ icon: "👤", title: { es: "Contacto", en: "Contact" } },
	{ icon: "🧭", title: { es: "Área de interés", en: "Area of interest" } },
	{ icon: "🧠", title: { es: "Sobre ti", en: "About you" } },
];
const total = steps.length + 1;
---

<Layout
	title="Voluntariado | SpectroDinner™"
	description="Postúlate como voluntario en SpectroDinner Studios y ayuda en software, videojuegos, Minecraft, Discord o tecnología experimental."
>

	<Navbar />

	<main class="container wz-page">

		<header class="wz-hero">
			<span class="eyebrow"><T es="Voluntariado" en="Volunteering" /></span>
			<h1><T es="Postúlate como voluntario" en="Apply to volunteer" /></h1>
			<p data-volunteer-open>
				<T
					es="Estamos buscando gente que nos ayude en SpectroDinner Studios — en software, desarrollo de videojuegos, Minecraft, Discord o tecnología experimental. Rellena tu postulación y te responderemos por email o Discord."
					en="We're looking for people to help out at SpectroDinner Studios — in software, game development, Minecraft, Discord or experimental technology. Fill in your application and we'll get back to you by email or Discord."
				/>
			</p>
			<div class="wz-perks" data-volunteer-open>
				<span class="chip chip-open">🟢 <T es="Postulaciones abiertas" en="Applications open" /></span>
				<span class="chip">⏱ ≈ 3 min</span>
				<span class="chip">💾 <T es="Se guarda solo en tu navegador" en="Auto-saved in your browser" /></span>
			</div>
		</header>

		<!-- Shown instead of the form when volunteering is closed from /admin. -->
		<section class="wz-closed hud-card" data-volunteer-closed hidden>
			<span class="wz-closed-icon" aria-hidden="true">🔒</span>
			<h2><T es="Las postulaciones están cerradas" en="Applications are closed" /></h2>
			<p>
				<T
					es="Ahora mismo no estamos buscando voluntarios. Vuelve a pasarte más adelante — anunciaremos cuando reabramos."
					en="We're not looking for volunteers right now. Check back later — we'll announce when we reopen."
				/>
			</p>
			<a href="/about" class="btn btn-ghost btn-sm"><T es="Conocer el estudio" en="Meet the studio" /> →</a>
		</section>

		<Wizard
			formId="volunteer-form"
			quest={{ icon: "🤝", code: "QUEST // VOLUNTEER", title: { es: "Voluntariado", en: "Volunteering" } }}
			steps={steps}
			minutes={3}
			submitLabel={{ es: "Enviar postulación →", en: "Send application →" }}
			success={{
				title: { es: "¡Postulación recibida!", en: "Application received!" },
				text: {
					es: "Gracias por querer ayudar. Revisaremos tu postulación y te responderemos lo antes posible.",
					en: "Thanks for wanting to help. We'll review your application and get back to you as soon as we can.",
				},
				next: [
					{ icon: "📥", text: { es: "Revisamos tu postulación.", en: "We review your application." } },
					{ icon: "💬", text: { es: "Te respondemos por email o Discord con la decisión.", en: "We reply by email or Discord with our decision." } },
					{ icon: "🚀", text: { es: "Si encaja, te contamos cómo empezar.", en: "If it's a fit, we tell you how to get started." } },
				],
				backHref: "/about",
				backLabel: { es: "Conocer el estudio", en: "Meet the studio" },
			}}
		>

			<Step id="contacto" n={1} total={total} {...steps[0]} intro={{ es: "¿Cómo te llamamos y dónde te respondemos?", en: "What should we call you and where do we reply?" }}>
				<Field name="nombre" label={{ es: "Nombre", en: "Name" }} required maxlength={80} autocomplete="name" placeholder={{ es: "Tu nombre", en: "Your name" }} half />
				<Field name="discord" label={{ es: "Usuario de Discord", en: "Discord username" }} maxlength={50} placeholder={{ es: "tu_usuario", en: "your_username" }} half />
				<Field
					name="email"
					type="email"
					label={{ es: "Email", en: "Email" }}
					required
					maxlength={120}
					autocomplete="email"
					placeholder={{ es: "tu@email.com", en: "you@email.com" }}
				/>
			</Step>

			<Step id="areas" n={2} total={total} {...steps[1]} intro={{ es: "Elige todas las que te interesen.", en: "Pick every one that interests you." }}>
				<Choices
					name="areas"
					type="checkbox"
					label={{ es: "¿En qué te gustaría ayudar?", en: "Where would you like to help?" }}
					min={1}
					columns={2}
					options={[
						{ value: "Software Development", icon: "💻", label: { es: "Ingeniería de software", en: "Software Development" }, desc: { es: "Herramientas y aplicaciones.", en: "Tools and applications." } },
						{ value: "Game Development", icon: "🎮", label: { es: "Desarrollo de videojuegos", en: "Game Development" }, desc: { es: "Mecánicas y prototipos.", en: "Mechanics and prototypes." } },
						{ value: "Minecraft Development", icon: "⛏️", label: { es: "Desarrollo de Minecraft", en: "Minecraft Development" }, desc: { es: "Plugins como T.E.P. y servidores.", en: "Plugins like T.E.P. and servers." } },
						{ value: "Discord Services", icon: "💬", label: { es: "Servicios de Discord", en: "Discord Services" }, desc: { es: "Crear y configurar servidores.", en: "Building and setting up servers." } },
						{ value: "Experimental Technology", icon: "🧪", label: { es: "Tecnología experimental", en: "Experimental Technology" }, desc: { es: "Probar ideas nuevas.", en: "Trying out new ideas." } },
					]}
				/>
			</Step>

			<Step id="sobre-ti" n={3} total={total} {...steps[2]} intro={{ es: "Todo es opcional, pero nos ayuda a conocerte.", en: "It's all optional, but it helps us get to know you." }}>
				<Field
					name="experiencia"
					type="textarea"
					label={{ es: "Experiencia o habilidades relevantes", en: "Relevant experience or skills" }}
					maxlength={1000}
					rows={4}
					placeholder={{ es: "Ej. 2 años con Java y plugins de Paper, moderación de servidores…", en: "e.g. 2 years with Java and Paper plugins, server moderation…" }}
				/>
				<Field
					name="enlaces"
					label={{ es: "Enlaces — GitHub, portfolio, itch.io…", en: "Links — GitHub, portfolio, itch.io…" }}
					maxlength={300}
					placeholder={{ es: "https://github.com/…" }}
					half
				/>
				<Field
					name="disponibilidad"
					label={{ es: "Disponibilidad aproximada", en: "Approximate availability" }}
					maxlength={200}
					placeholder={{ es: "Ej. 5 h / semana", en: "e.g. 5 h / week" }}
					chipMode="replace"
					chips={[
						{ es: "1–2 h / semana", en: "1–2 h / week" },
						{ es: "3–5 h / semana", en: "3–5 h / week" },
						{ es: "5–10 h / semana", en: "5–10 h / week" },
						{ es: "Fines de semana", en: "Weekends" },
					]}
					half
				/>
				<Field
					name="motivacion"
					type="textarea"
					label={{ es: "¿Por qué quieres ayudar?", en: "Why do you want to help?" }}
					maxlength={1000}
					rows={4}
				/>
			</Step>

		</Wizard>

	</main>

	<Footer />

</Layout>

<script>
	import { apiUrl } from "../scripts/api";
	import { initWizard } from "../scripts/wizard";

	// Volunteering can be closed from /admin → Ajustes: show that instead of
	// the form (the backend refuses applications while it's closed, too).
	fetch(apiUrl("/api/settings"), { cache: "no-store" })
		.then((res) => (res.ok ? res.json() : null))
		.then((settings) => {
			if (settings?.volunteering_open !== false) return;
			document.querySelector("[data-wizard='volunteer-form']")?.setAttribute("hidden", "");
			document.querySelector("[data-volunteer-closed]")?.removeAttribute("hidden");
			document.querySelectorAll("[data-volunteer-open]").forEach((el) => el.setAttribute("hidden", ""));
		})
		.catch(() => {});

	initWizard({
		formId: "volunteer-form",
		buildPayload: (data) => {
			const get = (name: string) => (data.get(name) || "").toString().trim();
			const getAll = (name: string) => data.getAll(name).join(", ");

			return {
				form: "voluntariado",
				nombre: get("nombre"),
				discord: get("discord"),
				email: get("email"),
				areas: getAll("areas"),
				experiencia: get("experiencia"),
				enlaces: get("enlaces"),
				disponibilidad: get("disponibilidad"),
				motivacion: get("motivacion"),
			};
		},
	});
</script>

<style>

.chip-open {
	color: var(--emerald);
	background: color-mix(in srgb, var(--emerald) 10%, transparent);
	border-color: color-mix(in srgb, var(--emerald) 35%, transparent);
}

.wz-closed {
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	gap: 12px;
	max-width: 640px;
}

.wz-closed[hidden],
[data-volunteer-open][hidden],
:global([data-wizard][hidden]) {
	display: none;
}

.wz-closed-icon {
	font-size: 2rem;
}

.wz-closed h2 {
	font-size: 1.6rem;
}

.wz-closed p {
	line-height: 1.7;
	color: var(--text-muted);
}

</style>
