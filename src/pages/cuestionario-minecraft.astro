---
import Layout from "../layouts/Layout.astro";
import "../styles/wizard.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import T from "../components/T.astro";
import Wizard from "../components/forms/Wizard.astro";
import Step from "../components/forms/Step.astro";
import Field from "../components/forms/Field.astro";
import Choices from "../components/forms/Choices.astro";

const steps = [
	{ icon: "👤", title: { es: "Contacto", en: "Contact" } },
	{ icon: "🖥️", title: { es: "Tu servidor", en: "Your server" } },
	{ icon: "🧩", title: { es: "Plugins", en: "Plugins" } },
	{ icon: "🔑", title: { es: "Acceso", en: "Access" } },
	{ icon: "🎮", title: { es: "Modalidad", en: "Gamemode" } },
	{ icon: "🛠️", title: { es: "Rangos, bugs y notas", en: "Ranks, bugs & notes" } },
];
const total = steps.length + 1;

const commonPlugins = [
	{ es: "LuckPerms" },
	{ es: "EssentialsX" },
	{ es: "WorldGuard" },
	{ es: "WorldEdit" },
	{ es: "CoreProtect" },
	{ es: "Vault" },
];
---

<Layout
	title="Cuestionario Minecraft | SpectroDinner™"
	description="Cuéntanos sobre tu servidor de Minecraft para que podamos ayudarte con plugins, configuración y soporte técnico."
>

	<Navbar />

	<main class="container wz-page">

		<header class="wz-hero">
			<span class="eyebrow"><T es="Servicio de Minecraft" en="Minecraft service" /></span>
			<h1><T es="Configuramos tu servidor de Minecraft" en="We'll set up your Minecraft server" /></h1>
			<p>
				<T
					es="Nos das acceso, nosotros nos encargamos de la parte técnica: permisos, rangos, optimización de lag y parches de exploits. Cuanto más detalle nos des, antes le llegará el turno a tu solicitud."
					en="You give us access, we handle the technical side: permissions, ranks, lag optimization and exploit patches. The more detail you give us, the sooner your request gets its turn."
				/>
			</p>
			<div class="wz-perks">
				<span class="chip chip-gold">✨ <T es="100% gratis" en="100% free" /></span>
				<span class="chip">⏱ ≈ 6 min</span>
				<span class="chip">📈 <T es="Más detalle = más prioridad" en="More detail = higher priority" /></span>
				<span class="chip">💾 <T es="Se guarda solo en tu navegador" en="Auto-saved in your browser" /></span>
			</div>
		</header>

		<Wizard
			formId="mc-quest-form"
			quest={{ icon: "⛏️", code: "QUEST // MINECRAFT", title: { es: "Servicio de Minecraft", en: "Minecraft Service" } }}
			steps={steps}
			minutes={6}
			submitLabel={{ es: "Enviar cuestionario →", en: "Send questionnaire →" }}
			success={{
				title: { es: "¡Solicitud en la cola!", en: "Request queued!" },
				text: {
					es: "Gracias. Tu servidor ya está en nuestra cola de trabajo con la prioridad que has conseguido.",
					en: "Thanks. Your server is now in our work queue with the priority you earned.",
				},
				next: [
					{ icon: "📥", text: { es: "Revisamos tu solicitud y los datos técnicos que nos has dado.", en: "We review your request and the technical details you gave us." } },
					{ icon: "📈", text: { es: "Tu turno depende de tu prioridad en la cola.", en: "Your turn depends on your queue priority." } },
					{ icon: "🔑", text: { es: "Te contactamos para coordinar el acceso con un usuario colaborador — nunca con contraseñas.", en: "We contact you to set up access with a collaborator user — never with passwords." } },
				],
				backHref: "/",
				backLabel: { es: "Volver al inicio", en: "Back to home" },
			}}
		>

			<div class="wz-side-box" slot="side">
				<div class="wz-side-box-top">
					<span><T es="Prioridad en la cola" en="Queue priority" /></span>
					<strong id="priority-label"><T es="🔹 Baja" en="🔹 Low" /></strong>
				</div>
				<div class="xpbar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="priority-bar">
					<div class="xpbar-fill" id="priority-fill"></div>
				</div>
				<p>
					<T
						es="Sube con cada dato técnico opcional que rellenas (host exacto, plugins, acceso, modalidad, rangos, bugs…) — no con lo largo que escribas."
						en="Goes up with every optional technical detail you fill in (exact host, plugins, access, gamemode, ranks, bugs…) — not with how much you write."
					/>
				</p>
			</div>

			<Step id="contacto" n={1} total={total} {...steps[0]} intro={{ es: "¿Cómo te llamamos y dónde te respondemos?", en: "What should we call you and where do we reply?" }}>
				<Field
					name="nombre"
					label={{ es: "Apodo / usuario de Discord", en: "Nickname / Discord username" }}
					required
					maxlength={80}
					autocomplete="username"
					placeholder={{ es: "Ej. Elmoderador", en: "e.g. Elmoderador" }}
					half
				/>
				<Field
					name="email"
					type="email"
					label={{ es: "Email", en: "Email" }}
					required
					maxlength={120}
					autocomplete="email"
					placeholder={{ es: "tu@email.com", en: "you@email.com" }}
					half
				/>
			</Step>

			<Step id="servidor" n={2} total={total} {...steps[1]} intro={{ es: "Lo mínimo que necesitamos para empezar.", en: "The minimum we need to get started." }}>
				<Field name="servidor_nombre" label={{ es: "Nombre del servidor", en: "Server name" }} required maxlength={80} placeholder={{ es: "Ej. CraftLand" }} half />
				<Field
					name="version_software"
					label={{ es: "Versión y software exactos", en: "Exact version and software" }}
					required
					maxlength={120}
					placeholder={{ es: "Ej. Paper 1.21.4", en: "e.g. Paper 1.21.4" }}
					help={{ es: "Incluye la versión exacta.", en: "Include the exact version." }}
					chipMode="replace"
					chips={[{ es: "Paper " }, { es: "Purpur " }, { es: "Spigot " }, { es: "Fabric " }, { es: "Forge " }]}
					half
				/>
				<Choices
					name="tipo_host"
					label={{ es: "Tipo de host", en: "Host type" }}
					required
					columns={2}
					options={[
						{ value: "Host gratuito (MCServerHost, Aternos, etc.)", icon: "🆓", label: { es: "Host gratuito", en: "Free host" }, desc: { es: "MCServerHost, Aternos…" } },
						{ value: "VPS o host de pago", icon: "💳", label: { es: "VPS / host de pago", en: "VPS / paid host" }, desc: { es: "Shockbyte, Hetzner, OVH…" } },
						{ value: "Servidor propio / dedicado", icon: "🖥️", label: { es: "Propio / dedicado", en: "Own / dedicated" }, desc: { es: "Tu propia máquina.", en: "Your own machine." } },
						{ value: "Otro", icon: "✨", label: { es: "Otro", en: "Other" } },
					]}
				/>
				<Field
					name="tipo_host_detalle"
					label={{ es: "¿Cuál exactamente?", en: "Which one exactly?" }}
					maxlength={120}
					placeholder={{ es: "Ej. MCServerHost, Shockbyte, Hetzner…", en: "e.g. MCServerHost, Shockbyte, Hetzner…" }}
					priority
				/>
			</Step>

			<Step id="plugins" n={3} total={total} {...steps[2]} intro={{ es: "Pulsa las sugerencias para añadirlas o escribe la lista tú mismo.", en: "Tap the suggestions to add them or type the list yourself." }}>
				<Field
					name="plugins_instalados"
					type="textarea"
					label={{ es: "Plugins instalados actualmente", en: "Currently installed plugins" }}
					maxlength={1000}
					rows={4}
					placeholder={{ es: "Ej. LuckPerms, EssentialsX, WorldGuard…", en: "e.g. LuckPerms, EssentialsX, WorldGuard…" }}
					chipMode="list"
					chips={commonPlugins}
					priority
					half
				/>
				<Field
					name="plugins_deseados"
					type="textarea"
					label={{ es: "Plugins que quieres instalar o añadir", en: "Plugins you want to add" }}
					maxlength={1000}
					rows={4}
					chipMode="list"
					chips={[{ es: "TimeEconomyPlugin" }, { es: "Citizens" }, { es: "Geyser + Floodgate" }, { es: "ViaVersion" }, { es: "CoreProtect" }, { es: "LuckPerms" }]}
					help={{ es: "TimeEconomyPlugin es nuestro propio plugin.", en: "TimeEconomyPlugin is our own plugin." }}
					priority
					half
				/>
			</Step>

			<Step id="acceso" n={4} total={total} {...steps[3]} intro={{ es: "Cómo entraremos a configurar tu servidor.", en: "How we'll get in to configure your server." }}>
				<Choices
					name="metodo_acceso"
					label={{ es: "Método de acceso", en: "Access method" }}
					required
					columns={3}
					options={[
						{ value: "SFTP / FTP", icon: "📁", label: { es: "SFTP / FTP" } },
						{ value: "Panel Pterodactyl", icon: "🦖", label: { es: "Panel Pterodactyl" } },
						{ value: "Otro panel (Multicraft, AMP...)", icon: "🧰", label: { es: "Otro panel", en: "Other panel" }, desc: { es: "Multicraft, AMP…" } },
					]}
				/>
				<div class="wz-note" role="note">
					🔒 <strong><T es="Nunca nos envíes contraseñas, claves de API, tokens ni ninguna credencial secreta." en="Never send us passwords, API keys, tokens or any secrets." /></strong>
					<T
						es=" Crea un usuario colaborador con permisos limitados (sub-user en Pterodactyl o un usuario FTP secundario) y danos acceso a través de él. Si tu host no lo permite, escríbenos por Discord y buscamos la forma más segura entre los dos."
						en=" Create a collaborator user with limited permissions (a Pterodactyl sub-user or a secondary FTP user) and give us access through that. If your host doesn't support it, message us on Discord and we'll find the safest way together."
					/>
				</div>
				<Field
					name="panel_url"
					type="url"
					label={{ es: "URL del panel / host", en: "Panel / host URL" }}
					maxlength={200}
					placeholder={{ es: "https://panel.tuhost.com", en: "https://panel.yourhost.com" }}
					half
				/>
				<Field
					name="usuario_colaborador"
					label={{ es: "Usuario colaborador ya creado", en: "Collaborator username" }}
					maxlength={80}
					priority
					half
				/>
				<Field
					name="notas_acceso"
					type="textarea"
					label={{ es: "Notas sobre el acceso", en: "Access notes" }}
					maxlength={500}
					rows={3}
					placeholder={{
						es: "Ej. Puedo dar acceso a partir del sábado / Prefiero crear yo el sub-user, decidme qué permisos necesitáis…",
						en: "e.g. I can give access from Saturday / I'd rather create the sub-user myself, tell me which permissions you need…",
					}}
					priority
				/>
			</Step>

			<Step id="modalidad" n={5} total={total} {...steps[4]} intro={{ es: "Opcional, pero cada dato de aquí en adelante sube tu prioridad en la cola.", en: "Optional, but every detail from here on raises your queue priority." }}>
				<Choices
					name="modalidad"
					label={{ es: "Modalidad", en: "Gamemode" }}
					columns={4}
					priority
					options={[
						{ value: "Survival", icon: "🌲", label: { es: "Survival" } },
						{ value: "SMP Vanilla+", icon: "🏡", label: { es: "SMP Vanilla+" } },
						{ value: "Skyblock", icon: "☁️", label: { es: "Skyblock" } },
						{ value: "Lifesteal", icon: "❤️", label: { es: "Lifesteal" } },
						{ value: "Factions", icon: "⚔️", label: { es: "Factions" } },
						{ value: "Prison", icon: "⛓️", label: { es: "Prison" } },
						{ value: "Otro", icon: "✨", label: { es: "Otro", en: "Other" } },
					]}
				/>
				<Field
					name="modalidad_detalle"
					type="textarea"
					label={{ es: "Descríbenos cómo quieres que funcione exactamente", en: "Describe exactly how you want it to work" }}
					maxlength={1500}
					rows={5}
					placeholder={{
						es: "Ej. Lifesteal con corazones limitados a 20, revivir con totem craftable, zona PvP obligatoria en el centro del mapa…",
						en: "e.g. Lifesteal with hearts capped at 20, revive with a craftable totem, mandatory PvP zone in the map center…",
					}}
					priority
				/>
			</Step>

			<Step id="extras" n={6} total={total} {...steps[5]} intro={{ es: "Lo que más nos ayuda a hacerlo bien a la primera.", en: "What helps us most to get it right the first time." }}>
				<Field
					name="rangos_permisos"
					type="textarea"
					label={{ es: "Estructura de rangos y permisos (LuckPerms)", en: "Rank and permission structure (LuckPerms)" }}
					maxlength={2000}
					rows={6}
					placeholder={{
						es: "Ej. Default: comandos básicos, /spawn, /home 1. VIP: /fly en zona segura, /kit vip diario, 3 /home. Admin: acceso total…",
						en: "e.g. Default: basic commands, /spawn, /home 1. VIP: /fly in safe zone, daily /kit vip, 3 /home. Admin: full access…",
					}}
					chips={[{ es: "👤 Default:" }, { es: "⭐ VIP:" }, { es: "💎 MVP:" }, { es: "🛡️ Mod:" }, { es: "👑 Admin:" }]}
					priority
				/>
				<Field
					name="bugs_exploits"
					type="textarea"
					label={{ es: "Errores, bugs o exploits que necesitas corregir", en: "Bugs or exploits you need fixed" }}
					maxlength={1500}
					rows={4}
					placeholder={{
						es: "Ej. Lag al colocar carteles, caídas del nodo cada pocas horas, dupe de items con hoppers…",
						en: "e.g. Lag when placing signs, node crashes every few hours, item dupe with hoppers…",
					}}
					priority
				/>
				<Field
					name="notas_adicionales"
					type="textarea"
					label={{ es: "Notas adicionales", en: "Additional notes" }}
					maxlength={1000}
					rows={3}
					priority
				/>
			</Step>

		</Wizard>

	</main>

	<Footer />

</Layout>

<script>
	import { initWizard } from "../scripts/wizard";

	// Queue priority: share of the optional technical fields that are filled
	// in (a choice made, or at least 3 characters) — not how much is written.
	const LEVELS = [
		{ min: 0, es: "🔹 Baja", en: "🔹 Low" },
		{ min: 25, es: "🔷 Media", en: "🔷 Medium" },
		{ min: 50, es: "🔶 Alta", en: "🔶 High" },
		{ min: 75, es: "🔥 Máxima", en: "🔥 Maximum" },
	];

	const updatePriority = (form: HTMLFormElement) => {
		const fields = Array.from(form.querySelectorAll<HTMLElement>("[data-priority]"));
		if (!fields.length) return;

		const filled = fields.filter((field) =>
			field.classList.contains("wz-choices")
				? Boolean(field.querySelector("input:checked"))
				: (field.querySelector<HTMLInputElement | HTMLTextAreaElement>("input, textarea")?.value.trim().length ?? 0) >= 3
		).length;

		const pct = Math.round((filled / fields.length) * 100);
		const level = [...LEVELS].reverse().find((l) => pct >= l.min)!;

		document.getElementById("priority-fill")?.style.setProperty("--value", `${pct}%`);
		document.getElementById("priority-bar")?.setAttribute("aria-valuenow", String(pct));

		const label = document.getElementById("priority-label");
		if (label) {
			const es = Object.assign(document.createElement("span"), { textContent: level.es });
			const en = Object.assign(document.createElement("span"), { textContent: level.en });
			es.dataset.lang = "es";
			en.dataset.lang = "en";
			label.replaceChildren(es, en);
		}
	};

	initWizard({
		formId: "mc-quest-form",
		onChange: updatePriority,
		buildPayload: (data) => {
			const get = (name: string) => (data.get(name) || "").toString().trim();

			return {
				form: "minecraft",
				nickname: get("nombre"),
				email: get("email"),
				servidor_nombre: get("servidor_nombre"),
				version_software: get("version_software"),
				tipo_host: get("tipo_host"),
				tipo_host_detalle: get("tipo_host_detalle"),
				plugins_instalados: get("plugins_instalados"),
				plugins_deseados: get("plugins_deseados"),
				metodo_acceso: get("metodo_acceso"),
				panel_url: get("panel_url"),
				usuario_colaborador: get("usuario_colaborador"),
				notas_acceso: get("notas_acceso"),
				modalidad: get("modalidad"),
				modalidad_detalle: get("modalidad_detalle"),
				rangos_permisos: get("rangos_permisos"),
				bugs_exploits: get("bugs_exploits"),
				notas_adicionales: get("notas_adicionales"),
			};
		},
	});
</script>
