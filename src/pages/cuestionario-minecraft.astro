---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout
	title="Cuestionario Minecraft | SpectroDinner™"
	description="Cuéntanos sobre tu servidor de Minecraft para que podamos ayudarte con plugins, configuración y soporte técnico."
>

	<Navbar />

	<main class="container">

		<section class="hero">

			<span class="badge">
				<span data-lang="es">⛏️ SERVICIO MINECRAFT</span>
				<span data-lang="en">⛏️ MINECRAFT SERVICE</span>
			</span>

			<h1>
				<span data-lang="es">Configuramos tu servidor de Minecraft</span>
				<span data-lang="en">We'll set up your Minecraft server</span>
			</h1>

			<p data-lang="es">
				Nos das acceso, nosotros nos encargamos de la parte técnica:
				permisos, rangos, optimización de lag y parches de exploits.
				Cuenta abajo cómo quieres tu servidor — cuanto más detalle nos
				des, antes le llegará el turno a tu solicitud.
			</p>

			<p data-lang="en">
				You give us access, we handle the technical side: permissions,
				ranks, lag optimization and exploit patches. Tell us below how
				you want your server — the more detail you give us, the sooner
				your request gets its turn.
			</p>

			<div class="free-badge">
				<span data-lang="es">✨ Servicio 100% gratuito</span>
				<span data-lang="en">✨ 100% free service</span>
			</div>

			<div class="priority-callout">
				<span data-lang="es">
					📈 <strong>Regla de la cola de trabajo:</strong> cuanta más
					información detallada nos des, más prioridad tendrá tu
					solicitud frente al resto.
				</span>
				<span data-lang="en">
					📈 <strong>Queue priority rule:</strong> the more detailed
					information you give us, the higher priority your request
					gets over the rest.
				</span>
			</div>

		</section>


		<form id="mc-quest-form" class="form" novalidate>


			<!-- ===================== SECCIÓN 1 ===================== -->

			<section class="section-block">

				<div class="section-heading">

					<span class="section-number">1</span>

					<div>
						<h2>
							<span data-lang="es">Datos técnicos y accesos</span>
							<span data-lang="en">Technical details and access</span>
						</h2>

						<p>
							<span data-lang="es">
								Obligatoria — es lo mínimo que necesitamos para
								poder empezar a trabajar en tu servidor.
							</span>
							<span data-lang="en">
								Required — this is the minimum we need to
								start working on your server.
							</span>
						</p>
					</div>

				</div>


				<div class="security-note top-note" role="note">
					<span data-lang="es">
						🔒 <strong>Nunca envíes contraseñas, claves de API,
						tokens ni ningún otro tipo de credencial secreta en
						este cuestionario</strong> — ni siquiera más abajo, en
						los campos de texto libre.
					</span>
					<span data-lang="en">
						🔒 <strong>Never submit passwords, API keys, tokens or
						any other secrets anywhere in this questionnaire</strong>
						— including the free-text fields further down.
					</span>
				</div>


				<div class="field-group">

					<div class="grid two">

						<label>
							<span data-lang="es">Apodo / usuario de Discord *</span>
							<span data-lang="en">Nickname / Discord username *</span>
							<input
								type="text"
								name="nombre"
								placeholder="Ej. Elmoderador"
								autocomplete="username"
								maxlength="80"
								required
								aria-describedby="err-nombre"
							/>
							<span id="err-nombre" class="field-error" aria-live="polite"></span>
						</label>

						<label>
							<span data-lang="es">Email *</span>
							<span data-lang="en">Email *</span>
							<input
								type="email"
								name="email"
								autocomplete="email"
								maxlength="120"
								required
								aria-describedby="err-email"
							/>
							<span id="err-email" class="field-error" aria-live="polite"></span>
						</label>

					</div>

				</div>


				<div class="field-group">

					<div class="grid two">

						<label>
							<span data-lang="es">Nombre del servidor *</span>
							<span data-lang="en">Server name *</span>
							<input type="text" name="servidor_nombre" maxlength="80" required aria-describedby="err-servidor_nombre" />
							<span id="err-servidor_nombre" class="field-error" aria-live="polite"></span>
						</label>

						<label>
							<span data-lang="es">Versión y software exactos *</span>
							<span data-lang="en">Exact version and software *</span>
							<input
								type="text"
								name="version_software"
								maxlength="120"
								aria-describedby="err-version_software"
								placeholder="Ej. Paper 1.20.4 / Purpur 1.21 / Fabric 1.20.1"
								required
							/>
							<span id="err-version_software" class="field-error" aria-live="polite"></span>
						</label>

					</div>

				</div>


				<div class="field-group">

					<span class="label-heading">
						<span data-lang="es">Tipo de host *</span>
						<span data-lang="en">Host type *</span>
					</span>

					<div class="radio-group" role="radiogroup" aria-describedby="err-tipo_host">

						<label class="radio">
							<input type="radio" name="tipo_host" value="Host gratuito (MCServerHost, Aternos, etc.)" required />
							<span data-lang="es">Gratuito (MCServerHost, Aternos...)</span>
							<span data-lang="en">Free host (MCServerHost, Aternos...)</span>
						</label>

						<label class="radio">
							<input type="radio" name="tipo_host" value="VPS o host de pago" />
							<span data-lang="es">VPS / host de pago</span>
							<span data-lang="en">VPS / paid host</span>
						</label>

						<label class="radio">
							<input type="radio" name="tipo_host" value="Servidor propio / dedicado" />
							<span data-lang="es">Propio / dedicado</span>
							<span data-lang="en">Own / dedicated machine</span>
						</label>

						<label class="radio">
							<input type="radio" name="tipo_host" value="Otro" />
							<span data-lang="es">Otro</span>
							<span data-lang="en">Other</span>
						</label>

					</div>

					<span id="err-tipo_host" class="field-error" aria-live="polite"></span>

					<label>
						<span data-lang="es">¿Cuál exactamente? (opcional)</span>
						<span data-lang="en">Which one exactly? (optional)</span>
						<input type="text" name="tipo_host_detalle" class="priority-field" maxlength="120" placeholder="Ej. MCServerHost, Shockbyte, Hetzner..." />
					</label>

				</div>


				<div class="field-group">

					<div class="grid two">

						<label>
							<span data-lang="es">Plugins instalados actualmente (opcional)</span>
							<span data-lang="en">Currently installed plugins (optional)</span>
							<textarea name="plugins_instalados" class="priority-field" rows="4" maxlength="1000" placeholder="Ej. LuckPerms, EssentialsX, WorldGuard..."></textarea>
						</label>

						<label>
							<span data-lang="es">Plugins que quieres instalar/añadir (opcional)</span>
							<span data-lang="en">Plugins you want to add (optional)</span>
							<textarea name="plugins_deseados" class="priority-field" rows="4" maxlength="1000"></textarea>
						</label>

					</div>

				</div>


				<div class="field-group">

					<span class="label-heading">
						<span data-lang="es">Método de acceso *</span>
						<span data-lang="en">Access method *</span>
					</span>

					<div class="radio-group" role="radiogroup" aria-describedby="err-metodo_acceso">

						<label class="radio">
							<input type="radio" name="metodo_acceso" value="SFTP / FTP" required />
							<span>SFTP / FTP</span>
						</label>

						<label class="radio">
							<input type="radio" name="metodo_acceso" value="Panel Pterodactyl" />
							<span>Panel Pterodactyl</span>
						</label>

						<label class="radio">
							<input type="radio" name="metodo_acceso" value="Otro panel (Multicraft, AMP...)" />
							<span data-lang="es">Otro panel (Multicraft, AMP...)</span>
							<span data-lang="en">Other panel (Multicraft, AMP...)</span>
						</label>

					</div>

					<span id="err-metodo_acceso" class="field-error" aria-live="polite"></span>

					<div class="security-note" role="note">
						<span data-lang="es">
							🔒 <strong>Nunca nos envíes contraseñas, claves de
							API, tokens ni ningún otro tipo de credencial
							secreta a través de este formulario.</strong> Crea
							un usuario colaborador con permisos limitados
							(sub-user en Pterodactyl, o un usuario FTP
							secundario) y danos acceso a través de él. Si tu
							host no lo permite, contáctanos por Discord y
							buscamos la forma más segura entre los dos.
						</span>
						<span data-lang="en">
							🔒 <strong>Never submit passwords, API keys,
							tokens or any other secrets through this
							form.</strong> Create a collaborator user with
							limited permissions (sub-user in Pterodactyl, or a
							secondary FTP user) and give us access through
							that instead. If your host doesn't support that,
							message us on Discord and we'll find the safest
							way together.
						</span>
					</div>

					<div class="grid two">

						<label>
							<span data-lang="es">URL del panel / host (opcional)</span>
							<span data-lang="en">Panel / host URL (optional)</span>
							<input type="url" name="panel_url" maxlength="200" placeholder="https://panel.tuhost.com" />
						</label>

						<label>
							<span data-lang="es">Usuario colaborador ya creado (opcional)</span>
							<span data-lang="en">Collaborator username (optional)</span>
							<input type="text" name="usuario_colaborador" class="priority-field" maxlength="80" />
						</label>

					</div>

					<label>
						<span data-lang="es">Notas sobre el acceso (opcional)</span>
						<span data-lang="en">Access notes (optional)</span>
						<textarea
							name="notas_acceso"
							class="priority-field"
							rows="3"
							maxlength="500"
							placeholder="Ej. Puedo dar acceso a partir del sábado / Prefiero crear yo el sub-user, decidme qué permisos necesitáis..."
						></textarea>
					</label>

				</div>

			</section>



			<!-- ===================== SECCIÓN 2 ===================== -->

			<section class="section-block priority-block">

				<div class="section-heading">

					<span class="section-number">2</span>

					<div>
						<h2>
							<span data-lang="es">Planificación y diseño de la modalidad</span>
							<span data-lang="en">Gamemode planning and design</span>
						</h2>

						<p>
							<span data-lang="es">
								Opcional, pero es lo que decide tu prioridad en
								la cola — cuantos más de estos datos técnicos
								nos des, antes te tocará el turno.
							</span>
							<span data-lang="en">
								Optional, but this is what decides your
								priority in the queue — the more of this
								technical information you give us, the sooner
								your turn comes.
							</span>
						</p>
					</div>

				</div>


				<div class="priority-meter">

					<div class="priority-meter-top">
						<span data-lang="es">Nivel de prioridad</span>
						<span data-lang="en">Priority level</span>
						<span id="priority-label">
							<span data-lang="es">Baja</span>
							<span data-lang="en">Low</span>
						</span>
					</div>

					<div class="priority-bar">
						<div id="priority-fill" class="priority-fill"></div>
					</div>

					<p class="priority-explainer">
						<span data-lang="es">
							Se calcula por cuántos de los campos técnicos
							opcionales rellenas (host exacto, plugins, acceso,
							modalidad, rangos, bugs...) — no por lo largo que
							escribas.
						</span>
						<span data-lang="en">
							Calculated from how many of the optional technical
							fields you fill in (exact host, plugins, access,
							gamemode, ranks, bugs...) — not from how much you
							write.
						</span>
					</p>

				</div>


				<div class="field-group">

					<label>
						<span data-lang="es">Modalidad (opcional)</span>
						<span data-lang="en">Gamemode (optional)</span>

						<select name="modalidad" class="priority-field">
							<option value="">-- </option>
							<option value="Survival">Survival</option>
							<option value="SMP Vanilla+">SMP Vanilla+</option>
							<option value="Skyblock">Skyblock</option>
							<option value="Lifesteal">Lifesteal</option>
							<option value="Factions">Factions</option>
							<option value="Prison">Prison</option>
							<option value="Otro">Otro / Other</option>
						</select>
					</label>

					<label>
						<span data-lang="es">Descríbenos cómo quieres que funcione exactamente (opcional)</span>
						<span data-lang="en">Describe exactly how you want it to work (optional)</span>
						<textarea
							class="priority-field"
							name="modalidad_detalle"
							rows="5"
							maxlength="1500"
							placeholder="Ej. Lifesteal con corazones limitados a 20, revivir con totem craftable, zona PvP obligatoria en el centro del mapa..."
						></textarea>
					</label>

				</div>


				<div class="field-group">

					<label>
						<span data-lang="es">Estructura de rangos y permisos, LuckPerms (opcional)</span>
						<span data-lang="en">Rank and permission structure, LuckPerms (optional)</span>
						<textarea
							class="priority-field"
							name="rangos_permisos"
							rows="6"
							maxlength="2000"
							placeholder="Ej. Default: comandos básicos, /spawn, /home 1. VIP: /fly en zona segura, /kit vip diario, 3 /home. Admin: acceso total y bypass de restricciones..."
						></textarea>
					</label>

				</div>


				<div class="field-group">

					<label>
						<span data-lang="es">Errores, bugs o exploits que necesitas corregir (opcional)</span>
						<span data-lang="en">Bugs or exploits you need fixed (optional)</span>
						<textarea
							class="priority-field"
							name="bugs_exploits"
							rows="5"
							maxlength="1500"
							placeholder="Ej. Lag al colocar carteles, caídas del nodo cada pocas horas, dupe de items con hoppers/carritos, exploit de crystal PvP..."
						></textarea>
					</label>

				</div>


				<div class="field-group">

					<label>
						<span data-lang="es">Notas adicionales / comentarios extra (opcional)</span>
						<span data-lang="en">Additional notes / extra comments (optional)</span>
						<textarea class="priority-field" name="notas_adicionales" rows="4" maxlength="1000"></textarea>
					</label>

				</div>

			</section>


			<div class="honeypot" aria-hidden="true">
				<label for="mc-website">Website</label>
				<input
					type="text"
					id="mc-website"
					name="website"
					tabindex="-1"
					autocomplete="off"
				/>
			</div>


			<p id="form-error-summary" class="status error" role="alert" hidden></p>

			<button type="submit" class="submit">
				<span class="submit-label">
					<span data-lang="es">Enviar cuestionario →</span>
					<span data-lang="en">Submit questionnaire →</span>
				</span>
				<span class="submit-label submit-loading" hidden>
					<span data-lang="es">Enviando…</span>
					<span data-lang="en">Sending…</span>
				</span>
			</button>

			<p class="hint">
				<span data-lang="es">
					Tu cuestionario se envía directamente a nuestro equipo —
					no hace falta abrir el correo ni nada más.
				</span>
				<span data-lang="en">
					Your questionnaire is sent straight to our team —
					no email client or extra steps needed.
				</span>
			</p>

			<p id="quest-status" class="status" hidden>
				<span data-lang="es">
					✅ ¡Recibido! Te contactaremos pronto para hablar de tu servidor.
				</span>
				<span data-lang="en">
					✅ Received! We'll reach out soon to talk about your server.
				</span>
			</p>

			<p id="quest-error" class="status error" hidden>
				<span data-lang="es">
					⚠️ No hemos podido enviar el cuestionario. Inténtalo de nuevo en unos segundos.
				</span>
				<span data-lang="en">
					⚠️ We couldn't send the questionnaire. Please try again in a moment.
				</span>
			</p>

		</form>

	</main>

	<Footer />

</Layout>


<script>
	// --------------------------------------------------------------------
	// Priority meter — based on how many of the OPTIONAL technical fields
	// are filled in (completeness), not on how much text is written.
	// --------------------------------------------------------------------
	const priorityFields = document.querySelectorAll<
		HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement
	>(".priority-field");

	const priorityFill = document.getElementById("priority-fill");
	const priorityLabel = document.getElementById("priority-label");

	const priorityLevels = [
		{ min: 0, es: "Baja", en: "Low", emoji: "🔹" },
		{ min: 25, es: "Media", en: "Medium", emoji: "🔷" },
		{ min: 50, es: "Alta", en: "High", emoji: "🔶" },
		{ min: 75, es: "Máxima", en: "Maximum", emoji: "🔥" },
	];

	const isFieldMeaningfullyFilled = (
		field: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement
	) => field.value.trim().length >= 3;

	const updatePriority = () => {
		if (!priorityFill || !priorityLabel || priorityFields.length === 0) return;

		const filledCount = Array.from(priorityFields).filter(
			isFieldMeaningfullyFilled
		).length;

		const pct = Math.round((filledCount / priorityFields.length) * 100);
		priorityFill.style.width = `${pct}%`;
		priorityFill.parentElement?.setAttribute("role", "progressbar");
		priorityFill.parentElement?.setAttribute("aria-valuenow", String(pct));
		priorityFill.parentElement?.setAttribute("aria-valuemin", "0");
		priorityFill.parentElement?.setAttribute("aria-valuemax", "100");

		const level = [...priorityLevels].reverse().find((l) => pct >= l.min)!;

		priorityLabel.innerHTML = `
			<span data-lang="es">${level.emoji} ${level.es}</span>
			<span data-lang="en">${level.emoji} ${level.en}</span>
		`;
	};

	priorityFields.forEach((field) => {
		field.addEventListener("input", updatePriority);
		field.addEventListener("change", updatePriority);
	});

	updatePriority();


	// --------------------------------------------------------------------
	// Accessible validation — required fields get aria-invalid,
	// a field-level error message and focus moves to the first error.
	// --------------------------------------------------------------------
	const form = document.getElementById("mc-quest-form") as HTMLFormElement | null;
	const errorSummary = document.getElementById("form-error-summary");

	const messages = {
		es: {
			required: "Este campo es obligatorio.",
			choose: "Elige una opción.",
			email: "Introduce un email válido.",
		},
		en: {
			required: "This field is required.",
			choose: "Please choose an option.",
			email: "Enter a valid email address.",
		},
	};

	const currentLang = () =>
		document.documentElement.lang === "en" ? "en" : "es";

	const clearFieldError = (input: Element, errorId: string) => {
		input.removeAttribute("aria-invalid");
		const el = document.getElementById(errorId);
		if (el) el.textContent = "";
	};

	const setFieldError = (input: Element, errorId: string, text: string) => {
		input.setAttribute("aria-invalid", "true");
		const el = document.getElementById(errorId);
		if (el) el.textContent = text;
	};

	const validateForm = (): boolean => {
		if (!form) return false;

		let firstInvalid: HTMLElement | null = null;
		const lang = currentLang();

		const requiredTextFields = [
			{ name: "nombre", errorId: "err-nombre" },
			{ name: "email", errorId: "err-email" },
			{ name: "servidor_nombre", errorId: "err-servidor_nombre" },
			{ name: "version_software", errorId: "err-version_software" },
		];

		for (const { name, errorId } of requiredTextFields) {
			const input = form.elements.namedItem(name) as HTMLInputElement | null;
			if (!input) continue;

			if (!input.value.trim()) {
				setFieldError(input, errorId, messages[lang].required);
				firstInvalid ??= input;
			} else if (name === "email" && !input.checkValidity()) {
				setFieldError(input, errorId, messages[lang].email);
				firstInvalid ??= input;
			} else {
				clearFieldError(input, errorId);
			}
		}

		const requiredRadioGroups = [
			{ name: "tipo_host", errorId: "err-tipo_host" },
			{ name: "metodo_acceso", errorId: "err-metodo_acceso" },
		];

		for (const { name, errorId } of requiredRadioGroups) {
			const radios = form.querySelectorAll<HTMLInputElement>(
				`input[name="${name}"]`
			);
			const checked = Array.from(radios).some((r) => r.checked);
			const errorEl = document.getElementById(errorId);

			if (!checked) {
				if (errorEl) errorEl.textContent = messages[lang].choose;
				firstInvalid ??= radios[0];
			} else if (errorEl) {
				errorEl.textContent = "";
			}
		}

		if (errorSummary) {
			if (firstInvalid) {
				errorSummary.textContent =
					lang === "es"
						? "Revisa los campos marcados en rojo antes de enviar."
						: "Please check the fields highlighted in red before submitting.";
				errorSummary.hidden = false;
			} else {
				errorSummary.hidden = true;
				errorSummary.textContent = "";
			}
		}

		firstInvalid?.focus();

		return !firstInvalid;
	};


	// --------------------------------------------------------------------
	// Submit: honeypot check, validation, cooldown, fetch to the webhook.
	// --------------------------------------------------------------------
	const MAKE_WEBHOOK_URL =
		"https://hook.eu1.make.com/0k965b8ykue9xfa4wuny31jj5w5liinb";

	const status = document.getElementById("quest-status");
	const error = document.getElementById("quest-error");
	const submitBtn = form?.querySelector<HTMLButtonElement>(".submit");
	const submitLabel = submitBtn?.querySelector(".submit-label:not(.submit-loading)");
	const submitLoading = submitBtn?.querySelector(".submit-loading");

	const COOLDOWN_MS = 8000;
	let cooling = false;

	const setSubmitting = (submitting: boolean) => {
		submitBtn?.toggleAttribute("disabled", submitting);
		submitLabel?.toggleAttribute("hidden", submitting);
		submitLoading?.toggleAttribute("hidden", !submitting);
	};

	form?.addEventListener("submit", async (e) => {
		e.preventDefault();

		if (cooling) return;

		status?.setAttribute("hidden", "");
		error?.setAttribute("hidden", "");

		// Honeypot: real users never fill this field. If it has a value,
		// silently pretend the submission worked and stop.
		const honeypot = form.elements.namedItem("website") as HTMLInputElement | null;
		if (honeypot?.value) {
			form.reset();
			status?.removeAttribute("hidden");
			return;
		}

		if (!validateForm()) return;

		const data = new FormData(form);
		const get = (name: string) => (data.get(name) || "").toString().trim();

		const payload = {
			form: "minecraft",
			nickname: get("nombre"),
			email: get("email"),
			servidor_nombre: get("servidor_nombre"),
			version_software: get("version_software"),
			tipo_host: get("tipo_host"),
			tipo_host_detalle: get("tipo_host_detalle"),
			plugins_instalados: get("plugins_instalados"),
			plugins_deseados: get("plugins_deseados"),
			metodo_acceso: get("metodo_acceso"),
			panel_url: get("panel_url"),
			usuario_colaborador: get("usuario_colaborador"),
			notas_acceso: get("notas_acceso"),
			modalidad: get("modalidad"),
			modalidad_detalle: get("modalidad_detalle"),
			rangos_permisos: get("rangos_permisos"),
			bugs_exploits: get("bugs_exploits"),
			notas_adicionales: get("notas_adicionales"),
		};

		setSubmitting(true);
		cooling = true;

		try {
			const response = await fetch(MAKE_WEBHOOK_URL, {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify(payload),
			});

			if (!response.ok) throw new Error("Request failed");

			form.reset();
			updatePriority();
			status?.removeAttribute("hidden");
		} catch (err) {
			error?.removeAttribute("hidden");
		} finally {
			setSubmitting(false);
			setTimeout(() => {
				cooling = false;
			}, COOLDOWN_MS);
		}
	});
</script>


