---
import { Image } from "astro:assets";
import tepLogo from "../assets/tep.png";

import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import T from "../components/T.astro";
import SectionHeader from "../components/SectionHeader.astro";
import CTABanner from "../components/CTABanner.astro";
import ProjectStatus, { type Status } from "../components/projects/ProjectStatus.astro";
import { TEP_LINKS, formatDate, getTepRelease, minecraftRange } from "../data/tep";

const release = await getTepRelease();
const mcRange = minecraftRange(release.gameVersions);

// Per-system status, from the plugin's README (Development Status table).
const systems: { icon: string; status: Status; title: { es: string; en: string }; text: { es: string; en: string } }[] = [
	{
		icon: "⏳",
		status: "in-development",
		title: { es: "Economía de tiempo", en: "Time Economy" },
		text: {
			es: "El núcleo: una progresión basada en tiempo que premia la actividad, con límites configurables y datos persistentes.",
			en: "The core: time-based progression that rewards activity, with configurable limits and persistent data.",
		},
	},
	{
		icon: "⚔️",
		status: "in-development",
		title: { es: "Clases de jugador", en: "Player Classes" },
		text: {
			es: "Roles con mecánicas propias y fortalezas y debilidades equilibradas, para distintos estilos de juego.",
			en: "Roles with their own mechanics and balanced strengths and weaknesses, for different playstyles.",
		},
	},
	{
		icon: "🗡️",
		status: "in-development",
		title: { es: "Armas legendarias", en: "Legendary Weapons" },
		text: {
			es: "Armas con comportamiento, habilidades y lore propios, diseñadas pensando en el equilibrio.",
			en: "Weapons with their own behaviour, abilities and lore, designed with balance in mind.",
		},
	},
	{
		icon: "🏰",
		status: "released",
		title: { es: "Sistema de clanes", en: "Clan System" },
		text: {
			es: "Crea clanes, invita jugadores y personaliza sus ajustes, con soporte para integración con Discord.",
			en: "Create clans, invite players and customise their settings, with Discord integration support.",
		},
	},
	{
		icon: "🔐",
		status: "released",
		title: { es: "Autenticación", en: "Authentication" },
		text: {
			es: "Registro e inicio de sesión para proteger las cuentas, con ajustes configurables.",
			en: "Registration and login to protect accounts, with configurable settings.",
		},
	},
	{
		icon: "🤖",
		status: "in-development",
		title: { es: "Integración con Discord", en: "Discord Integration" },
		text: {
			es: "Comunicación entre Minecraft y Discord y sincronización de eventos con tu comunidad.",
			en: "Minecraft ↔ Discord communication and event sync with your community.",
		},
	},
	{
		icon: "🌐",
		status: "in-development",
		title: { es: "Integración REST", en: "REST Integration" },
		text: {
			es: "Una capa HTTP para conectar el servidor con aplicaciones externas.",
			en: "An HTTP layer to connect the server with external applications.",
		},
	},
];

const requirements = [
	{ icon: "☕", name: "Java 21+", note: { es: "Runtime", en: "Runtime" } },
	{ icon: "📄", name: "Paper", note: { es: `Minecraft ${mcRange}`, en: `Minecraft ${mcRange}` } },
	{ icon: "👥", name: "Citizens", note: { es: "Obligatorio", en: "Required" } },
];

const compatibility = [
	{ es: "Java Edition", en: "Java Edition" },
	{ es: "Bedrock (Geyser + Floodgate)", en: "Bedrock (Geyser + Floodgate)" },
	{ es: "Modo offline", en: "Offline mode" },
];

const recommended = ["Geyser", "Floodgate", "ViaVersion", "ViaBackwards", "ViaRewind", "Velocity"];

const install = [
	{
		es: "Descarga la última versión desde Modrinth o GitHub Releases.",
		en: "Download the latest release from Modrinth or GitHub Releases.",
	},
	{
		es: "Instala Citizens, que es obligatorio, en tu servidor Paper.",
		en: "Install Citizens, which is required, on your Paper server.",
	},
	{
		es: "Copia el .jar de TimeEconomyPlugin en la carpeta plugins.",
		en: "Drop the TimeEconomyPlugin .jar into the plugins folder.",
	},
	{
		es: "Arranca o reinicia el servidor y ajusta la configuración si lo necesitas.",
		en: "Start or restart the server and tweak the config if needed.",
	},
];

const quests: { state: "done" | "active"; title: { es: string; en: string }; text: { es: string; en: string } }[] = [
	{
		state: "done",
		title: { es: "Primera versión pública", en: "First public release" },
		text: {
			es: `Publicado en Modrinth y GitHub el ${formatDate(release.published, "es")}.`,
			en: `Published on Modrinth and GitHub on ${formatDate(release.published, "en")}.`,
		},
	},
	{
		state: "done",
		title: { es: "Núcleo estable, clanes y autenticación", en: "Stable core, clans & authentication" },
		text: {
			es: "El núcleo del plugin es estable y los sistemas de clanes y autenticación ya están publicados.",
			en: "The plugin core is stable and the clan and authentication systems are released.",
		},
	},
	{
		state: "active",
		title: { es: "Economía de tiempo, clases y armas legendarias", en: "Time economy, classes & legendary weapons" },
		text: {
			es: "Los sistemas de juego principales siguen creciendo con cada versión.",
			en: "The main gameplay systems keep growing with every release.",
		},
	},
	{
		state: "active",
		title: { es: "Integraciones con Discord y REST", en: "Discord & REST integrations" },
		text: {
			es: "Conectar el servidor con tu comunidad y con aplicaciones externas.",
			en: "Connecting the server with your community and external apps.",
		},
	},
	{
		state: "active",
		title: { es: "Documentación ampliada", en: "Expanded documentation" },
		text: {
			es: "Más guías además del README del repositorio.",
			en: "More guides beyond the repository README.",
		},
	},
];

const questsDone = quests.filter((q) => q.state === "done").length;
const questProgress = Math.round((questsDone / quests.length) * 100);
---

<Layout
	title="T.E.P. — TimeEconomyPlugin | SpectroDinner™"
	description="TimeEconomyPlugin (T.E.P.) makes time your currency: a Paper plugin by SpectroDinner Studios with a time economy, player classes, legendary weapons, clans and more. Available on Modrinth and GitHub."
>

	<Navbar />

	<main class="tep-page">

		<!-- Hero -->
		<section class="page-top hero">

			<div class="container hero-grid">

				<div class="copy">

					<div class="meta reveal">
						<span class="chip chip-gold">PRJ-001 · PAPER PLUGIN</span>
						<ProjectStatus status="released" />
						<span class="chip">v{release.version}</span>
					</div>

					<h1 class="display reveal">
						<span class="time">Time</span><span class="economy">Economy</span>
						<small>Plugin</small>
					</h1>

					<p class="tagline mono reveal">
						<span class="prompt">&gt;</span>
						<T es="el tiempo es tu moneda" en="time is your currency" /><span class="cursor"></span>
					</p>

					<p class="lead reveal">
						<T
							es="TimeEconomyPlugin convierte el tiempo en tu moneda: los jugadores gestionan límites diarios, ganan horas extra e intercambian tiempo en una economía de servidor única — junto a clases, armas legendarias, clanes y más."
							en="TimeEconomyPlugin makes time your currency: players manage daily limits, earn extra hours and trade time in a unique server economy — alongside classes, legendary weapons, clans and more."
						/>
					</p>

					<div class="actions reveal">
						<a href={TEP_LINKS.modrinth} target="_blank" rel="noopener noreferrer" class="btn btn-gold">
							<T es="Descargar en Modrinth ↗" en="Download on Modrinth ↗" />
						</a>
						<a href={TEP_LINKS.github} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
							<T es="Código en GitHub ↗" en="Source on GitHub ↗" />
						</a>
					</div>

					<dl class="hud-stats reveal">
						<div>
							<dt><T es="Versión" en="Version" /></dt>
							<dd>v{release.version}</dd>
						</div>
						<div>
							<dt>Minecraft</dt>
							<dd>{mcRange}</dd>
						</div>
						<div>
							<dt><T es="Versiones" en="Releases" /></dt>
							<dd>{release.versionCount}</dd>
						</div>
						<div>
							<dt><T es="Idiomas" en="Languages" /></dt>
							<dd>5</dd>
						</div>
					</dl>

				</div>

				<div class="emblem reveal" aria-hidden="true">

					<svg class="clock" viewBox="0 0 400 400">
						<circle class="clock-ring" cx="200" cy="200" r="188" />
						<g class="clock-ticks">
							{Array.from({ length: 12 }).map((_, i) => (
								<rect
									x="196"
									y="6"
									width="8"
									height={i % 3 === 0 ? 26 : 14}
									transform={`rotate(${i * 30} 200 200)`}
								/>
							))}
						</g>
						<line class="clock-hand" x1="200" y1="200" x2="200" y2="40" />
					</svg>

					<div class="logo-wrap">
						<Image
							src={tepLogo}
							alt=""
							widths={[320, 520, 760]}
							sizes="(max-width: 960px) 300px, 460px"
							loading="eager"
						/>
					</div>

					{Array.from({ length: 6 }).map((_, i) => (
						<i class="coin" style={`--i:${i}`}></i>
					))}

				</div>

			</div>

		</section>


		<!-- Systems -->
		<section class="section" id="sistemas">

			<div class="container">

				<SectionHeader
					index="01"
					eyebrow={{ es: "Sistemas", en: "Systems" }}
					title={{ es: "Un ecosistema, no un plugin suelto.", en: "An ecosystem, not a lone plugin." }}
				>
					<T
						es="En lugar de juntar muchos plugins que no se conocen entre sí, T.E.P. reúne varios sistemas de juego que trabajan juntos, con una arquitectura modular pensada para crecer."
						en="Instead of stacking many unrelated plugins, T.E.P. brings several gameplay systems together that work as one, on a modular architecture built to grow."
					/>
				</SectionHeader>

				<div class="systems">
					{systems.map((system, i) => (
						<article
							class:list={["hud-card", "interactive", "reveal", { featured: i === 0 }]}
							style={`--reveal-delay:${(i % 4) * 60}ms`}
						>
							<div class="system-top">
								<span class="icon-tile">{system.icon}</span>
								<ProjectStatus status={system.status} />
							</div>
							<h3><T {...system.title} /></h3>
							<p><T {...system.text} /></p>
						</article>
					))}
				</div>

			</div>

		</section>


		<!-- Requirements & install -->
		<section class="section-sm">

			<div class="container setup">

				<div class="loadout reveal">

					<span class="eyebrow"><span class="idx">02 //</span> <T es="Requisitos" en="Requirements" /></span>
					<h2 class="title"><T es="Lo que necesitas" en="What you need" /></h2>

					<div class="slots">
						{requirements.map((item) => (
							<div class="slot">
								<span class="slot-icon" aria-hidden="true">{item.icon}</span>
								<strong>{item.name}</strong>
								<small><T {...item.note} /></small>
							</div>
						))}
					</div>

					<div class="compat">
						<span class="compat-label"><T es="Compatible con" en="Works with" /></span>
						<ul>
							{compatibility.map((c) => (
								<li><span class="check" aria-hidden="true">✓</span><T {...c} /></li>
							))}
						</ul>
					</div>

					<div class="compat">
						<span class="compat-label"><T es="Recomendados (opcionales)" en="Recommended (optional)" /></span>
						<div class="chips">
							{recommended.map((name) => <span class="chip">{name}</span>)}
						</div>
					</div>

				</div>

				<div class="install reveal">

					<span class="eyebrow"><span class="idx">03 //</span> <T es="Instalación" en="Install" /></span>
					<h2 class="title"><T es="En cuatro pasos" en="In four steps" /></h2>

					<ol class="steps">
						{install.map((step, i) => (
							<li>
								<span class="step-n">{i + 1}</span>
								<p><T {...step} /></p>
							</li>
						))}
					</ol>

					<div class="actions">
						<a href={TEP_LINKS.versions} target="_blank" rel="noopener noreferrer" class="btn btn-gold btn-sm">
							<T es="Versiones en Modrinth ↗" en="Modrinth versions ↗" />
						</a>
						<a href={TEP_LINKS.readme} target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-sm">
							<T es="Leer el README ↗" en="Read the README ↗" />
						</a>
					</div>

				</div>

			</div>

		</section>


		<!-- Roadmap / quest log -->
		<section class="section" id="estado">

			<div class="container status-grid">

				<div>

					<SectionHeader
						index="04"
						eyebrow={{ es: "Hoja de ruta", en: "Roadmap" }}
						title={{ es: "Registro de misiones.", en: "Quest log." }}
					>
						<T
							es={`Versión actual: v${release.version}, publicada el ${formatDate(release.updated, "es")}. T.E.P. sigue en desarrollo continuo: cada versión añade sistemas, mejoras y correcciones.`}
							en={`Current version: v${release.version}, released on ${formatDate(release.updated, "en")}. T.E.P. is under continuous development: every release adds systems, improvements and fixes.`}
						/>
					</SectionHeader>

					<div class="progress reveal">
						<div class="progress-top">
							<span><T es="Misiones completadas" en="Quests completed" /></span>
							<span class="gold-text">{questsDone} / {quests.length}</span>
						</div>
						<div class="xpbar" role="progressbar" aria-valuenow={questProgress} aria-valuemin="0" aria-valuemax="100">
							<div class="xpbar-fill" style={`--value:${questProgress}%`}></div>
						</div>
					</div>

				</div>

				<ol class="quests">
					{quests.map((quest, i) => (
						<li class={`quest ${quest.state} reveal`} style={`--reveal-delay:${i * 80}ms`}>
							<span class="quest-marker" aria-hidden="true">
								{quest.state === "done" ? "✓" : "!"}
							</span>
							<div class="quest-body">
								<span class="quest-state">
									{quest.state === "done" ? <T es="Completada" en="Completed" /> : <T es="En curso" en="In progress" />}
								</span>
								<h3><T {...quest.title} /></h3>
								<p><T {...quest.text} /></p>
							</div>
						</li>
					))}
				</ol>

			</div>

		</section>


		<!-- License -->
		<section class="section-sm">

			<div class="container">

				<div class="license hud-card reveal">
					<span class="icon-tile">📜</span>
					<div>
						<h2><T es="Licencia" en="License" /></h2>
						<p>
							<T
								es="El código del repositorio de GitHub se publica bajo la SpectroDinner Public Source License (código visible, uso no comercial). Las versiones de Modrinth se distribuyen bajo la GNU AGPL-3.0."
								en="The GitHub repository's source is published under the SpectroDinner Public Source License (source-available, non-commercial). Modrinth releases are distributed under the GNU AGPL-3.0."
							/>
						</p>
						<a href={TEP_LINKS.license} target="_blank" rel="noopener noreferrer">
							<T es="Ver el archivo LICENSE ↗" en="Read the LICENSE file ↗" />
						</a>
					</div>
				</div>

			</div>

		</section>


		<CTABanner
			eyebrow={{ es: "Pruébalo", en: "Try it" }}
			title={{ es: "Lleva T.E.P. a tu servidor.", en: "Bring T.E.P. to your server." }}
			text={{
				es: "Descárgalo gratis en Modrinth. ¿Has encontrado un fallo o tienes una idea? Abre un issue en GitHub.",
				en: "Download it for free on Modrinth. Found a bug or have an idea? Open an issue on GitHub.",
			}}
		>
			<a href={TEP_LINKS.modrinth} target="_blank" rel="noopener noreferrer" class="btn btn-gold">
				<T es="Descargar en Modrinth ↗" en="Download on Modrinth ↗" />
			</a>
			<a href={TEP_LINKS.issues} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
				<T es="Reportar un bug ↗" en="Report a bug ↗" />
			</a>
		</CTABanner>

	</main>

	<Footer />

</Layout>

<style>

/* T.E.P. runs on gold: re-derive the accent tokens inside the page. */
.tep-page {
	--primary: var(--gold);
	--primary-2: color-mix(in oklab, var(--gold) 55%, #E3641B);
	--primary-glow: color-mix(in srgb, var(--gold) 40%, transparent);
	--primary-bg: color-mix(in srgb, var(--gold) 12%, transparent);
	--primary-border: color-mix(in srgb, var(--gold) 40%, transparent);
	--primary-light: var(--gold-text);
}


/* Hero */

.hero-grid {
	display: grid;
	grid-template-columns: 1.1fr 1fr;
	align-items: center;
	gap: 48px;
}

.copy {
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	gap: 24px;
}

.meta {
	display: flex;
	flex-wrap: wrap;
	gap: 10px;
}

h1 {
	display: flex;
	flex-wrap: wrap;
	align-items: baseline;
	column-gap: .05em;
}

.time {
	color: var(--gold-text);
	text-shadow: 0 0 40px color-mix(in srgb, var(--gold) 35%, transparent);
}

.economy {
	color: #5CC8F5;
	text-shadow: 0 0 40px rgba(92, 200, 245, .3);
}

:global([data-theme="light"]) .economy {
	color: #0B6E99;
}

h1 small {
	flex-basis: 100%;
	margin-top: 10px;

	font-family: var(--font-pixel);
	font-size: clamp(1rem, 2vw, 1.4rem);
	font-weight: 400;
	letter-spacing: .3em;
	color: var(--text-muted);
}

.tagline {
	color: var(--text-muted);
}

.tagline .prompt {
	margin-right: 10px;
	color: var(--gold-text);
	font-weight: 700;
}

.lead {
	max-width: 600px;
}

.hud-stats {
	display: flex;
	flex-wrap: wrap;
	gap: 12px;
	margin: 4px 0 0;
}

.hud-stats div {
	display: flex;
	flex-direction: column;
	gap: 6px;

	padding: 12px 16px;

	background: var(--surface-1);
	border: 1px solid var(--border-1);
	border-left: 3px solid var(--gold);
	border-radius: var(--radius-xs);
}

.hud-stats dt {
	font-family: var(--font-pixel);
	font-size: .68rem;
	letter-spacing: .06em;
	text-transform: uppercase;
	color: var(--text-dim);
}

.hud-stats dd {
	margin: 0;
	font-family: var(--font-display);
	font-size: 1.3rem;
	font-weight: 700;
	line-height: 1;
}


/* Emblem */

.emblem {
	position: relative;
	aspect-ratio: 1;
	width: 100%;
	max-width: 500px;
	justify-self: center;
}

.clock {
	position: absolute;
	inset: 0;
	width: 100%;
	height: 100%;
}

.clock-ring {
	fill: none;
	stroke: var(--gold-border);
	stroke-width: 2;
	stroke-dasharray: 4 8;
}

.clock-ticks rect {
	fill: var(--gold);
	opacity: .55;
}

.clock-hand {
	stroke: var(--gold);
	stroke-width: 4;
	stroke-linecap: square;
	opacity: .5;
	transform-origin: 200px 200px;
	animation: sweep 12s steps(60) infinite;
}

@keyframes sweep {
	to { transform: rotate(360deg); }
}

.logo-wrap {
	position: absolute;
	inset: 6%;

	display: grid;
	place-items: center;

	border-radius: 50%;
	background: radial-gradient(circle, color-mix(in srgb, var(--gold) 20%, transparent), transparent 68%);
}

.logo-wrap :global(img) {
	width: 100%;
	height: auto;
	filter: drop-shadow(0 18px 40px rgba(0, 0, 0, .55));
	animation: hover 6s ease-in-out infinite;
}

@keyframes hover {
	0%, 100% { transform: translateY(0); }
	50% { transform: translateY(-10px); }
}

.coin {
	position: absolute;
	top: calc(12% + var(--i) * 13%);
	left: calc(var(--i) * 17%);

	width: 10px;
	height: 10px;

	background: var(--gold);
	box-shadow:
		inset -2px -2px 0 rgba(0, 0, 0, .25),
		0 0 10px color-mix(in srgb, var(--gold) 60%, transparent);

	animation: coinFloat 6s ease-in-out infinite;
	animation-delay: calc(var(--i) * -.9s);
}

.coin:nth-of-type(even) {
	left: auto;
	right: calc(var(--i) * 8%);
}

@keyframes coinFloat {
	0%, 100% { transform: translateY(0) rotate(0deg); opacity: .9; }
	50% { transform: translateY(-16px) rotate(45deg); opacity: .4; }
}


/* Systems */

.systems {
	display: grid;
	grid-template-columns: repeat(4, 1fr);
	gap: 18px;
}

.systems .hud-card {
	display: flex;
	flex-direction: column;
	gap: 14px;
}

.systems .featured {
	grid-column: span 2;
	background:
		radial-gradient(circle at 100% 0%, color-mix(in srgb, var(--gold) 14%, transparent), transparent 60%),
		linear-gradient(180deg, var(--surface-2), var(--surface-1));
}

.system-top {
	display: flex;
	justify-content: space-between;
	align-items: flex-start;
	gap: 10px;
}

.systems h3 {
	font-size: 1.2rem;
	font-weight: 600;
}

.systems p {
	color: var(--text-muted);
	line-height: 1.7;
}


/* Requirements & install */

.setup {
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 18px;
}

.loadout,
.install {
	display: flex;
	flex-direction: column;
	gap: 18px;

	padding: 32px;

	background: var(--bg-elevated);
	border: 1px solid var(--border-2);
	border-radius: var(--radius-sm);
}

.loadout .title,
.install .title {
	font-size: clamp(1.6rem, 3vw, 2.2rem);
}

.slots {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 10px;
}

.slot {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 6px;

	padding: 16px 8px;

	text-align: center;

