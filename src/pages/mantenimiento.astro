---
import Layout from "../layouts/Layout.astro";
import LangToggle from "../components/LangToggle.astro";
import T from "../components/T.astro";
---

<Layout
	title="Mantenimiento | SpectroDinner™"
	description="SpectroDinner Studios is temporarily under maintenance."
	noindex
>

	<div class="lang-toggle-wrap">
		<LangToggle />
	</div>

	<main class="maintenance">

		<div class="screen reveal">

			<div class="tag-row">
				<span class="chip">[SPECTRODINNER STUDIOS]</span>
				<span class="chip chip-gold">
					<span class="status-dot gold" aria-hidden="true"></span>
					<T es="[MODO MANTENIMIENTO]" en="[MAINTENANCE MODE]" />
				</span>
			</div>

			<img src="/logo.png" alt="" width="88" height="88" class="logo" />

			<h1 class="wordmark">
				SPECTRO<span>DINNER</span>
				<small>STUDIOS</small>
			</h1>

			<p class="status-line mono">
				<span class="prompt">&gt;</span>
				<T es="LA COCINA ESTÁ CERRADA." en="THE KITCHEN IS CLOSED." />
				<span class="cursor" aria-hidden="true"></span>
			</p>

			<div class="loader" aria-hidden="true">
				<div class="loader-bar"><span></span></div>
				<span class="loader-label"><T es="Cocinando algo nuevo…" en="Cooking something new…" /></span>
			</div>

			<p class="tagline">
				<T es="Estamos cocinando algo nuevo." en="We're cooking something new." />
			</p>

			<p class="description">
				<T
					es="SpectroDinner Studios no está disponible ahora mismo — estamos trabajando en el sitio. Vuelve a pasarte en un rato."
					en="SpectroDinner Studios isn't available right now — we're working on the site. Please check back shortly."
				/>
			</p>

			<div class="actions">
				<a href="mailto:oierps8@gmail.com" class="btn btn-primary">
					<T es="Escríbenos" en="Email us" />
				</a>
				<a
					href="https://github.com/elmoderador"
					target="_blank"
					rel="noopener noreferrer"
					class="btn btn-ghost"
				>
					GitHub ↗
				</a>
			</div>

		</div>

	</main>

</Layout>

<style>

.lang-toggle-wrap {
	position: fixed;
	top: 20px;
	right: 20px;
	z-index: 10;
}

.maintenance {
	display: grid;
	place-items: center;

	min-height: 100svh;
	padding: 80px 20px;
}

.screen {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 22px;

	width: 100%;
	max-width: 720px;
	padding: 48px 40px;

	text-align: center;

	background: color-mix(in srgb, var(--bg-elevated) 85%, transparent);
	border: 1px solid var(--border-2);
	border-radius: var(--radius-sm);
	box-shadow: 0 40px 120px -40px var(--primary-glow);
	backdrop-filter: blur(12px);
}

.tag-row {
	display: flex;
	flex-wrap: wrap;
	justify-content: center;
	gap: 10px;
}

.logo {
	filter: drop-shadow(0 0 22px var(--primary-glow));
}

.wordmark {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 6px;

	font-size: clamp(2.4rem, 8vw, 4.4rem);
	font-weight: 700;
	letter-spacing: .04em;
	line-height: 1;
}

.wordmark span {
	color: var(--primary-light);
}

.wordmark small {
	font-family: var(--font-pixel);
	font-size: clamp(.8rem, 2vw, 1.05rem);
	font-weight: 400;
	letter-spacing: .5em;
	color: var(--text-dim);
}

.status-line {
	display: flex;
	align-items: center;
	gap: 10px;

	font-size: clamp(.95rem, 2vw, 1.1rem);
	color: var(--text);
}

.status-line .prompt {
	color: var(--primary-light);
}

.loader {
	display: flex;
	flex-direction: column;
	gap: 8px;
	width: 100%;
	max-width: 420px;
}

.loader-bar {
	position: relative;
	height: 14px;

	background: var(--bg-sunken);
	border: 1px solid var(--border-2);
	border-radius: 2px;

	overflow: hidden;
}

.loader-bar span {
	position: absolute;
	top: 0;
	bottom: 0;
	width: 35%;

	background: repeating-linear-gradient(
		90deg,
		var(--primary) 0 10px,
		transparent 10px 13px
	);

	animation: load 2.2s steps(14) infinite;
}

@keyframes load {
	from { left: -35%; }
	to { left: 100%; }
}

.loader-label {
	font-family: var(--font-pixel);
	font-size: .7rem;
	letter-spacing: .06em;
	text-transform: uppercase;
	color: var(--text-dim);
}

.tagline {
	font-family: var(--font-display);
	font-size: 1.4rem;
	font-weight: 600;
}

.description {
	max-width: 520px;
	color: var(--text-muted);
	line-height: 1.75;
}

.actions {
	justify-content: center;
}

@media (max-width: 560px) {

	.screen {
		padding: 36px 22px;
	}
}

</style>
