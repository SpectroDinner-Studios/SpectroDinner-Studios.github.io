---
import Layout from "../layouts/Layout.astro";
import LangToggle from "../components/LangToggle.astro";
---

<Layout
	title="Mantenimiento | SpectroDinner™"
	description="SpectroDinner Studios is temporarily under maintenance."
>

	<div class="lang-toggle-wrap">
		<LangToggle />
	</div>

	<main class="maintenance">

		<div class="grid-glow" aria-hidden="true"></div>

		<div class="content reveal">

			<div class="tag-row">

				<span class="tag">
					[SPECTRODINNER STUDIOS]
				</span>

				<span class="tag status">
					<span class="dot" aria-hidden="true"></span>
					<span data-lang="es">[MODO MANTENIMIENTO]</span>
					<span data-lang="en">[MAINTENANCE MODE]</span>
				</span>

			</div>

			<h1 class="wordmark">
				SPECTRODINNER
				<span>STUDIOS</span>
			</h1>

			<p class="status-line">
				<span data-lang="es">LA COCINA ESTÁ CERRADA.</span>
				<span data-lang="en">THE KITCHEN IS CLOSED.</span>
				<span class="cursor" aria-hidden="true"></span>
			</p>

			<p class="tagline">
				<span data-lang="es">Estamos cocinando algo nuevo.</span>
				<span data-lang="en">We're cooking something new.</span>
			</p>

			<p class="description" data-lang="es">
				SpectroDinner Studios no está disponible ahora mismo —
				estamos trabajando en el sitio. Vuelve a pasarte en un
				rato.
			</p>

			<p class="description" data-lang="en">
				SpectroDinner Studios isn't available right now — we're
				working on the site. Please check back shortly.
			</p>

			<div class="actions">

				<a href="mailto:oierps8@gmail.com" class="primary">
					<span data-lang="es">Escríbenos</span>
					<span data-lang="en">Email us</span>
				</a>

				<a
					href="https://github.com/elmoderador"
					target="_blank"
					rel="noopener noreferrer"
					class="secondary"
				>
					GitHub ↗
				</a>

			</div>

		</div>

	</main>

</Layout>


<style>

.lang-toggle-wrap {

	position:fixed;

	top:24px;
	right:24px;

	z-index:50;

}


.maintenance {

	min-height:100vh;
	width:100%;

	display:flex;
	align-items:center;
	justify-content:center;

	position:relative;
	overflow:hidden;

	padding:100px 32px;

}


.grid-glow {

	position:absolute;

	inset:0;

	background:
		radial-gradient(
			circle at 50% 35%,
			color-mix(in srgb, var(--primary) 10%, transparent),
			transparent 55%
		);

	pointer-events:none;

	z-index:-1;

}


.content {

	width:100%;
	max-width:600px;

	display:flex;
	flex-direction:column;
	align-items:center;

	text-align:center;

	padding:56px 0;

	border-top:1px solid var(--border-1);
	border-bottom:1px solid var(--border-1);

}


.tag-row {

	display:flex;
	flex-wrap:wrap;

	align-items:center;
	justify-content:center;

	gap:10px;

}


.tag {

	display:inline-flex;
	align-items:center;
	gap:8px;

	padding:7px 12px;

	border-radius:8px;

	background:var(--surface-2);
	border:1px solid var(--border-2);

	color:var(--text-dim);

	font-family:
		ui-monospace, "SF Mono", "Cascadia Code",
		"Roboto Mono", Menlo, Consolas, monospace;

	font-size:.72rem;
	font-weight:600;
	letter-spacing:.5px;

}


.tag.status {

	color:var(--primary);

	background:var(--primary-bg);
	border-color:var(--primary-border);

}


.tag .dot {

	width:6px;
	height:6px;

	border-radius:50%;

	background:var(--primary);

	box-shadow:0 0 8px var(--primary-glow);

	animation:dotPulse 1.6s ease-in-out infinite;

}


@keyframes dotPulse {

	0%, 100% {
		opacity:1;
	}

	50% {
		opacity:.3;
	}

}


.wordmark {

	margin:28px 0 0;

	font-size:clamp(2.4rem,7vw,4.2rem);
	font-weight:800;

	letter-spacing:-1px;
	line-height:1;

	background:linear-gradient(90deg,var(--text),var(--primary));

	-webkit-background-clip:text;
	-webkit-text-fill-color:transparent;

}


.wordmark span {

	display:block;

	margin-top:10px;

	font-size:clamp(1rem,2.4vw,1.3rem);
	font-weight:700;

	letter-spacing:8px;

	background:none;

	-webkit-text-fill-color:var(--text-muted);
	color:var(--text-muted);

}


.status-line {

	margin-top:34px;

	font-family:
		ui-monospace, "SF Mono", "Cascadia Code",
		"Roboto Mono", Menlo, Consolas, monospace;

	font-size:clamp(1.1rem,3vw,1.5rem);
	font-weight:700;

	letter-spacing:.5px;

	color:var(--text);

}


.cursor {

	display:inline-block;

	width:.55em;
	height:1em;

	margin-left:4px;

	background:var(--primary);

	vertical-align:text-bottom;

	animation:cursorBlink 1s step-end infinite;

}


@keyframes cursorBlink {

	0%, 100% {
		opacity:1;
	}

	50% {
		opacity:0;
	}

}


.tagline {

	margin-top:12px;

	color:var(--text-muted);

	font-size:1.05rem;
	font-style:italic;

}


.description {

	margin-top:26px;

	max-width:420px;

	color:var(--text-muted);

	font-size:.98rem;
	line-height:1.8;

}


.actions {

	display:flex;
	flex-wrap:wrap;

	justify-content:center;

	gap:14px;

	margin-top:40px;

}


.actions a {

	padding:13px 28px;

	border-radius:14px;

	text-decoration:none;

	font-weight:600;

	font-size:.95rem;

	transition:.25s ease;

}


.primary {

	background:var(--primary);

	color:white;

}


.primary:hover {

	transform:translateY(-3px);

	box-shadow:0 15px 40px var(--primary-glow);

}


.secondary {

	background:var(--surface-2);

	border:1px solid var(--border-2);

	color:var(--text);

}


.secondary:hover {

	background:var(--surface-hover);

	transform:translateY(-3px);

}


@media (max-width:600px) {

	.maintenance {

		padding:70px 20px;

	}


	.content {

		padding:40px 0;

	}


	.wordmark span {

		letter-spacing:5px;

	}


	.actions {

		flex-direction:column;

		width:100%;

	}


	.actions a {

		width:100%;

	}

}

</style>
