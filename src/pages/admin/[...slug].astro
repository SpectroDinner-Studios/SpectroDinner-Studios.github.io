				en: (v) => ["We've received your application (" + v.ref + ")", "Hi " + v.name + ",\n\nWe've received your volunteer application (" + v.ref + ") and we're already reviewing it. We'll get back to you as soon as we can."],
			},
			order: {
				es: (v) => ["Hemos recibido tu solicitud " + v.ref, "Hola " + v.name + ":\n\nHemos recibido tu solicitud " + v.ref + " (" + v.about + ") y ya la estamos revisando. Te responderemos lo antes posible."],
				en: (v) => ["We've received your request " + v.ref, "Hi " + v.name + ",\n\nWe've received your request " + v.ref + " (" + v.about + ") and we're already reviewing it. We'll get back to you as soon as we can."],
			},
		},
		done: {
