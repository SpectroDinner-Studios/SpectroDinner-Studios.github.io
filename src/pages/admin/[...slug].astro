				en: (v) => ["Your order " + v.ref + " is done", "Hi " + v.name + ",\n\nYour order " + v.ref + " (" + v.about + ") is done! Have a look and, if anything needs adjusting, just reply to this email.\n\nIf you're happy with the result, it would help us a lot if you left a review at " + SITE_URL + "/#valoraciones\n\nThanks for trusting us."],
			},
		},
	};

	// The template that fits a row's current status.
	const TEMPLATE_FOR_STATUS = { accepted: "accept", rejected: "reject", done: "done" };

	const LABELS = {
		nombre: "Nombre", nickname: "Apodo", email: "Email", discord: "Discord", tipo: "Tipo de servicio",
		invite: "Invitación", proposito: "Propósito", proposito_detalle: "Detalle del propósito", tamano: "Tamaño",
		estilo: "Estilo", referencias: "Referencias", canales: "Canales", roles: "Roles", bots: "Bots",
		plazo: "Plazo", comentarios: "Comentarios", servidor_nombre: "Servidor", version_software: "Versión / software",
		tipo_host: "Tipo de host", tipo_host_detalle: "Host", plugins_instalados: "Plugins instalados",
		plugins_deseados: "Plugins deseados", metodo_acceso: "Acceso", panel_url: "URL del panel",
		usuario_colaborador: "Usuario colaborador", notas_acceso: "Notas de acceso", modalidad: "Modalidad",
		modalidad_detalle: "Detalle de la modalidad", rangos_permisos: "Rangos y permisos", bugs_exploits: "Bugs / exploits",
		notas_adicionales: "Notas adicionales", areas: "Áreas", experiencia: "Experiencia", enlaces: "Enlaces",
		disponibilidad: "Disponibilidad", motivacion: "Motivación", service: "Servicio", rating: "Valoración", comment: "Comentario",
		idioma: "Idioma",
	};
	const LANGUAGE_NAMES = { es: "Español", en: "Inglés" };

	// Shown under the name on each card, before expanding.
	const SUMMARY = { discord: ["tipo", "proposito", "plazo"], minecraft: ["servidor_nombre", "version_software", "metodo_acceso"], voluntariado: ["areas", "disponibilidad"] };

	const EVENTS = {
		login_ok: ["✅", "Inicio de sesión", "is-ok"],
		login_fail: ["❌", "Contraseña incorrecta", "is-fail"],
		logout: ["🚪", "Cierre de sesión", ""],
		revoke_others: ["🧹", "Cerradas las demás sesiones", ""],
		revoke_all: ["🧨", "Cerradas todas las sesiones", ""],
	};

	const IDLE_LIMIT_MS = 30 * 60 * 1000;
	const ACTIVITY = ["pointerdown", "keydown", "scroll", "pointermove"];
	const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

	let lastActivity = Date.now();
	const markActive = () => (lastActivity = Date.now());

	// ---------- State ----------

	const state = { tab: "review", filter: "all", query: "", rows: [], counts: [], recent: [], open: new Set(), editingNote: 0 };

	// ---------- Helpers ----------

	const $ = (id) => document.getElementById(id);

	const el = (tag, className, text) => {
		const node = document.createElement(tag);
		if (className) node.className = className;
		if (text !== undefined && text !== null) node.textContent = String(text);
		return node;
	};

	const button = (label, onClick, className) => {
		const b = el("button", className || "btn btn-ghost btn-sm", label);
		b.type = "button";
		b.addEventListener("click", onClick);
		return b;
	};

	const parseDate = (value) => new Date(String(value).replace(" ", "T") + "Z");

	const rtf = new Intl.RelativeTimeFormat("es", { numeric: "auto" });
	const relative = (value) => {
		const seconds = Math.round((parseDate(value).getTime() - Date.now()) / 1000);
		const units = [["year", 31536000], ["month", 2592000], ["week", 604800], ["day", 86400], ["hour", 3600], ["minute", 60]];
		for (const [unit, size] of units) {
			if (Math.abs(seconds) >= size) return rtf.format(Math.round(seconds / size), unit);
		}
		return "ahora mismo";
	};
	const absolute = (value) => parseDate(value).toLocaleString("es-ES", { dateStyle: "medium", timeStyle: "short" });
	const timeOnly = (value) => parseDate(value).toLocaleTimeString("es-ES", { hour: "2-digit", minute: "2-digit" });

	const ref = (id) => "#" + String(id).padStart(4, "0");

	// `action` ({ label, run }) adds a button, e.g. "Deshacer".
	let toastTimer = 0;
	const toast = (text, isError, action) => {
		const box = $("adm-toast");
		box.replaceChildren(el("span", "", text));
		if (action) {
			box.append(
				button(action.label, () => {
					box.hidden = true;
					action.run();
				}, "adm-toast-action")
			);
		}
		box.classList.toggle("is-error", Boolean(isError));
		box.hidden = false;
		clearTimeout(toastTimer);
		toastTimer = setTimeout(() => (box.hidden = true), action ? 8000 : 2600);
	};

	const confirmDialog = (text, okLabel) =>
		new Promise((resolve) => {
			const dialog = $("adm-dialog");
			$("adm-dialog-text").textContent = text;
			$("adm-dialog-ok").textContent = okLabel || "Eliminar";
			const done = (value) => {
				dialog.close();
				$("adm-dialog-ok").onclick = null;
				$("adm-dialog-cancel").onclick = null;
				resolve(value);
			};
			$("adm-dialog-ok").onclick = () => done(true);
			$("adm-dialog-cancel").onclick = () => done(false);
			dialog.oncancel = () => done(false);
			dialog.showModal();
		});

	const goToLogin = (reason) => location.replace("/acceso/" + (reason ? "?" + reason + "=1" : ""));

	const api = async (path, body) => {
		const res = await fetch("/api/admin/" + path, {
			method: body === undefined ? "GET" : "POST",
			headers: body === undefined ? undefined : { "Content-Type": "application/json" },
			body: body === undefined ? undefined : JSON.stringify(body),
			credentials: "same-origin",
			cache: "no-store",
		});
		if (res.status === 401 || res.status === 503) {
			goToLogin("expired");
			throw new Error("auth");
		}
		if (!res.ok) throw new Error("HTTP " + res.status);
		return res.json();
	};

	const countOf = (form, statuses) =>
		state.counts.filter((c) => c.form === form && (!statuses || statuses.includes(c.status))).reduce((sum, c) => sum + c.n, 0);

	// ---------- Header ----------

	const loadSession = async () => {
		const { session, previousLogin } = await api("session");
		const chip = $("adm-session");
		chip.textContent = "🔒 Sesión hasta las " + timeOnly(session.expires_at);
		chip.title = "Iniciada " + absolute(session.created_at);
		if (previousLogin) {
			const p = $("adm-previous");
			p.textContent = "Acceso anterior: " + absolute(previousLogin.at) + " · " + (previousLogin.user_agent || "dispositivo desconocido");
			p.hidden = false;
		}
	};

	// ---------- Stats & tabs ----------

	const renderStats = () => {
		const box = $("adm-stats");
		box.replaceChildren();

		for (const [form, cfg] of Object.entries(FORMS)) {
			const fresh = countOf(form, cfg.fresh);
			const card = el("button", "adm-stat" + (fresh ? " is-alert" : ""));
			card.type = "button";
			card.append(el("span", "", cfg.icon + " " + cfg.label), el("strong", "", countOf(form)));
			const small = el("small");
			if (fresh) small.append(el("b", "", fresh), " " + cfg.freshLabel);
			else small.textContent = "Todo al día";
			const accepted = cfg.acceptedLabel ? countOf(form, ["accepted"]) : 0;
			if (accepted) small.append(" · " + accepted + " " + cfg.acceptedLabel);
			card.append(small);
			card.addEventListener("click", () => selectTab(form));
			box.append(card);
		}

		const week = state.recent.reduce((sum, r) => sum + r.n, 0);
		const weekCard = el("div", "adm-stat");
		weekCard.append(el("span", "", "📅 Últimos 7 días"), el("strong", "", week), el("small", "", "envíos recibidos"));
		box.append(weekCard);
	};

	const renderTabs = () => {
		const nav = $("adm-tabs");
		nav.replaceChildren();
		const tabs = [...Object.entries(FORMS), ["security", { label: "Seguridad", icon: "🛡️" }], ["settings", { label: "Ajustes", icon: "⚙️" }]];

		for (const [id, cfg] of tabs) {
			const tab = el("button", "adm-tab");
			tab.type = "button";
			tab.setAttribute("aria-selected", String(state.tab === id));
			tab.append(el("span", "", cfg.icon), cfg.label);
			if (cfg.fresh) {
				const n = countOf(id, cfg.fresh);
				if (n) tab.append(el("span", "adm-badge", n));
			}
			tab.addEventListener("click", () => selectTab(id));
			nav.append(tab);
		}
	};

	const renderFilter = () => {
		const box = $("adm-filter");
		box.replaceChildren();
		for (const [value, label] of FORMS[state.tab].filters) {
			const b = el("button", "", label);
			b.type = "button";
			b.setAttribute("aria-pressed", String(state.filter === value));
			b.addEventListener("click", () => {
				state.filter = value;
				renderFilter();
				renderList();
			});
			box.append(b);
		}
		$("adm-readall").textContent = FORMS[state.tab].readAll;
	};

	// ---------- List ----------

	const visibleRows = () => {
		const q = state.query.trim().toLowerCase();
		const fresh = FORMS[state.tab].fresh;
		return state.rows.filter((row) => {
			if (state.filter === "fresh" ? !fresh.includes(row.status) : state.filter !== "all" && row.status !== state.filter) return false;
			if (!q) return true;
			return (ref(row.id) + " " + Object.values(row.data).join(" ") + " " + (row.note || "")).toLowerCase().includes(q);
		});
	};

	// Reload what a change can affect: this tab, and the site if it's open beside.
	const afterChange = async (form) => {
		try {
			await loadRows();
			if (form === "review" && state.tab !== "review") await loadReviewIndex();
		} catch (err) {
			if (err.message !== "auth") toast("No se pudieron cargar los datos.", true);
		}
		if (form === "review") refreshWeb();
	};

	const act = async (row, action, message) => {
		try {
			await api("submissions", { id: row.id, action });
		} catch (err) {
			if (err.message !== "auth") toast("No se pudo completar la acción.", true);
			return;
		}
		toast(message);
		await afterChange(row.form);
	};

	// One click, gone at once (from the site too), with a few seconds to undo.
	const remove = async (row) => {
		const snapshot = { id: row.id, created_at: row.created_at, form: row.form, status: row.status, data: row.data, note: row.note || "" };

		state.rows = state.rows.filter((r) => r.id !== row.id);
		renderList();
		webCard(row.id)?.remove();

		try {
			await api("submissions", { id: row.id, action: "delete" });
		} catch (err) {
			if (err.message !== "auth") toast("No se pudo eliminar.", true);
			await afterChange(row.form);
			return;
		}

		toast(row.form === "review" ? "Valoración " + ref(row.id) + " eliminada de la web" : ref(row.id) + " eliminado", false, {
			label: "Deshacer",
			run: async () => {
				try {
					await api("submissions", { action: "restore", row: snapshot });
					toast(ref(row.id) + " restaurado");
				} catch (err) {
					if (err.message !== "auth") toast("No se pudo deshacer.", true);
				}
				await afterChange(row.form);
			},
		});
		await afterChange(row.form);
	};

	// Accept / reject: change the status, then offer the matching reply.
	const decide = async (row, action, message, template) => {
		await act(row, action, message);
		openReply(row, template);
	};

	const saveNote = async (row, note) => {
		try {
			await api("submissions", { id: row.id, action: "note", note });
		} catch (err) {
			if (err.message !== "auth") toast("No se pudo guardar la nota.", true);
			return;
		}
		state.editingNote = 0;
		toast(note ? "Nota guardada" : "Nota borrada");
		await afterChange(row.form);
	};

	const renderNote = (row) => {
		if (state.editingNote === row.id) {
			const box = el("div", "adm-note");
			const area = el("textarea");
			area.rows = 3;
			area.maxLength = 2000;
			area.value = row.note || "";
			area.placeholder = "Solo la ves tú. Ej.: «Le escribí por Discord el lunes».";
			const actions = el("div", "adm-actions");
			actions.append(
				button("Guardar nota", () => saveNote(row, area.value.trim()), "btn btn-primary btn-sm"),
				button("Cancelar", () => {
					state.editingNote = 0;
					renderList();
				})
			);
			if (row.note) actions.append(button("Borrar nota", () => saveNote(row, ""), "btn btn-sm adm-danger"));
			box.append(el("span", "", "📝 Nota interna"), area, actions);
			setTimeout(() => area.focus(), 0);
			return box;
		}
		if (!row.note) return null;
		const box = el("div", "adm-note");
		box.append(el("span", "", "📝 Nota interna"), el("p", "", row.note));
		return box;
	};

	const renderCard = (row) => {
		const d = row.data;
		const [statusLabel, statusTone] = STATUS[row.status] || [row.status, ""];
		const fresh = FORMS[row.form].fresh.includes(row.status);
		const muted = ["read", "hidden", "rejected", "done"].includes(row.status);
		const card = el("article", "adm-card" + (fresh ? " is-new" : "") + (muted ? " is-muted" : "") + (row.status === "accepted" ? " is-accepted" : ""));
		card.dataset.id = row.id;

		const head = el("div", "adm-card-head");
		head.append(el("strong", "", d.nickname || d.nombre || "—"), el("span", "adm-chip " + statusTone, statusLabel));
		const meta = el("span", "adm-meta");
		const when = el("span", "", relative(row.created_at));
		when.title = absolute(row.created_at);
		meta.append(el("span", "", ref(row.id)), when);
		head.append(meta);
		card.append(head);

		const sub = el("div", "adm-sub");
		if (row.form === "review") {
			const rating = Math.max(0, Math.min(5, Number(d.rating) || 0));
			sub.append(el("span", "adm-stars", "★".repeat(rating) + "☆".repeat(5 - rating)));
			if (d.service) sub.append(el("span", "", d.service));
			card.append(sub, el("p", "adm-quote", "“" + (d.comment || "") + "”"));
		} else {
			if (d.email && EMAIL_RE.test(d.email)) {
				const mail = el("a", "", "✉ " + d.email);
				mail.href = "mailto:" + d.email + "?subject=" + encodeURIComponent("Tu solicitud " + ref(row.id) + " en SpectroDinner Studios");
				sub.append(mail);
			}
			if (d.discord) sub.append(el("span", "", "💬 " + d.discord));
			for (const key of SUMMARY[row.form] || []) {
				if (d[key]) sub.append(el("span", "", (LABELS[key] || key) + ": " + d[key]));
			}
			card.append(sub);

			if (state.open.has(row.id)) {
				const dl = el("dl", "adm-fields");
				for (const [key, value] of Object.entries(d)) {
					if (key === "form" || value === "" || value === null || value === undefined) continue;
					const shown = key === "idioma" ? LANGUAGE_NAMES[value] || value : Array.isArray(value) ? value.join(", ") : value;
					dl.append(el("dt", "", LABELS[key] || key.replace(/_/g, " ")), el("dd", "", shown));
				}
				card.append(dl);
			}
		}

		const note = renderNote(row);
		if (note) card.append(note);

		const actions = el("div", "adm-actions");
		if (row.form === "review") {
			const onSite = row.status === "live" || row.status === "approved";
			if (row.status === "live") actions.append(button("✓ Todo bien", () => act(row, "approve", "Marcada como revisada"), "btn btn-primary btn-sm"));
			if (!onSite) actions.append(button("Publicar en la web", () => act(row, "approve", "Valoración publicada"), "btn btn-primary btn-sm"));
			if (onSite) actions.append(button("Ocultar", () => act(row, "hide", "Valoración oculta de la web")), button("👁 Ver en la web", () => locateInWeb(row.id)));
		} else {
			const open = state.open.has(row.id);
			actions.append(
				button(open ? "Ocultar detalles" : "Ver todo", () => {
					if (open) {
						state.open.delete(row.id);
						renderList();
						return;
					}
					state.open.add(row.id);
					// Opening a new one counts as reading it.
					if (row.status === "new") act(row, "read", "Marcado como leído");
					else renderList();
				})
			);

			if (row.status === "new" || row.status === "read") {
				actions.append(
					button("✓ Aceptar", () => decide(row, "accept", "Aceptado", "accept"), "btn btn-primary btn-sm"),
					button("✕ Rechazar", () => decide(row, "reject", "Rechazado", "reject"))
				);
				if (row.status === "read") actions.append(button("Marcar como nuevo", () => act(row, "unread", "Marcado como nuevo")));
			} else {
				if (row.status === "accepted" && FORMS[row.form].order) {
					actions.append(button("🏁 Terminado", () => decide(row, "done", "Marcado como terminado", "done"), "btn btn-primary btn-sm"));
				}
				actions.append(button("↺ Reabrir", () => act(row, "read", "Vuelve a estar pendiente")));
			}

			actions.append(button("✉ Responder", () => openReply(row, TEMPLATE_FOR_STATUS[row.status] || "received")));

			if (d.email && EMAIL_RE.test(d.email)) {
				actions.append(
					button("Copiar email", async () => {
						try {
							await navigator.clipboard.writeText(d.email);
							toast("Email copiado");
						} catch {
							toast("No se pudo copiar", true);
						}
					})
				);
			}
		}
		if (state.editingNote !== row.id) {
			actions.append(
				button(row.note ? "📝 Editar nota" : "📝 Nota", () => {
					state.editingNote = row.id;
					renderList();
				})
			);
		}
		actions.append(button("🗑 Eliminar", () => remove(row), "btn btn-sm adm-danger"));
		card.append(actions);

		return card;
	};

	const renderList = () => {
		const list = $("adm-list");
		const rows = visibleRows();
		$("adm-count").textContent = rows.length + " de " + state.rows.length + " " + (state.rows.length === 1 ? "envío" : "envíos");
		if (!rows.length) {
			list.replaceChildren(el("p", "adm-empty", state.rows.length ? "Nada coincide con el filtro o la búsqueda." : "Todavía no hay envíos aquí."));
			return;
		}
		list.replaceChildren(...rows.map(renderCard));
	};

	const loadRows = async () => {
		const { submissions, counts, recent } = await api("submissions?form=" + encodeURIComponent(state.tab));
		state.rows = submissions;
		state.counts = counts;
		state.recent = recent || [];
		if (state.tab === "review") setReviewIndex(submissions);
		renderStats();
		renderTabs();
		renderList();
	};

	// ---------- Review the site side by side ----------
	// The site is loaded in a same-origin frame and each review sent through
	// the form gets moderation buttons. All of this code lives here, behind the
	// login; the public site only carries the reviews' ids.

	const frame = $("adm-web-frame");
	const web = { doc: null, locate: 0 };
	const reviewIndex = new Map();

	const MOD_CSS = [
		".sd-mod{display:flex;flex-wrap:wrap;align-items:center;gap:6px;padding-top:12px;border-top:1px dashed rgba(127,127,127,.4);font:600 12px/1.2 system-ui,-apple-system,'Segoe UI',sans-serif}",
		".sd-mod .sd-tag{margin-right:auto;padding:4px 7px;font-size:11px;letter-spacing:.04em;text-transform:uppercase;color:#e6ebf5;background:#2a3142;border-radius:3px}",
		".sd-mod .sd-tag.is-new{color:#1c1305;background:#f5b82e}",
		".sd-mod button{padding:7px 10px;font:inherit;color:#fff;background:#1d2230;border:1px solid rgba(255,255,255,.25);border-radius:4px;cursor:pointer}",
		".sd-mod button:hover{filter:brightness(1.25)}",
		".sd-mod .sd-ok{background:#1f7a4d;border-color:#2fbf71}",
		".sd-mod .sd-del{background:#a3202b;border-color:#e5484d}",
		"[data-review-id].sd-flash{outline:3px solid #f5b82e;outline-offset:4px}",
	].join("\n");

	const isReview = () => document.documentElement.classList.contains("adm-review");

	const webCard = (id) => web.doc?.querySelector('[data-review-id="' + Number(id) + '"]') || null;

	const flash = (node, cls) => {
		node.scrollIntoView({ behavior: "smooth", block: "center" });
		node.classList.add(cls);
		setTimeout(() => node.classList.remove(cls), 1800);
	};

	const setReviewIndex = (rows) => {
		reviewIndex.clear();
		for (const row of rows) reviewIndex.set(row.id, row);
		decorateWeb();
	};

	const loadReviewIndex = async () => setReviewIndex((await api("submissions?form=review")).submissions);

	// Ask the site to re-fetch its reviews (they're never cached).
	const refreshWeb = () => {
		try {
			web.doc?.dispatchEvent(new frame.contentWindow.CustomEvent("sd:reviews-refresh"));
		} catch {}
	};

	// Ids the site shows that the panel didn't know about (a review sent after
	// the last load): fetched once, so they get their buttons too.
	const askedFor = new Set();

	const decorateNow = () => {
		const doc = web.doc;
		if (!doc) return;

		let unknown = false;

		for (const card of doc.querySelectorAll("[data-review-id]")) {
			const id = Number(card.dataset.reviewId);
			const row = reviewIndex.get(id);
			if (!row && !askedFor.has(id)) {
				askedFor.add(id);
				unknown = true;
			}
			const key = row ? row.status : "?";
			let bar = card.querySelector(".sd-mod");
			if (bar && bar.dataset.status === key) continue;
			bar?.remove();

			bar = doc.createElement("div");
			bar.className = "sd-mod";
			bar.dataset.status = key;

			const tag = doc.createElement("span");
			tag.className = "sd-tag" + (key === "live" ? " is-new" : "");
			tag.textContent = ref(id) + (key === "live" ? " · sin revisar" : key === "approved" ? " · revisada" : "");
			bar.append(tag);

			const add = (label, cls, onClick) => {
				const b = doc.createElement("button");
				b.type = "button";
				b.className = cls;
				b.textContent = label;
				b.addEventListener("click", (e) => {
					e.preventDefault();
					e.stopPropagation();
					onClick();
				});
				bar.append(b);
			};

			if (row) {
				if (row.status === "live") add("✓ Todo bien", "sd-ok", () => act(row, "approve", "Marcada como revisada"));
				add("Ocultar", "", () => act(row, "hide", "Valoración oculta de la web"));
				add("🗑 Eliminar", "sd-del", () => remove(row));
				add("Ver en el panel", "", () => locateInPanel(id));
			}
			card.append(bar);
		}

		if (web.locate) {
			const card = webCard(web.locate);
			if (card) {
				web.locate = 0;
				// Past the first few reviews the site folds the rest under "Ver todas".
				if (!card.offsetParent) doc.querySelector("[data-reviews-more]")?.click();
				flash(card, "sd-flash");
			}
		}

		if (unknown) (state.tab === "review" ? loadRows() : loadReviewIndex()).catch(() => {});
	};

	let decorateQueued = false;
	const decorateWeb = () => {
		if (decorateQueued) return;
		decorateQueued = true;
		requestAnimationFrame(() => {
			decorateQueued = false;
			decorateNow();
		});
	};

	const goWeb = (path) => {
		const url = new URL(String(path || "/").trim() || "/", location.origin);
		if (url.origin !== location.origin || /^\/(admin|acceso)(\/|$)/.test(url.pathname)) {
			toast("Ahí solo se pueden abrir páginas de la web.", true);
			return;
		}
		frame.dataset.started = "1";
		frame.src = url.pathname + url.search + url.hash;
	};

	const webPath = () => {
		try {
			return frame.contentWindow.location.pathname;
		} catch {
			return "";
		}
	};

	const setReview = (on, path) => {
		document.documentElement.classList.toggle("adm-review", on);
		const toggle = $("adm-web-toggle");
		toggle.textContent = on ? "✕ Cerrar la web" : "🌐 Revisar la web";
		toggle.setAttribute("aria-pressed", String(on));
		try {
			sessionStorage.setItem("adm-review", on ? "1" : "");
		} catch {}
		if (!on) return;

		if (path || !frame.dataset.started) {
			let saved = "";
			try {
				saved = sessionStorage.getItem("adm-web-path") || "";
			} catch {}
			goWeb(path || saved || "/#valoraciones");
		}
		if (state.tab !== "review") selectTab("review");
	};

	const locateInWeb = (id) => {
		web.locate = id;
		if (!isReview()) return setReview(true, "/#valoraciones");
		if (webCard(id)) return decorateNow();
		if (webPath() !== "/") goWeb("/#valoraciones");
	};

	const locateInPanel = async (id) => {
		if (state.tab !== "review") await selectTab("review");
		if (state.filter !== "all" || state.query) {
			state.filter = "all";
			state.query = "";
			$("adm-search").value = "";
			renderFilter();
			renderList();
		}
		const card = $("adm-list").querySelector('[data-id="' + Number(id) + '"]');
		if (card) flash(card, "is-flash");
	};

	frame.addEventListener("load", () => {
		web.doc = null;
		if (!frame.dataset.started) return;

		let win, doc;
		try {
			win = frame.contentWindow;
			doc = frame.contentDocument;
		} catch {}
		if (!win || !doc) return;

		// Never nest the panel or its login inside the view.
		if (/^\/(admin|acceso)(\/|$)/.test(win.location.pathname)) {
			win.location.replace("/");
			return;
		}

		web.doc = doc;

		const showPath = () => {
			const path = win.location.pathname + win.location.search + win.location.hash;
			$("adm-web-path").value = path;
			$("adm-web-open").href = path;
			try {
				sessionStorage.setItem("adm-web-path", path);
			} catch {}
		};
		showPath();
		win.addEventListener("hashchange", showPath);

		// Other sites refuse to load inside a frame: open them in a new tab.
		doc.addEventListener("click", (e) => {
			const link = e.target instanceof win.Element ? e.target.closest("a[href]") : null;
			if (!link) return;
			const url = new URL(link.href, win.location.href);
			if (url.origin !== location.origin) {
				e.preventDefault();
				window.open(url.href, "_blank", "noopener");
			}
		});

		// Browsing the site counts as activity for the idle logout.
		for (const type of ACTIVITY) win.addEventListener(type, markActive, { passive: true });

		const style = doc.createElement("style");
		style.textContent = MOD_CSS;
		doc.head.append(style);

		new win.MutationObserver(decorateWeb).observe(doc.body, { childList: true, subtree: true });
		decorateWeb();
	});

	$("adm-web-toggle").addEventListener("click", () => setReview(!isReview()));
	$("adm-web-close").addEventListener("click", () => setReview(false));
	$("adm-web-back").addEventListener("click", () => {
		try {
			frame.contentWindow.history.back();
		} catch {}
	});
	$("adm-web-reload").addEventListener("click", () => {
		try {
			frame.contentWindow.location.reload();
		} catch {
			goWeb("/");
		}
	});
	$("adm-web-reviews").addEventListener("click", () => {
		const section = webPath() === "/" ? web.doc?.getElementById("valoraciones") : null;
		if (section) section.scrollIntoView({ behavior: "smooth" });
		else goWeb("/#valoraciones");
	});
	$("adm-web-go").addEventListener("submit", (e) => {
		e.preventDefault();
		const value = $("adm-web-path").value.trim();
		goWeb(value.startsWith("/") ? value : "/" + value);
	});

	// ---------- Security ----------

	const loadSecurity = async () => {
		const { sessions, events, actions } = await api("security");

		$("adm-actions").replaceChildren(
			...(actions.length
				? actions.map((a) => {
						const li = el("li", a.action === "delete" ? "is-delete" : "");
						li.append(el("span", "", ACTION_ICONS[a.action] || "•"), el("span", "", a.summary || a.action));
						const when = el("small", "", relative(a.at));
						when.title = absolute(a.at);
						li.append(when);
						return li;
					})
				: [el("li", "", "Todavía no se ha cambiado nada desde el panel.")])
		);

		const sessionList = $("adm-sessions");
		sessionList.replaceChildren(
			...sessions.map((s) => {
				const li = el("li");
				li.append(el("span", "", (s.current ? "🟢 " : "⚪ ") + (s.user_agent || "Dispositivo desconocido")));
				if (s.current) li.append(el("span", "adm-chip green", "Esta sesión"));
				li.append(el("small", "", "activa " + relative(s.last_seen) + " · caduca " + timeOnly(s.expires_at)));
				return li;
			})
		);

		const eventList = $("adm-events");
		eventList.replaceChildren(
			...(events.length
				? events.map((e) => {
						const [icon, label, cls] = EVENTS[e.kind] || ["•", e.kind, ""];
						const li = el("li", cls);
						li.append(el("span", "", icon + " " + label), el("span", "", e.user_agent || ""));
						const when = el("small", "", relative(e.at));
						when.title = absolute(e.at);
						li.append(when);
						return li;
					})
				: [el("li", "", "Sin actividad registrada.")])
		);
	};

	// ---------- Settings ----------

	const loadSettings = async () => {
		const [{ settings }, config] = await Promise.all([
			api("settings"),
			// Maintenance as the site actually sees it (the panel's switch, or
			// config.json if it was never switched here).
			fetch("/config.json", { cache: "no-store" }).then((res) => res.json()).catch(() => ({})),
		]);
		renderSwitches({ ...settings, maintenance: config.maintenance === true });
	};

	const renderSwitches = (settings) => {
		$("adm-switches").replaceChildren(
			...SWITCHES.map((s) => {
				const on = Boolean(settings[s.key]);
				const row = el("div", "adm-switch" + (on ? " is-on" : "") + (s.warn ? " is-warn" : ""));
				const text = el("div", "adm-switch-text");
				text.append(el("strong", "", s.title), el("small", "", on ? s.on : s.off));

				const toggle = el("button", "adm-toggle");
				toggle.type = "button";
				toggle.setAttribute("role", "switch");
				toggle.setAttribute("aria-checked", String(on));
				toggle.setAttribute("aria-label", s.title);
				toggle.addEventListener("click", async () => {
					const value = !on;
					if (value && s.confirm && !(await confirmDialog(s.confirm, "Activar"))) return;
					toggle.disabled = true;
					try {
						await api("settings", { key: s.key, value });
						toast(s.title + ": " + (value ? "activado" : "desactivado"));
						await loadSettings();
					} catch (err) {
						toggle.disabled = false;
						if (err.message !== "auth") toast("No se pudo cambiar el ajuste.", true);
					}
				});

				row.append(el("span", "adm-switch-icon", s.icon), text, toggle);
				return row;
			})
		);
	};

	// ---------- Reply ----------

	const reply = { row: null, kind: "received", lang: "es" };

	// What the request was about, in a few words for the templates.
	const aboutOf = (row, lang) => {
		const d = row.data;
		const en = lang === "en";
		if (row.form === "voluntariado") return d.areas || (en ? "the studio" : "el estudio");
		if (row.form === "discord") return d.tipo || (en ? "your Discord server" : "tu servidor de Discord");
		if (d.servidor_nombre) return (en ? "your server " : "tu servidor ") + d.servidor_nombre;
		return en ? "your Minecraft server" : "tu servidor de Minecraft";
	};

	const fillReply = () => {
		const { row, kind, lang } = reply;
		const template = TEMPLATES[kind][row.form === "voluntariado" ? "volunteer" : "order"][lang];
		const name = String(row.data.nombre || row.data.nickname || "").trim() || (lang === "en" ? "there" : "");
		const [subject, body] = template({ name, ref: ref(row.id), about: aboutOf(row, lang) });

		$("adm-reply-subject").value = subject;
		$("adm-reply-body").value = body.replace(/^Hola :/, "Hola:") + "\n\n" + SIGNATURE[lang];

		for (const b of $("adm-reply-kinds").children) b.setAttribute("aria-pressed", String(b.dataset.kind === kind));
		for (const b of $("adm-reply-lang").children) b.setAttribute("aria-pressed", String(b.dataset.pick === lang));
		updateMailLink();
	};

	const updateMailLink = () => {
		const mail = $("adm-reply-mail");
		const email = String(reply.row?.data.email || "");
		if (!EMAIL_RE.test(email)) {
			mail.setAttribute("aria-disabled", "true");
			mail.href = "#";
			return;
		}
		mail.removeAttribute("aria-disabled");
		const body = $("adm-reply-body").value.replace(/\r?\n/g, "\r\n");
		mail.href = "mailto:" + email + "?subject=" + encodeURIComponent($("adm-reply-subject").value) + "&body=" + encodeURIComponent(body);
	};

	const openReply = (row, kind) => {
		const isOrder = row.form !== "voluntariado";
		reply.row = row;
		reply.kind = TEMPLATES[kind] && (isOrder || !TEMPLATES[kind].orderOnly) ? kind : "received";
		reply.lang = row.data.idioma === "en" ? "en" : "es";

		const name = row.data.nombre || row.data.nickname || "—";
		$("adm-reply-title").textContent = "Responder a " + name + " · " + ref(row.id);

		const to = [];
		if (EMAIL_RE.test(String(row.data.email || ""))) to.push("✉ " + row.data.email);
		if (row.data.discord) to.push("💬 " + row.data.discord);
		$("adm-reply-to").textContent = to.length
			? "Para: " + to.join("  ·  ") + (to.length === 1 && row.data.discord ? " — copia el texto y envíaselo por Discord." : "")
			: "No dejó email ni Discord.";

		$("adm-reply-kinds").replaceChildren(
			...Object.entries(TEMPLATES)
				.filter(([, t]) => isOrder || !t.orderOnly)
				.map(([key, t]) => {
					const b = el("button", "", t.label);
					b.type = "button";
					b.dataset.kind = key;
					b.addEventListener("click", () => {
						reply.kind = key;
						fillReply();
					});
					return b;
				})
		);

		$("adm-reply-lang").replaceChildren(
			...["es", "en"].map((lang) => {
				const b = el("button", "", lang.toUpperCase());
				b.type = "button";
				b.dataset.pick = lang;
				b.addEventListener("click", () => {
					reply.lang = lang;
					fillReply();
				});
				return b;
			})
		);

		fillReply();
		$("adm-reply").showModal();
	};

	$("adm-reply-subject").addEventListener("input", updateMailLink);
	$("adm-reply-body").addEventListener("input", updateMailLink);
	$("adm-reply-close").addEventListener("click", () => $("adm-reply").close());
	$("adm-reply-copy").addEventListener("click", async () => {
		try {
			await navigator.clipboard.writeText($("adm-reply-subject").value + "\n\n" + $("adm-reply-body").value);
			toast("Texto copiado");
		} catch {
			toast("No se pudo copiar", true);
		}
	});

	// ---------- Navigation ----------

	const selectTab = async (tab) => {
		state.tab = tab;
		state.filter = "all";
		state.open.clear();
		state.editingNote = 0;
		const isSecurity = tab === "security";
		const isSettings = tab === "settings";
		$("adm-inbox").hidden = isSecurity || isSettings;
		$("adm-security").hidden = !isSecurity;
		$("adm-settings").hidden = !isSettings;
		renderTabs();
		try {
			if (isSecurity) {
				await loadSecurity();
			} else if (isSettings) {
				await loadSettings();
			} else {
				renderFilter();
				$("adm-list").replaceChildren(el("div", "adm-skeleton"), el("div", "adm-skeleton"));
				await loadRows();
			}
		} catch (err) {
			if (err.message !== "auth") toast("No se pudieron cargar los datos.", true);
		}
	};

	const refresh = () => {
		refreshWeb();
		return selectTab(state.tab);
	};

	// ---------- Toolbar ----------

	$("adm-search").addEventListener("input", (e) => {
		state.query = e.target.value;
		renderList();
	});

	$("adm-readall").addEventListener("click", async () => {
		try {
			await api("submissions", { action: "read-all", form: state.tab });
		} catch (err) {
			if (err.message !== "auth") toast("No se pudo completar la acción.", true);
			return;
		}
		toast(state.tab === "review" ? "Todas marcadas como revisadas" : "Todo marcado como leído");
		await afterChange(state.tab);
	});

	$("adm-export").addEventListener("click", () => {
		const rows = visibleRows();
		if (!rows.length) return toast("No hay nada que exportar.", true);
		const keys = [...new Set(rows.flatMap((r) => Object.keys(r.data)))].filter((k) => k !== "form");
		const cell = (value) => {
			let text = Array.isArray(value) ? value.join(", ") : String(value ?? "");
			// Neutralise spreadsheet formulas (CSV injection).
			if (/^[=+\-@\t\r]/.test(text)) text = "'" + text;
			return '"' + text.replace(/"/g, '""') + '"';
		};
		const lines = [["id", "fecha", "estado", ...keys.map((k) => LABELS[k] || k), "nota interna"].map(cell).join(",")];
		for (const r of rows) lines.push([ref(r.id), absolute(r.created_at), (STATUS[r.status] || [r.status])[0], ...keys.map((k) => r.data[k]), r.note || ""].map(cell).join(","));
		const blob = new Blob(["﻿" + lines.join("\r\n")], { type: "text/csv;charset=utf-8" });
		const link = el("a");
		link.href = URL.createObjectURL(blob);
		link.download = "spectrodinner-" + state.tab + "-" + new Date().toISOString().slice(0, 10) + ".csv";
		link.click();
		setTimeout(() => URL.revokeObjectURL(link.href), 1000);
		toast(rows.length + " filas exportadas");
	});

	$("adm-refresh").addEventListener("click", refresh);

	const logout = async (reason) => {
		try {
			await fetch("/api/admin/logout", { method: "POST", credentials: "same-origin" });
		} catch {}
		goToLogin(reason || "out");
	};

	$("adm-logout").addEventListener("click", () => logout("out"));

	$("adm-revoke-others").addEventListener("click", async () => {
		await api("security", { action: "revoke-others" });
		toast("Las demás sesiones se han cerrado");
		loadSecurity();
	});

	$("adm-revoke-all").addEventListener("click", async () => {
		if (!(await confirmDialog("Se cerrarán todas las sesiones, incluida esta. Tendrás que volver a entrar.", "Cerrar todas"))) return;
		await api("security", { action: "revoke-all" });
		goToLogin("out");
	});

	// ---------- Shortcuts, idle logout, refresh on focus ----------

	document.addEventListener("keydown", (e) => {
		const typing = /^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement?.tagName || "");
		if (e.key === "/" && !typing) {
			e.preventDefault();
			$("adm-search").focus();
		} else if ((e.key === "r" || e.key === "R") && !typing && !e.ctrlKey && !e.metaKey) {
			refresh();
		}
	});

	for (const type of ACTIVITY) window.addEventListener(type, markActive, { passive: true, capture: true });
	setInterval(() => {
		if (Date.now() - lastActivity > IDLE_LIMIT_MS) logout("timeout");
	}, 30 * 1000);

	let hiddenAt = 0;
	document.addEventListener("visibilitychange", () => {
		if (document.hidden) hiddenAt = Date.now();
		else if (Date.now() - hiddenAt > 60 * 1000) refresh();
	});

	// Restored from the back/forward cache (e.g. "Back" after logging out):
	// never show the old copy, go through the server-side gate again.
	window.addEventListener("pageshow", (e) => {
		if (e.persisted) {
			document.body.hidden = true;
			location.reload();
		}
	});

	// ---------- Start ----------

	// You always see the real site from this browser, even in maintenance mode
	// (the same flag the site's ?bypass= link sets).
	try {
		localStorage.setItem("sd-maintenance-bypass", "true");
	} catch {}

	loadSession().catch(() => {});
	selectTab("review");

	// Reopen the side-by-side view if it was open before a reload.
	try {
		if (sessionStorage.getItem("adm-review")) setReview(true);
	} catch {}
})();
</script>

</Layout>
