---
import Layout from "../../layouts/Layout.astro";

// The panel only ships in Cloudflare builds, where functions/admin/[[path]].ts
// serves it exclusively to a valid session. GitHub Pages has no server to
// guard it, so there the page is simply not generated (404).
// Styles and script are inlined (is:inline) so no public /_astro/ file
// contains any of the panel's code.
export function getStaticPaths() {
	const env = (globalThis as { process?: { env: Record<string, string | undefined> } }).process?.env ?? {};
	return env.CF_PAGES || env.ADMIN_BUILD ? [{ params: { slug: undefined } }] : [];
}
---

<Layout title="Panel | SpectroDinner™" description="Panel privado." noindex>

	<div class="adm-shell">

	<section class="adm-web" id="adm-web" aria-label="Vista de la web">
		<div class="adm-web-bar">
			<button type="button" id="adm-web-back" title="Atrás">←</button>
			<button type="button" id="adm-web-reload" title="Recargar">⟳</button>
			<form class="adm-web-url" id="adm-web-go">
				<input id="adm-web-path" value="/" spellcheck="false" autocomplete="off" aria-label="Página de la web" />
			</form>
			<button type="button" id="adm-web-reviews" title="Ir a las valoraciones">★ <span>Valoraciones</span></button>
			<a id="adm-web-open" href="/" target="_blank" rel="noopener" title="Abrir en una pestaña nueva">↗</a>
			<button type="button" id="adm-web-close" title="Cerrar la vista de la web">✕</button>
		</div>
		<iframe class="adm-web-frame" id="adm-web-frame" title="Web de SpectroDinner" src="about:blank"></iframe>
	</section>

	<div class="adm" id="adm">

		<header class="adm-top">
			<a href="/" class="adm-brand">
				<img src="/logo.png" alt="" width="34" height="34" />
				<span>SPECTRO<b>DINNER</b> <small>// PANEL</small></span>
			</a>
			<div class="adm-top-actions">
				<span class="adm-session" id="adm-session" title="">🔒 Sesión segura</span>
				<button type="button" class="btn btn-primary btn-sm" id="adm-web-toggle" aria-pressed="false" title="La web a un lado y el panel en el lateral">🌐 Revisar la web</button>
				<button type="button" class="btn btn-ghost btn-sm" id="adm-refresh" title="Actualizar (R)">⟳ Actualizar</button>
				<button type="button" class="btn btn-ghost btn-sm" id="adm-logout">Cerrar sesión</button>
			</div>
		</header>

		<p class="adm-previous" id="adm-previous" hidden></p>

		<section class="adm-stats" id="adm-stats" aria-label="Resumen"></section>

		<nav class="adm-tabs" id="adm-tabs" aria-label="Secciones"></nav>

		<div id="adm-inbox">
			<div class="adm-toolbar">
				<input type="search" id="adm-search" placeholder="Buscar por nombre, email, texto…  ( / )" autocomplete="off" />
				<div class="adm-filter" id="adm-filter" role="group" aria-label="Estado"></div>
				<div class="adm-toolbar-actions">
					<button type="button" class="btn btn-ghost btn-sm" id="adm-readall"></button>
					<button type="button" class="btn btn-ghost btn-sm" id="adm-export">⤓ Exportar CSV</button>
				</div>
			</div>
			<p class="adm-count" id="adm-count"></p>
			<div class="adm-list" id="adm-list" aria-live="polite"></div>
		</div>

		<section id="adm-security" class="adm-security" hidden>
			<div class="adm-panel">
				<div class="adm-panel-head">
					<h2>Sesiones abiertas</h2>
					<div class="adm-panel-actions">
						<button type="button" class="btn btn-ghost btn-sm" id="adm-revoke-others">Cerrar las demás</button>
						<button type="button" class="btn btn-sm adm-danger" id="adm-revoke-all">Cerrar todas</button>
					</div>
				</div>
				<ul class="adm-sessions" id="adm-sessions"></ul>
			</div>
			<div class="adm-panel">
				<div class="adm-panel-head">
					<h2>Registro de accesos</h2>
				</div>
				<ul class="adm-events" id="adm-events"></ul>
			</div>
			<div class="adm-panel adm-wide">
				<div class="adm-panel-head">
					<h2>Historial de cambios</h2>
				</div>
				<ul class="adm-events" id="adm-actions"></ul>
			</div>
			<div class="adm-panel adm-tips">
				<h2>Consejos</h2>
				<ul>
					<li>Las sesiones caducan a las 12 h y se cierran tras 2 h sin actividad (este panel cierra la tuya tras 30 min quieto).</li>
					<li>Tras 5 contraseñas incorrectas desde un mismo sitio, el acceso se bloquea 15 minutos.</li>
					<li>Si ves un acceso que no reconoces: cambia <code>ADMIN_PASSWORD</code> en Cloudflare y pulsa «Cerrar todas».</li>
					<li>El historial guarda cada cambio hecho desde el panel durante 180 días.</li>
				</ul>
			</div>
		</section>

		<section id="adm-settings" hidden>
			<div class="adm-panel">
				<div class="adm-panel-head">
					<h2>Ajustes de la web</h2>
				</div>
				<p class="adm-hint">Se aplican al momento, también en la copia de GitHub Pages.</p>
				<div class="adm-switches" id="adm-switches"></div>
			</div>
		</section>

		<div class="adm-toast" id="adm-toast" role="status" aria-live="polite" hidden></div>

		<dialog class="adm-dialog adm-reply" id="adm-reply" aria-labelledby="adm-reply-title">
			<div class="adm-reply-head">
				<h2 id="adm-reply-title">Responder</h2>
				<div class="adm-filter" id="adm-reply-lang" role="group" aria-label="Idioma"></div>
			</div>
			<div class="adm-filter adm-reply-kinds" id="adm-reply-kinds" role="group" aria-label="Plantilla"></div>
			<p class="adm-reply-to" id="adm-reply-to"></p>
			<label class="adm-reply-field">Asunto <input id="adm-reply-subject" autocomplete="off" /></label>
			<label class="adm-reply-field">Mensaje <textarea id="adm-reply-body" rows="12"></textarea></label>
			<div class="adm-dialog-actions">
				<button type="button" class="btn btn-ghost btn-sm" id="adm-reply-close">Cerrar</button>
				<button type="button" class="btn btn-ghost btn-sm" id="adm-reply-copy">Copiar texto</button>
				<a class="btn btn-primary btn-sm" id="adm-reply-mail" href="#">✉ Abrir en mi correo</a>
			</div>
		</dialog>

		<dialog class="adm-dialog" id="adm-dialog">
			<p id="adm-dialog-text"></p>
			<div class="adm-dialog-actions">
				<button type="button" class="btn btn-ghost btn-sm" value="cancel" id="adm-dialog-cancel">Cancelar</button>
				<button type="button" class="btn btn-sm adm-danger" value="ok" id="adm-dialog-ok">Eliminar</button>
			</div>
		</dialog>

	</div>

	</div>


<style is:inline>
.adm { max-width: 1120px; margin: 0 auto; padding: 24px 24px 80px; container-type: inline-size; }

/* "Revisar la web": the site on one side, the panel in a side column. */
.adm-web { display: none; }
.adm-review, .adm-review body { height: 100%; overflow: hidden; }
.adm-review .adm-shell { display: grid; grid-template-columns: minmax(0, 1fr) min(500px, 44vw); height: 100vh; height: 100dvh; }
.adm-review .adm-web { display: flex; flex-direction: column; min-width: 0; min-height: 0; background: var(--bg); border-right: 1px solid var(--border-2); }
.adm-review .adm { width: 100%; max-width: none; height: 100%; margin: 0; padding: 16px 16px 60px; overflow-y: auto; overscroll-behavior: contain; }
.adm-review .adm-stats, .adm-review .adm-previous { display: none; }
.adm-web-bar { display: flex; align-items: center; gap: 6px; padding: 8px; background: var(--bg-elevated); border-bottom: 1px solid var(--border-2); }
.adm-web-bar button, .adm-web-bar a { flex: none; display: inline-grid; place-items: center; min-width: 34px; height: 34px; padding: 0 10px; font: inherit; font-size: .85rem; color: var(--text-muted); text-decoration: none; background: var(--surface-1); border: 1px solid var(--border-1); border-radius: var(--radius-xs); cursor: pointer; }
.adm-web-bar button:hover, .adm-web-bar a:hover { color: var(--text); border-color: var(--border-3); }
.adm-web-url { flex: 1 1 auto; min-width: 0; }
.adm-web-url input { width: 100%; height: 34px; padding: 0 10px; font-family: ui-monospace, Consolas, monospace; font-size: .85rem; color: var(--text); background: var(--bg-sunken); border: 1px solid var(--border-2); border-radius: var(--radius-xs); }
.adm-web-url input:focus { border-color: var(--primary); outline: none; }
.adm-web-frame { flex: 1; width: 100%; min-height: 0; background: var(--bg); border: 0; }
.adm-card.is-flash { outline: 2px solid var(--gold); outline-offset: 3px; }
.adm-toast { display: flex; align-items: center; gap: 14px; }
.adm-toast[hidden] { display: none; }
.adm-toast-action { padding: 5px 10px; font: inherit; font-weight: 600; color: var(--gold-text); background: var(--gold-bg); border: 1px solid var(--gold-border); cursor: pointer; }
.adm-top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px; margin-bottom: 18px; }
.adm-brand { display: flex; align-items: center; gap: 10px; font-family: var(--font-display); font-weight: 700; letter-spacing: .05em; text-decoration: none; }
.adm-brand b { color: var(--primary-light); }
.adm-brand small { font-family: var(--font-pixel); font-weight: 400; font-size: .7rem; color: var(--text-dim); }
.adm-top-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
.adm-session { padding: 6px 10px; font-family: var(--font-pixel); font-size: .68rem; letter-spacing: .04em; color: var(--emerald); background: color-mix(in srgb, var(--emerald) 10%, transparent); border: 1px solid color-mix(in srgb, var(--emerald) 35%, transparent); }
.adm-previous { margin: 0 0 18px; font-size: .86rem; color: var(--text-dim); }
.adm-danger { --btn-bg: color-mix(in srgb, var(--danger) 14%, transparent); --btn-fg: var(--danger); --btn-ring: color-mix(in srgb, var(--danger) 45%, transparent); }

.adm-stats { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; margin-bottom: 22px; }
.adm-stat { display: flex; flex-direction: column; gap: 6px; padding: 16px; text-align: left; font: inherit; color: var(--text); background: var(--surface-1); border: 1px solid var(--border-1); border-left: 3px solid var(--primary); border-radius: var(--radius-xs); cursor: pointer; transition: border-color var(--transition), background var(--transition); }
.adm-stat:hover { background: var(--surface-2); border-color: var(--border-3); }
.adm-stat.is-alert { border-left-color: var(--gold); }
.adm-stat span { font-family: var(--font-pixel); font-size: .66rem; letter-spacing: .05em; text-transform: uppercase; color: var(--text-dim); }
.adm-stat strong { font-family: var(--font-display); font-size: 1.8rem; line-height: 1; }
.adm-stat small { font-size: .8rem; color: var(--text-muted); }
.adm-stat small b { color: var(--gold-text); }

.adm-tabs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 16px; }
.adm-tab { display: inline-flex; align-items: center; gap: 8px; padding: 10px 14px; font-family: var(--font-display); font-size: .95rem; font-weight: 600; color: var(--text-muted); background: var(--surface-1); border: 1px solid var(--border-1); border-radius: var(--radius-xs); cursor: pointer; }
.adm-tab:hover { color: var(--text); }
.adm-tab[aria-selected="true"] { color: var(--text); background: var(--primary-bg); border-color: var(--primary); box-shadow: inset 0 -2px 0 var(--primary); }
.adm-badge { min-width: 22px; padding: 1px 6px; font-family: var(--font-pixel); font-size: .68rem; text-align: center; color: #1C1305; background: var(--gold); }

.adm-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-bottom: 10px; }
.adm-toolbar input[type="search"] { flex: 1 1 260px; padding: 11px 14px; font: inherit; color: var(--text); background: var(--bg-sunken); border: 1px solid var(--border-2); border-radius: var(--radius-xs); }
.adm-toolbar input[type="search"]:focus { border-color: var(--primary); outline: none; box-shadow: 0 0 0 3px var(--primary-bg); }
.adm-filter { display: flex; border: 1px solid var(--border-2); border-radius: var(--radius-xs); overflow: hidden; }
.adm-filter button { padding: 9px 12px; font: inherit; font-size: .85rem; color: var(--text-muted); background: var(--surface-1); border: 0; border-right: 1px solid var(--border-1); cursor: pointer; }
.adm-filter button:last-child { border-right: 0; }
.adm-filter button[aria-pressed="true"] { color: var(--text); background: var(--primary-bg); box-shadow: inset 0 -2px 0 var(--primary); }
.adm-toolbar-actions { display: flex; gap: 8px; }
.adm-count { margin: 0 0 12px; font-family: var(--font-pixel); font-size: .68rem; letter-spacing: .05em; text-transform: uppercase; color: var(--text-dim); }

.adm-list { display: flex; flex-direction: column; gap: 10px; }
.adm-card { position: relative; padding: 16px 18px; background: linear-gradient(180deg, var(--surface-2), var(--surface-1)); border: 1px solid var(--border-1); border-left: 3px solid var(--border-2); border-radius: var(--radius-xs); }
.adm-card.is-new { border-left-color: var(--gold); }
.adm-card.is-muted { opacity: .62; }
.adm-card-head { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
.adm-card-head strong { font-family: var(--font-display); font-size: 1.1rem; overflow-wrap: anywhere; }
.adm-chip { padding: 2px 8px; font-family: var(--font-pixel); font-size: .62rem; letter-spacing: .05em; text-transform: uppercase; color: var(--text-muted); background: var(--surface-2); border: 1px solid var(--border-1); }
.adm-chip.gold { color: var(--gold-text); background: var(--gold-bg); border-color: var(--gold-border); }
.adm-chip.green { color: var(--emerald); background: color-mix(in srgb, var(--emerald) 10%, transparent); border-color: color-mix(in srgb, var(--emerald) 35%, transparent); }
.adm-meta { margin-left: auto; display: flex; gap: 10px; font-size: .82rem; color: var(--text-dim); }
.adm-sub { display: flex; flex-wrap: wrap; gap: 6px 14px; margin-top: 8px; font-size: .9rem; color: var(--text-muted); }
.adm-sub a { color: var(--primary-light); text-decoration: none; }
.adm-sub a:hover { text-decoration: underline; }
.adm-stars { color: var(--gold); letter-spacing: 2px; }
.adm-quote { margin: 10px 0 0; line-height: 1.65; color: var(--text); white-space: pre-wrap; overflow-wrap: anywhere; }
.adm-fields { display: grid; grid-template-columns: minmax(140px, 210px) 1fr; gap: 7px 16px; margin: 14px 0 0; padding-top: 12px; border-top: 1px dashed var(--border-2); }
.adm-fields dt { font-family: var(--font-pixel); font-size: .64rem; letter-spacing: .04em; text-transform: uppercase; color: var(--primary-light); padding-top: 3px; }
.adm-fields dd { margin: 0; font-size: .92rem; color: var(--text); white-space: pre-wrap; overflow-wrap: anywhere; }
.adm-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
.adm-empty { padding: 40px 20px; text-align: center; color: var(--text-dim); background: var(--surface-1); border: 1px dashed var(--border-2); border-radius: var(--radius-xs); }
.adm-skeleton { height: 92px; background: linear-gradient(90deg, var(--surface-1), var(--surface-3), var(--surface-1)); background-size: 200% 100%; border-radius: var(--radius-xs); animation: admShimmer 1.2s linear infinite; }
@keyframes admShimmer { to { background-position: -200% 0; } }

.adm-security { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.adm-panel { padding: 18px 20px; background: var(--bg-elevated); border: 1px solid var(--border-2); border-radius: var(--radius-xs); }
.adm-panel-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 12px; }
.adm-panel h2 { font-size: 1.15rem; font-weight: 600; }
.adm-panel-actions { display: flex; gap: 8px; }
.adm-sessions, .adm-events { display: flex; flex-direction: column; gap: 6px; margin: 0; padding: 0; list-style: none; }
.adm-sessions li, .adm-events li { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; padding: 9px 12px; font-size: .88rem; background: var(--surface-1); border: 1px solid var(--border-1); border-radius: var(--radius-xs); }
.adm-sessions small, .adm-events small { margin-left: auto; color: var(--text-dim); }
.adm-events li.is-fail { border-left: 3px solid var(--danger); }
.adm-events li.is-ok { border-left: 3px solid var(--emerald); }
.adm-tips, .adm-wide { grid-column: 1 / -1; }
.adm-events li.is-delete { border-left: 3px solid var(--danger); }
.adm-events li span:last-of-type { overflow-wrap: anywhere; }

.adm-chip.red { color: var(--danger); background: color-mix(in srgb, var(--danger) 10%, transparent); border-color: color-mix(in srgb, var(--danger) 35%, transparent); }
.adm-chip.blue { color: var(--primary-light); background: var(--primary-bg); border-color: color-mix(in srgb, var(--primary) 45%, transparent); }
.adm-card.is-accepted { border-left-color: var(--emerald); }
.adm-note { margin-top: 12px; padding: 10px 12px; background: var(--gold-bg); border: 1px solid var(--gold-border); border-radius: var(--radius-xs); }
.adm-note span { font-family: var(--font-pixel); font-size: .62rem; letter-spacing: .05em; text-transform: uppercase; color: var(--gold-text); }
.adm-note p { margin: 4px 0 0; font-size: .9rem; line-height: 1.55; white-space: pre-wrap; overflow-wrap: anywhere; }
.adm-note textarea, .adm-reply-field input, .adm-reply-field textarea { width: 100%; margin-top: 6px; padding: 10px 12px; font: inherit; font-size: .92rem; line-height: 1.55; color: var(--text); background: var(--bg-sunken); border: 1px solid var(--border-2); border-radius: var(--radius-xs); resize: vertical; }
.adm-note textarea:focus, .adm-reply-field input:focus, .adm-reply-field textarea:focus { border-color: var(--primary); outline: none; }
.adm-note .adm-actions { margin-top: 8px; }

.adm-hint { margin: -4px 0 14px; font-size: .88rem; color: var(--text-dim); }
.adm-switches { display: flex; flex-direction: column; gap: 10px; }
.adm-switch { display: flex; align-items: center; gap: 14px; padding: 14px 16px; background: var(--surface-1); border: 1px solid var(--border-1); border-left: 3px solid var(--border-2); border-radius: var(--radius-xs); }
.adm-switch.is-on { border-left-color: var(--emerald); }
.adm-switch.is-warn.is-on { border-left-color: var(--gold); }
.adm-switch-icon { font-size: 1.4rem; }
.adm-switch-text { flex: 1; min-width: 0; }
.adm-switch-text strong { display: block; font-family: var(--font-display); font-size: 1rem; }
.adm-switch-text small { display: block; margin-top: 3px; font-size: .86rem; line-height: 1.5; color: var(--text-muted); }
.adm-toggle { position: relative; flex: none; width: 52px; height: 28px; padding: 0; background: var(--surface-3); border: 1px solid var(--border-2); border-radius: 999px; cursor: pointer; transition: background var(--transition); }
.adm-toggle::after { content: ""; position: absolute; top: 3px; left: 3px; width: 20px; height: 20px; background: var(--text-muted); border-radius: 50%; transition: translate var(--transition), background var(--transition); }
.adm-toggle[aria-checked="true"] { background: color-mix(in srgb, var(--emerald) 35%, transparent); border-color: var(--emerald); }
.adm-toggle[aria-checked="true"]::after { translate: 24px 0; background: var(--emerald); }
.adm-toggle:disabled { opacity: .5; cursor: wait; }

.adm-reply { max-width: 640px; }
.adm-reply-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 12px; }
.adm-reply-head h2 { font-size: 1.15rem; font-weight: 600; }
.adm-reply-kinds { flex-wrap: wrap; margin-bottom: 10px; }
.adm-reply .adm-reply-to { margin: 0 0 10px; font-size: .88rem; color: var(--text-muted); }
.adm-reply-field { display: block; margin-bottom: 12px; font-size: .85rem; font-weight: 600; color: var(--text-muted); }
.adm-reply .adm-dialog-actions { flex-wrap: wrap; }
#adm-reply-mail[aria-disabled="true"] { opacity: .45; pointer-events: none; }
.adm-tips ul { margin: 10px 0 0; padding-left: 18px; color: var(--text-muted); line-height: 1.7; font-size: .9rem; }
.adm-tips code { padding: 1px 5px; background: var(--bg-sunken); border: 1px solid var(--border-1); }

.adm-toast { position: fixed; left: 50%; bottom: 24px; translate: -50% 0; z-index: 80; padding: 11px 16px; font-size: .92rem; color: var(--text); background: var(--bg-elevated); border: 1px solid var(--border-2); border-left: 3px solid var(--emerald); box-shadow: 0 20px 50px var(--shadow-color); }
.adm-toast.is-error { border-left-color: var(--danger); }
.adm-dialog { width: calc(100% - 32px); max-width: 420px; margin: auto; padding: 22px; color: var(--text); background: var(--bg-elevated); border: 1px solid var(--border-2); border-radius: var(--radius-sm); }
.adm-dialog::backdrop { background: rgba(0, 0, 0, .6); backdrop-filter: blur(3px); }
.adm-dialog p { margin: 0 0 18px; line-height: 1.6; }
.adm-dialog-actions { display: flex; justify-content: flex-end; gap: 8px; }

/* Sized by the panel's own width, so the side column gets the compact layout too. */
@container (max-width: 900px) {
	.adm-stats { grid-template-columns: repeat(2, 1fr); }
	.adm-security { grid-template-columns: 1fr; }
}
@container (max-width: 560px) {
	.adm-fields { grid-template-columns: 1fr; gap: 2px; }
	.adm-fields dd { margin-bottom: 8px; }
	.adm-meta { margin-left: 0; width: 100%; }
}
@media (max-width: 560px) {
	.adm { padding: 16px 14px 60px; }
	.adm-web-bar { gap: 4px; padding: 6px; }
	.adm-web-bar button, .adm-web-bar a { min-width: 30px; padding: 0 7px; }
	#adm-web-reviews span { display: none; }
}
@media (max-width: 960px) {
	.adm-review .adm-shell { grid-template-columns: 1fr; grid-template-rows: 55% 45%; }
	.adm-review .adm-web { border-right: 0; border-bottom: 2px solid var(--primary); }
}
</style>

<script is:inline>
(() => {
	"use strict";

	// ---------- Config ----------

	// `fresh`: statuses still waiting for you (the "fresh" filter shows those).
	// `order`: requests for work, which can be marked as done once delivered.
	const INBOX_FILTERS = [["all", "Todos"], ["fresh", "Nuevos"], ["read", "Leídos"], ["accepted", "Aceptados"], ["rejected", "Rechazados"]];
	const INBOX = { fresh: ["new"], freshLabel: "sin leer", readAll: "✓ Marcar todo leído" };
	const FORMS = {
