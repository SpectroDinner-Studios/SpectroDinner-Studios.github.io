	const ACTION_ICONS = { delete: "🗑", restore: "↩️", approve: "✅", hide: "🙈", accept: "✔️", reject: "✖️", done: "🏁", read: "👁", unread: "🔵", note: "📝", setting: "⚙️", "read-all": "☑️" };

	// ---------- Reply templates ----------
	// v = { name, ref, about } · one per decision, for volunteers and orders.

	const SITE_URL = "https://spectrodinner-studios.pages.dev";
	const SIGNATURE = { es: "Un saludo,\nSpectroDinner Studios", en: "Best regards,\nSpectroDinner Studios" };

	const TEMPLATES = {
