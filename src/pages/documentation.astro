---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout
	title="Documentation | SpectroDinner™"
	description="Documentation and resources for SpectroDinner™'s projects and services."
>

	<Navbar />

	<main class="container">
		<section class="hero">
			<h1>
				<span data-lang="es">Documentación</span>
				<span data-lang="en">Documentation</span>
			</h1>

			<p>
				<span data-lang="es">
					Documentación técnica, guías y recursos para los
					proyectos de SpectroDinner Studios.
				</span>
				<span data-lang="en">
					Technical documentation, guides and resources
					for SpectroDinner Studios' projects.
				</span>
			</p>
		</section>

		<section class="notice reveal">
			<span class="badge">
				<span data-lang="es">PRÓXIMAMENTE</span>
				<span data-lang="en">COMING SOON</span>
			</span>

			<h2>
				<span data-lang="es">Todavía no hay documentación pública</span>
				<span data-lang="en">No public documentation yet</span>
			</h2>

			<p>
				<span data-lang="es">
					Estamos preparando documentación técnica para
					nuestros proyectos, empezando por TimeEconomyPlugin.
					De momento no hay guías, referencias de API ni
					tutoriales publicados — no queremos mostrar
					documentación que no existe todavía.
				</span>
				<span data-lang="en">
					We're working on technical documentation for our
					projects, starting with TimeEconomyPlugin. There
					are no guides, API references or tutorials
					published yet — we'd rather show nothing than
					documentation that doesn't actually exist.
				</span>
			</p>

			<p>
				<span data-lang="es">
					Mientras tanto, puedes seguir el desarrollo a
					través de nuestro perfil de GitHub.
				</span>
				<span data-lang="en">
					In the meantime, you can follow development
					through our GitHub profile.
				</span>
			</p>

			<a
				href="https://github.com/elmoderador"
				target="_blank"
				rel="noopener noreferrer"
				class="github-link"
			>
				<span data-lang="es">Perfil de GitHub ↗</span>
				<span data-lang="en">GitHub Profile ↗</span>
			</a>
		</section>
	</main>

	<Footer />

</Layout>

<style>
.container {
	max-width: 900px;
	margin: 100px auto;
	padding: 0 32px;
}

.hero {
	text-align: center;
	margin-bottom: 70px;
}

h1 {
	font-size: 4rem;
	margin-bottom: 20px;

	background: linear-gradient(
		90deg,
		var(--text),
		var(--primary)
	);

	-webkit-background-clip: text;
	-webkit-text-fill-color: transparent;
}

.hero p {
	color: var(--text-muted);
	font-size: 1.2rem;
	max-width: 640px;
	margin: 0 auto;
	line-height: 1.8;
}

.notice {
	text-align: center;
	padding: 56px 48px;

	background: var(--surface-1);

	border: 1px solid var(--border-1);
	border-radius: 28px;

	backdrop-filter: blur(15px);
}

.badge {
	display: inline-flex;
	align-items: center;
	justify-content: center;

	padding: 8px 18px;

	border-radius: 999px;

	background: var(--primary-bg);
	border: 1px solid var(--primary-border);

	color: var(--primary);

	font-size: .8rem;
	font-weight: 700;
	letter-spacing: 2px;
}

.notice h2 {
	margin: 24px 0 0;
	color: var(--text);
	font-size: 1.7rem;
}

.notice p {
	margin-top: 20px;
	color: var(--text-muted);
	line-height: 1.8;
	max-width: 640px;
	margin-left: auto;
	margin-right: auto;
}

.github-link {
	display: inline-flex;
	margin-top: 32px;

	padding: 14px 30px;

	border-radius: 14px;

	background: var(--primary);
	color: white;

	text-decoration: none;
	font-weight: 600;

	transition: .25s ease;
}

.github-link:hover {
	transform: translateY(-3px);

	box-shadow: 0 15px 40px var(--primary-glow);
}

@media (max-width: 700px) {
	.container {
		margin: 70px auto;
		padding: 0 20px;
	}

	h1 {
		font-size: 2.6rem;
	}

	.notice {
		padding: 36px 24px;
	}
}
</style>
