---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import T from "../components/T.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { TEP_LINKS } from "../data/tep";
---

<Layout
	title="Documentation | SpectroDinner™"
	description="Documentation and resources for SpectroDinner™'s projects and services."
>

	<Navbar />

	<main>

		<section class="page-top">

			<div class="container">

				<SectionHeader
					as="h1"
					eyebrow={{ es: "Documentación", en: "Documentation" }}
					title={{ es: "Documentación", en: "Documentation" }}
				>
					<T
						es="Documentación técnica, guías y recursos para los proyectos de SpectroDinner Studios."
						en="Technical documentation, guides and resources for SpectroDinner Studios' projects."
					/>
				</SectionHeader>

			</div>

		</section>

		<section class="section-sm">

			<div class="container">

				<div class="terminal notice reveal">

					<div class="terminal-bar">
						<i></i><i></i><i></i>
						<span>~/spectrodinner/docs</span>
					</div>

					<div class="terminal-body">

						<p><span class="prompt">&gt;</span> ls docs/</p>
						<p class="listing">timeeconomyplugin/README.md</p>

						<p><span class="prompt">&gt;</span> cat timeeconomyplugin/README.md</p>

						<div class="message">

							<span class="chip chip-gold">TimeEconomyPlugin</span>

							<h2>
								<T es="Documentación de T.E.P." en="T.E.P. documentation" />
							</h2>

							<p>
								<T
									es="La documentación de TimeEconomyPlugin está en el README de su repositorio: requisitos, compatibilidad, instalación, compilación desde el código, sistemas y licencia."
									en="TimeEconomyPlugin's documentation lives in its repository README: requirements, compatibility, installation, building from source, systems and license."
								/>
							</p>

							<p>
								<T
									es="Estamos ampliándola con más guías. El resto de proyectos todavía no tiene documentación pública."
									en="We're expanding it with more guides. Our other projects don't have public documentation yet."
								/>
							</p>

							<div class="actions">
								<a href={TEP_LINKS.readme} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
									<T es="Leer el README ↗" en="Read the README ↗" />
								</a>
								<a href="/tep" class="btn btn-ghost">
									<T es="Página de T.E.P." en="T.E.P. page" /> →
								</a>
							</div>

						</div>

						<p><span class="prompt">&gt;</span> <span class="cursor"></span></p>

					</div>

				</div>

			</div>

		</section>

	</main>

	<Footer />

</Layout>

<style>

.notice {
	max-width: 860px;
	box-shadow: 0 30px 80px -30px var(--primary-glow);
}

.listing {
	color: var(--emerald);
	margin-bottom: 12px;
}

.message {
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	gap: 16px;

	margin: 14px 0 18px;
	padding: 24px;

	font-family: var(--font-main);

	background: var(--surface-1);
	border: 1px dashed var(--border-2);
	border-radius: var(--radius-xs);
}

.message h2 {
	font-size: clamp(1.5rem, 3vw, 2rem);
	font-weight: 700;
	color: var(--text);
}

.message p {
	color: var(--text-muted);
	line-height: 1.75;
}

.message .actions {
	margin-top: 6px;
}

</style>
