---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import T from "../components/T.astro";
import SectionHeader from "../components/SectionHeader.astro";
---

<Layout
	title="Documentation | SpectroDinner™"
	description="Documentation and resources for SpectroDinner™'s projects and services."
>

	<Navbar />

	<main>

		<section class="page-top">

			<div class="container">

				<SectionHeader
					as="h1"
					eyebrow={{ es: "Documentación", en: "Documentation" }}
					title={{ es: "Documentación", en: "Documentation" }}
				>
					<T
						es="Documentación técnica, guías y recursos para los proyectos de SpectroDinner Studios."
						en="Technical documentation, guides and resources for SpectroDinner Studios' projects."
					/>
				</SectionHeader>

			</div>

		</section>

		<section class="section-sm">

			<div class="container">

				<div class="terminal notice reveal">

					<div class="terminal-bar">
						<i></i><i></i><i></i>
						<span>~/spectrodinner/docs</span>
					</div>

					<div class="terminal-body">

						<p><span class="prompt">&gt;</span> ls docs/</p>
						<p class="empty"><T es="(vacío)" en="(empty)" /></p>

						<p><span class="prompt">&gt;</span> status</p>

						<div class="message">

							<span class="chip chip-gold">
								<T es="Próximamente" en="Coming soon" />
							</span>

							<h2>
								<T es="Todavía no hay documentación pública" en="No public documentation yet" />
							</h2>

							<p>
								<T
									es="Estamos preparando documentación técnica para nuestros proyectos, empezando por TimeEconomyPlugin. De momento no hay guías, referencias de API ni tutoriales publicados — no queremos mostrar documentación que no existe todavía."
									en="We're working on technical documentation for our projects, starting with TimeEconomyPlugin. There are no guides, API references or tutorials published yet — we'd rather show nothing than documentation that doesn't actually exist."
								/>
							</p>

							<p>
								<T
									es="Mientras tanto, puedes seguir el desarrollo a través de nuestro perfil de GitHub."
									en="In the meantime, you can follow development through our GitHub profile."
								/>
							</p>

							<div class="actions">
								<a
									href="https://github.com/elmoderador"
									target="_blank"
									rel="noopener noreferrer"
									class="btn btn-primary"
								>
									<T es="Perfil de GitHub ↗" en="GitHub Profile ↗" />
								</a>
								<a href="/tep" class="btn btn-ghost">
									<T es="Estado de T.E.P." en="T.E.P. status" /> →
								</a>
							</div>

						</div>

						<p><span class="prompt">&gt;</span> <span class="cursor"></span></p>

					</div>

				</div>

			</div>

		</section>

	</main>

	<Footer />

</Layout>

<style>

.notice {
	max-width: 860px;
	box-shadow: 0 30px 80px -30px var(--primary-glow);
}

.empty {
	color: var(--text-dim);
	margin-bottom: 12px;
}

.message {
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	gap: 16px;

	margin: 14px 0 18px;
	padding: 24px;

	font-family: var(--font-main);

	background: var(--surface-1);
	border: 1px dashed var(--border-2);
	border-radius: var(--radius-xs);
}

.message h2 {
	font-size: clamp(1.5rem, 3vw, 2rem);
	font-weight: 700;
	color: var(--text);
}

.message p {
	color: var(--text-muted);
	line-height: 1.75;
}

.message .actions {
	margin-top: 6px;
}

</style>
