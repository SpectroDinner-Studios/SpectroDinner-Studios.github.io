---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Cuestionario | SpectroDinner™">

	<Navbar />

	<main class="container">

		<section class="hero">

			<span class="badge">
				<span data-lang="es">CUESTIONARIO</span>
				<span data-lang="en">QUESTIONNAIRE</span>
			</span>

			<h1>
				<span data-lang="es">Cuéntanos tu servidor de Discord</span>
				<span data-lang="en">Tell us about your Discord server</span>
			</h1>

			<p data-lang="es">
				Cuanta más información nos des, mejor podremos diseñar,
				configurar o rediseñar tu servidor a tu gusto. No hace falta
				que respondas todo — pero cuanto más detalle, mejor propuesta
				podremos prepararte.
			</p>

			<p data-lang="en">
				The more information you give us, the better we can design,
				configure or redesign your server exactly the way you want.
				You don't have to answer everything — but the more detail,
				the better proposal we can prepare for you.
			</p>

			<div class="free-badge">
				<span data-lang="es">✨ Recuerda: este servicio es 100% gratuito</span>
				<span data-lang="en">✨ Remember: this service is 100% free</span>
			</div>

		</section>


		<form id="quest-form" class="form">


			<fieldset class="card">

				<legend>
					<span data-lang="es">1. Contacto</span>
					<span data-lang="en">1. Contact</span>
				</legend>

				<div class="grid two">

					<label>
						<span data-lang="es">Nombre *</span>
						<span data-lang="en">Name *</span>
						<input type="text" name="nombre" required />
					</label>

					<label>
						<span data-lang="es">Usuario de Discord</span>
						<span data-lang="en">Discord username</span>
						<input type="text" name="discord" placeholder="usuario#0000" />
					</label>

				</div>

				<label>
					<span data-lang="es">Email *</span>
					<span data-lang="en">Email *</span>
					<input type="email" name="email" required />
				</label>

			</fieldset>



			<fieldset class="card">

				<legend>
					<span data-lang="es">2. Tipo de servicio</span>
					<span data-lang="en">2. Type of service</span>
				</legend>

				<div class="radio-group">

					<label class="radio">
						<input type="radio" name="tipo" value="Crear un servidor nuevo" required />
						<span data-lang="es">Crear un servidor nuevo</span>
						<span data-lang="en">Create a new server</span>
					</label>

					<label class="radio">
						<input type="radio" name="tipo" value="Configurar mi servidor actual" />
						<span data-lang="es">Configurar mi servidor actual</span>
						<span data-lang="en">Configure my current server</span>
					</label>

					<label class="radio">
						<input type="radio" name="tipo" value="Rediseñar mi servidor actual" />
						<span data-lang="es">Rediseñar mi servidor actual</span>
						<span data-lang="en">Redesign my current server</span>
					</label>

				</div>

				<label>
					<span data-lang="es">Enlace de invitación actual (si aplica)</span>
					<span data-lang="en">Current invite link (if applicable)</span>
					<input type="text" name="invite" placeholder="discord.gg/..." />
				</label>

			</fieldset>



			<fieldset class="card">

				<legend>
					<span data-lang="es">3. Propósito del servidor</span>
					<span data-lang="en">3. Server purpose</span>
				</legend>

				<label>
					<span data-lang="es">¿Para qué es el servidor? *</span>
					<span data-lang="en">What is the server for? *</span>

					<select name="proposito" required>
						<option value="" disabled selected>-- </option>
						<option value="Comunidad de gaming">Comunidad de gaming / Gaming community</option>
						<option value="Marca o negocio">Marca o negocio / Brand or business</option>
						<option value="Creador de contenido">Creador de contenido / Content creator</option>
						<option value="Amigos / privado">Amigos / privado / Friends / private</option>
						<option value="Educación / aprendizaje">Educación / aprendizaje / Education / learning</option>
						<option value="Otro">Otro / Other</option>
					</select>
				</label>

				<label>
					<span data-lang="es">Cuéntanos más sobre el propósito</span>
					<span data-lang="en">Tell us more about the purpose</span>
					<textarea name="proposito_detalle" rows="3"></textarea>
				</label>

				<label>
					<span data-lang="es">Tamaño estimado de miembros</span>
					<span data-lang="en">Estimated member size</span>

					<select name="tamano">
						<option value="">-- </option>
						<option value="Menos de 100">&lt; 100</option>
						<option value="100 - 1.000">100 - 1,000</option>
						<option value="1.000 - 10.000">1,000 - 10,000</option>
						<option value="Más de 10.000">10,000+</option>
					</select>
				</label>

			</fieldset>



			<fieldset class="card">

				<legend>
					<span data-lang="es">4. Diseño y estilo</span>
					<span data-lang="en">4. Design and style</span>
				</legend>

				<label>
					<span data-lang="es">Estilo deseado</span>
					<span data-lang="en">Desired style</span>

					<select name="estilo">
						<option value="">-- </option>
						<option value="Minimalista">Minimalista / Minimalist</option>
						<option value="Colorido y vibrante">Colorido y vibrante / Colorful & vibrant</option>
						<option value="Oscuro / gaming">Oscuro / gaming / Dark / gaming</option>
						<option value="Elegante / corporativo">Elegante / corporativo / Elegant / corporate</option>
						<option value="Anime / arte personalizado">Anime / arte personalizado / Anime / custom art</option>
						<option value="Otro">Otro / Other</option>
					</select>
				</label>

				<label>
					<span data-lang="es">Colores, referencias, logos o servidores que te gusten (links)</span>
					<span data-lang="en">Colors, references, logos or servers you like (links)</span>
					<textarea name="referencias" rows="3"></textarea>
				</label>

			</fieldset>



			<fieldset class="card">

				<legend>
					<span data-lang="es">5. Estructura</span>
					<span data-lang="en">5. Structure</span>
				</legend>

				<label>
					<span data-lang="es">Canales y categorías que necesitas</span>
					<span data-lang="en">Channels and categories you need</span>
					<textarea name="canales" rows="3"></textarea>
				</label>

				<label>
					<span data-lang="es">Roles y permisos que necesitas</span>
					<span data-lang="en">Roles and permissions you need</span>
					<textarea name="roles" rows="3"></textarea>
				</label>

				<span class="label-heading">
					<span data-lang="es">Bots y funciones necesarias</span>
					<span data-lang="en">Bots and features needed</span>
				</span>

				<div class="checkbox-group">

					<label class="checkbox">
						<input type="checkbox" name="bots" value="Moderación" />
						<span data-lang="es">Moderación</span>
						<span data-lang="en">Moderation</span>
					</label>

					<label class="checkbox">
						<input type="checkbox" name="bots" value="Música" />
						<span data-lang="es">Música</span>
						<span data-lang="en">Music</span>
					</label>

					<label class="checkbox">
						<input type="checkbox" name="bots" value="Verificación" />
						<span data-lang="es">Verificación</span>
						<span data-lang="en">Verification</span>
					</label>

					<label class="checkbox">
						<input type="checkbox" name="bots" value="Sistema de tickets" />
						<span data-lang="es">Sistema de tickets</span>
						<span data-lang="en">Ticket system</span>
					</label>

					<label class="checkbox">
						<input type="checkbox" name="bots" value="Niveles / XP" />
						<span data-lang="es">Niveles / XP</span>
						<span data-lang="en">Leveling / XP</span>
					</label>

					<label class="checkbox">
						<input type="checkbox" name="bots" value="Economía" />
						<span data-lang="es">Economía</span>
						<span data-lang="en">Economy</span>
					</label>

					<label class="checkbox">
						<input type="checkbox" name="bots" value="Mensajes de bienvenida" />
						<span data-lang="es">Mensajes de bienvenida</span>
						<span data-lang="en">Welcome messages</span>
					</label>

					<label class="checkbox">
						<input type="checkbox" name="bots" value="Auto-moderación" />
						<span data-lang="es">Auto-moderación</span>
						<span data-lang="en">Auto-moderation</span>
					</label>

				</div>

			</fieldset>



			<fieldset class="card">

				<legend>
					<span data-lang="es">6. Plazo</span>
					<span data-lang="en">6. Timeline</span>
				</legend>

				<label>
					<span data-lang="es">Plazo deseado</span>
					<span data-lang="en">Desired timeframe</span>
					<input type="text" name="plazo" placeholder="Ej./e.g. 1 semana - 1 week" />
				</label>

			</fieldset>



			<fieldset class="card">

				<legend>
					<span data-lang="es">7. Comentarios adicionales</span>
					<span data-lang="en">7. Additional comments</span>
				</legend>

				<label>
					<span data-lang="es">¿Algo más que debamos saber?</span>
					<span data-lang="en">Anything else we should know?</span>
					<textarea name="comentarios" rows="4"></textarea>
				</label>

			</fieldset>


			<button type="submit" class="submit">
				<span data-lang="es">Enviar cuestionario →</span>
				<span data-lang="en">Submit questionnaire →</span>
			</button>

			<p class="hint">
				<span data-lang="es">
					Al enviar se abrirá tu programa de correo con un email
					prellenado dirigido a nosotros — revisa y pulsa enviar.
				</span>
				<span data-lang="en">
					Submitting will open your email app with a pre-filled
					message addressed to us — review it and hit send.
				</span>
			</p>

			<p id="quest-status" class="status" hidden>
				<span data-lang="es">
					✅ Hemos abierto tu cliente de correo. Si no se ha abierto,
					escríbenos directamente a
					<a href="mailto:oierps8@gmail.com">oierps8@gmail.com</a>.
				</span>
				<span data-lang="en">
					✅ We opened your email client. If nothing opened,
					email us directly at
					<a href="mailto:oierps8@gmail.com">oierps8@gmail.com</a>.
				</span>
			</p>

		</form>

	</main>

	<Footer />

</Layout>


<script>
	const form = document.getElementById("quest-form") as HTMLFormElement | null;
	const status = document.getElementById("quest-status");

	form?.addEventListener("submit", (e) => {
		e.preventDefault();

		const data = new FormData(form);

		const get = (name: string) => (data.get(name) || "").toString().trim();
		const getAll = (name: string) => data.getAll(name).join(", ") || "-";

		const lines = [
			"NUEVO CUESTIONARIO DE SERVIDOR DISCORD",
			"",
			`Nombre: ${get("nombre")}`,
			`Discord: ${get("discord")}`,
			`Email: ${get("email")}`,
			"",
			`Tipo de servicio: ${get("tipo")}`,
			`Enlace de invitación actual: ${get("invite")}`,
			"",
			`Propósito: ${get("proposito")}`,
			`Detalle del propósito: ${get("proposito_detalle")}`,
			`Tamaño estimado de miembros: ${get("tamano")}`,
			"",
			`Estilo deseado: ${get("estilo")}`,
			`Referencias / colores / links: ${get("referencias")}`,
			"",
			`Canales y categorías: ${get("canales")}`,
			`Roles y permisos: ${get("roles")}`,
			`Bots y funciones: ${getAll("bots")}`,
			"",
			`Plazo deseado: ${get("plazo")}`,
			"",
			`Comentarios adicionales: ${get("comentarios")}`,
		];

		const subject = `Cuestionario Discord - ${get("nombre") || "Nuevo cliente"}`;
		const body = lines.join("\n");

		const mailto = `mailto:oierps8@gmail.com?subject=${encodeURIComponent(
			subject
		)}&body=${encodeURIComponent(body)}`;

		window.location.href = mailto;

		if (status) status.hidden = false;
	});
</script>


<style>

.container {

	max-width:900px;

	margin:100px auto;

	padding:0 32px;

}


.hero {

	text-align:center;

	margin-bottom:60px;

}


.badge {

	display:inline-flex;

	align-items:center;

	justify-content:center;

	padding:10px 20px;

	border-radius:999px;

	background:rgba(10,132,255,.12);

	border:1px solid rgba(10,132,255,.35);

	color:#0A84FF;

	font-size:.85rem;

	font-weight:700;

	letter-spacing:3px;

}


h1 {

	margin-top:26px;

	font-size:clamp(2.4rem,5vw,3.6rem);

	letter-spacing:-2px;

	background:linear-gradient(90deg,#ffffff,#0a84ff);

	-webkit-background-clip:text;

	-webkit-text-fill-color:transparent;

}


.hero p {

	max-width:680px;

	margin:22px auto 0;

	color:#9ca3af;

	font-size:1.08rem;

	line-height:1.9;

}


.free-badge {

	display:inline-flex;

	align-items:center;

	justify-content:center;

	margin-top:28px;

	padding:10px 20px;

	border-radius:999px;

	background:rgba(10,132,255,.12);

	border:1px solid rgba(10,132,255,.35);

	color:#0A84FF;

	font-size:.85rem;

	font-weight:700;

}


.form {

	display:flex;

	flex-direction:column;

	gap:24px;

}


.card {

	padding:34px;

	border:1px solid rgba(255,255,255,0.1);

	border-radius:22px;

	background:rgba(255,255,255,0.04);

	backdrop-filter:blur(15px);

	display:flex;

	flex-direction:column;

	gap:22px;

}


legend {

	padding:0 4px 6px 0;

	font-size:1.2rem;

	font-weight:700;

	color:white;

}


label {

	display:flex;

	flex-direction:column;

	gap:8px;

	color:#D6DBE2;

	font-size:.95rem;

	font-weight:600;
}


.label-heading {

	display:block;

	color:#D6DBE2;

	font-size:.95rem;

	font-weight:600;

}


input[type="text"],
input[type="email"],
select,
textarea {

	padding:12px 14px;

	border-radius:12px;

	background:rgba(255,255,255,0.05);

	border:1px solid rgba(255,255,255,0.12);

	color:white;

	font-family:inherit;

	font-size:.95rem;

	font-weight:400;

	transition:.2s ease;

}


input[type="text"]:focus,
input[type="email"]:focus,
select:focus,
textarea:focus {

	outline:none;

	border-color:rgba(10,132,255,.6);

	background:rgba(255,255,255,0.07);

}


textarea {

	resize:vertical;

}


.grid.two {

	display:grid;

	grid-template-columns:1fr 1fr;

	gap:20px;

}


.radio-group,
.checkbox-group {

	display:flex;

	flex-wrap:wrap;

	gap:12px;

}


.radio,
.checkbox {

	flex-direction:row;

	align-items:center;

	gap:10px;

	padding:10px 16px;

	border-radius:999px;

	background:rgba(255,255,255,0.05);

	border:1px solid rgba(255,255,255,0.1);

	font-weight:500;

	cursor:pointer;

}


.radio input,
.checkbox input {

	accent-color:#0A84FF;

	width:16px;

	height:16px;

}


.submit {

	align-self:flex-start;

	padding:16px 36px;

	border-radius:16px;

	border:none;

	background:#0A84FF;

	color:white;

	font-weight:700;

	font-size:1rem;

	cursor:pointer;

	transition:.25s ease;

}


.submit:hover {

	transform:translateY(-3px);

	box-shadow:0 15px 40px rgba(10,132,255,.35);

}


.hint {

	color:#9CA3AF;

	font-size:.9rem;

	line-height:1.7;

}


.status {

	padding:16px 20px;

	border-radius:14px;

	background:rgba(10,132,255,.1);

	border:1px solid rgba(10,132,255,.3);

	color:#D6E8FF;

	font-size:.95rem;

	line-height:1.7;

}


.status a {

	color:#7DB7FF;

}


@media (max-width:700px) {

	.container {

		margin:70px auto;

		padding:0 20px;

	}


	.card {

		padding:24px;

	}


	.grid.two {

		grid-template-columns:1fr;

	}


	.submit {

		width:100%;

	}

}

</style>
