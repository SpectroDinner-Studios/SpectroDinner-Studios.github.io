---
import Layout from "../layouts/Layout.astro";
import "../styles/wizard.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import T from "../components/T.astro";
import Wizard from "../components/forms/Wizard.astro";
import Step from "../components/forms/Step.astro";
import Field from "../components/forms/Field.astro";
import Choices from "../components/forms/Choices.astro";

const steps = [
	{ icon: "👤", title: { es: "Contacto", en: "Contact" } },
	{ icon: "🧭", title: { es: "Tipo de servicio", en: "Service type" } },
	{ icon: "🎯", title: { es: "Propósito", en: "Purpose" } },
	{ icon: "🎨", title: { es: "Diseño y estilo", en: "Design & style" } },
	{ icon: "🧩", title: { es: "Estructura y bots", en: "Structure & bots" } },
	{ icon: "📅", title: { es: "Últimos detalles", en: "Final details" } },
];
const total = steps.length + 1;

const purposes = [
	{ value: "Comunidad de gaming", icon: "🎮", label: { es: "Comunidad de gaming", en: "Gaming community" } },
	{ value: "Marca o negocio", icon: "💼", label: { es: "Marca o negocio", en: "Brand or business" } },
	{ value: "Creador de contenido", icon: "🎥", label: { es: "Creador de contenido", en: "Content creator" } },
	{ value: "Amigos / privado", icon: "🫂", label: { es: "Amigos / privado", en: "Friends / private" } },
	{ value: "Educación / aprendizaje", icon: "📚", label: { es: "Educación / aprendizaje", en: "Education / learning" } },
	{ value: "Otro", icon: "✨", label: { es: "Otro", en: "Other" } },
];

const bots = [
	{ value: "Moderación", icon: "🛡️", label: { es: "Moderación", en: "Moderation" } },
	{ value: "Auto-moderación", icon: "🤖", label: { es: "Auto-moderación", en: "Auto-moderation" } },
	{ value: "Anti-raid / Anti-spam", icon: "🚧", label: { es: "Anti-raid / Anti-spam" } },
	{ value: "Verificación", icon: "✅", label: { es: "Verificación", en: "Verification" } },
	{ value: "Mensajes de bienvenida", icon: "👋", label: { es: "Mensajes de bienvenida", en: "Welcome messages" } },
	{ value: "Roles por reacción", icon: "🎭", label: { es: "Roles por reacción", en: "Reaction roles" } },
	{ value: "Sistema de tickets", icon: "🎫", label: { es: "Sistema de tickets", en: "Ticket system" } },
	{ value: "Niveles / XP", icon: "📈", label: { es: "Niveles / XP", en: "Leveling / XP" } },
	{ value: "Economía", icon: "💰", label: { es: "Economía", en: "Economy" } },
	{ value: "Música", icon: "🎵", label: { es: "Música", en: "Music" } },
	{ value: "Sorteos", icon: "🎁", label: { es: "Sorteos", en: "Giveaways" } },
	{ value: "Sugerencias", icon: "💡", label: { es: "Sugerencias", en: "Suggestions" } },
	{ value: "Starboard", icon: "⭐", label: { es: "Starboard" } },
	{ value: "Logs del servidor", icon: "🗂️", label: { es: "Logs del servidor", en: "Server logs" } },
	{ value: "Notificaciones YouTube/Twitch", icon: "📣", label: { es: "Notificaciones YouTube/Twitch", en: "YouTube/Twitch notifications" } },
	{ value: "Comandos personalizados", icon: "⌨️", label: { es: "Comandos personalizados", en: "Custom commands" } },
];

// Suggested bots per purpose (values must match the options above).
const recommended: Record<string, string[]> = {
	"Comunidad de gaming": ["Moderación", "Anti-raid / Anti-spam", "Mensajes de bienvenida", "Roles por reacción", "Niveles / XP", "Música"],
	"Marca o negocio": ["Moderación", "Verificación", "Sistema de tickets", "Mensajes de bienvenida", "Sugerencias", "Logs del servidor"],
	"Creador de contenido": ["Moderación", "Roles por reacción", "Niveles / XP", "Sorteos", "Starboard", "Notificaciones YouTube/Twitch"],
	"Amigos / privado": ["Música", "Niveles / XP", "Starboard", "Comandos personalizados"],
	"Educación / aprendizaje": ["Moderación", "Verificación", "Roles por reacción", "Sistema de tickets", "Logs del servidor"],
	Otro: ["Moderación", "Anti-raid / Anti-spam", "Mensajes de bienvenida"],
};
---

<Layout
	title="Cuestionario | SpectroDinner™"
	description="Cuéntanos qué necesitas para tu servidor de Discord — creación, configuración o rediseño, 100% gratis."
>

	<Navbar />

	<main class="container wz-page">

		<header class="wz-hero">
			<span class="eyebrow"><T es="Servicio de Discord" en="Discord service" /></span>
			<h1><T es="Cuéntanos tu servidor de Discord" en="Tell us about your Discord server" /></h1>
			<p>
				<T
					es="Cuanta más información nos des, mejor podremos diseñar, configurar o rediseñar tu servidor a tu gusto. Solo hay cuatro datos obligatorios — el resto nos ayuda a prepararte una propuesta mejor."
					en="The more information you give us, the better we can design, configure or redesign your server the way you want. Only four things are required — the rest helps us prepare a better proposal."
				/>
			</p>
			<div class="wz-perks">
				<span class="chip chip-gold">✨ <T es="100% gratis" en="100% free" /></span>
				<span class="chip">⏱ ≈ 4 min</span>
				<span class="chip">💾 <T es="Se guarda solo en tu navegador" en="Auto-saved in your browser" /></span>
			</div>
		</header>

		<Wizard
			formId="quest-form"
			quest={{ icon: "💬", code: "QUEST // DISCORD", title: { es: "Servicio de Discord", en: "Discord Service" } }}
			steps={steps}
			minutes={4}
			submitLabel={{ es: "Enviar cuestionario →", en: "Send questionnaire →" }}
			success={{
				title: { es: "¡Cuestionario recibido!", en: "Questionnaire received!" },
				text: {
					es: "Gracias por contarnos tu idea. Tenemos todo lo que necesitamos para empezar a preparar tu propuesta.",
					en: "Thanks for telling us your idea. We have everything we need to start preparing your proposal.",
				},
				next: [
					{ icon: "📥", text: { es: "Revisamos tus respuestas y preparamos una propuesta a tu medida.", en: "We review your answers and prepare a proposal made for you." } },
					{ icon: "💬", text: { es: "Te escribimos por email o Discord para confirmar detalles y plazo antes de empezar.", en: "We reach out by email or Discord to confirm details and timing before starting." } },
					{ icon: "🛠️", text: { es: "Montamos tu servidor — sin ningún coste.", en: "We build your server — at no cost." } },
				],
				backHref: "/",
				backLabel: { es: "Volver al inicio", en: "Back to home" },
			}}
		>

			<Step id="contacto" n={1} total={total} {...steps[0]} intro={{ es: "¿Cómo te llamamos y dónde te respondemos?", en: "What should we call you and where do we reply?" }}>
				<Field name="nombre" label={{ es: "Nombre", en: "Name" }} required maxlength={80} autocomplete="name" placeholder={{ es: "Tu nombre", en: "Your name" }} half />
				<Field name="discord" label={{ es: "Usuario de Discord", en: "Discord username" }} maxlength={50} placeholder={{ es: "tu_usuario", en: "your_username" }} half />
				<Field
					name="email"
					type="email"
					label={{ es: "Email", en: "Email" }}
					required
					maxlength={120}
					autocomplete="email"
					placeholder={{ es: "tu@email.com", en: "you@email.com" }}
					help={{ es: "Te responderemos aquí. No lo compartimos con nadie.", en: "We'll reply here. We never share it." }}
				/>
			</Step>

			<Step id="servicio" n={2} total={total} {...steps[1]} intro={{ es: "¿Qué hacemos por ti?", en: "What can we do for you?" }}>
				<Choices
					name="tipo"
					label={{ es: "Tipo de servicio", en: "Type of service" }}
					required
					columns={3}
					options={[
						{ value: "Crear un servidor nuevo", icon: "✨", label: { es: "Crear un servidor nuevo", en: "Create a new server" }, desc: { es: "Lo montamos desde cero.", en: "We build it from scratch." } },
						{ value: "Configurar mi servidor actual", icon: "⚙️", label: { es: "Configurar mi servidor", en: "Configure my server" }, desc: { es: "Bots, roles, permisos y canales.", en: "Bots, roles, permissions and channels." } },
						{ value: "Rediseñar mi servidor actual", icon: "🎨", label: { es: "Rediseñar mi servidor", en: "Redesign my server" }, desc: { es: "Nueva identidad y reorganización.", en: "New identity and reorganization." } },
					]}
				/>
				<Field
					name="invite"
					label={{ es: "Enlace de invitación actual", en: "Current invite link" }}
					maxlength={200}
					placeholder={{ es: "discord.gg/…" }}
					help={{ es: "Para echar un vistazo a cómo está ahora.", en: "So we can see how it looks right now." }}
					showWhen="tipo=Configurar mi servidor actual|Rediseñar mi servidor actual"
				/>
			</Step>

			<Step id="proposito" n={3} total={total} {...steps[2]} intro={{ es: "Para qué es el servidor y cuánta gente esperas.", en: "What the server is for and how many people you expect." }}>
				<Choices name="proposito" label={{ es: "¿Para qué es el servidor?", en: "What is the server for?" }} required columns={3} options={purposes} />
				<Field
					name="proposito_detalle"
					type="textarea"
					label={{ es: "Cuéntanos más sobre el propósito", en: "Tell us more about the purpose" }}
					maxlength={1000}
					rows={3}
					placeholder={{ es: "Ej. Comunidad de Minecraft con eventos semanales y torneos…", en: "e.g. Minecraft community with weekly events and tournaments…" }}
				/>
				<Choices
					name="tamano"
					label={{ es: "Tamaño estimado de miembros", en: "Estimated member size" }}
					columns={4}
					options={[
						{ value: "Menos de 100", icon: "🌱", label: { es: "< 100" } },
						{ value: "100 - 1.000", icon: "🌿", label: { es: "100 – 1.000", en: "100 – 1,000" } },
						{ value: "1.000 - 10.000", icon: "🌳", label: { es: "1.000 – 10.000", en: "1,000 – 10,000" } },
						{ value: "Más de 10.000", icon: "🏔️", label: { es: "10.000+", en: "10,000+" } },
					]}
				/>
			</Step>

			<Step id="estilo" n={4} total={total} {...steps[3]} intro={{ es: "Cómo quieres que se vea y se sienta.", en: "How you want it to look and feel." }}>
				<Choices
					name="estilo"
					label={{ es: "Estilo deseado", en: "Desired style" }}
					columns={3}
					options={[
						{ value: "Minimalista", icon: "◻️", label: { es: "Minimalista", en: "Minimalist" }, desc: { es: "Limpio y ordenado.", en: "Clean and tidy." } },
						{ value: "Colorido y vibrante", icon: "🌈", label: { es: "Colorido y vibrante", en: "Colorful & vibrant" }, desc: { es: "Mucho color y energía.", en: "Lots of color and energy." } },
						{ value: "Oscuro / gaming", icon: "🕹️", label: { es: "Oscuro / gaming", en: "Dark / gaming" }, desc: { es: "Tonos oscuros y neón.", en: "Dark tones and neon." } },
						{ value: "Elegante / corporativo", icon: "🏛️", label: { es: "Elegante / corporativo", en: "Elegant / corporate" }, desc: { es: "Serio y profesional.", en: "Serious and professional." } },
						{ value: "Anime / arte personalizado", icon: "🌸", label: { es: "Anime / arte propio", en: "Anime / custom art" }, desc: { es: "Ilustraciones y temática.", en: "Illustrations and theme." } },
						{ value: "Otro", icon: "✨", label: { es: "Otro", en: "Other" }, desc: { es: "Cuéntanoslo abajo.", en: "Tell us below." } },
					]}
				/>
				<Field
					name="referencias"
					type="textarea"
					label={{ es: "Colores, referencias, logos o servidores que te gusten", en: "Colors, references, logos or servers you like" }}
					maxlength={1000}
					rows={3}
					placeholder={{ es: "Ej. Azul y morado, https://discord.gg/… como referencia, logo en https://…", en: "e.g. Blue and purple, https://discord.gg/… as reference, logo at https://…" }}
					help={{ es: "Puedes pegar enlaces.", en: "Links are welcome." }}
				/>
			</Step>

			<Step id="estructura" n={5} total={total} {...steps[4]} intro={{ es: "Pulsa las sugerencias para añadirlas o escribe lo tuyo. Si no lo tienes claro, déjalo en blanco y te proponemos una estructura.", en: "Tap the suggestions to add them or write your own. If you're not sure, leave it blank and we'll propose a structure." }}>
				<Field
					name="canales"
					type="textarea"
					label={{ es: "Canales y categorías que necesitas", en: "Channels and categories you need" }}
					maxlength={1000}
					rows={4}
					chips={[
						{ es: "📢 anuncios", en: "📢 announcements" },
						{ es: "📜 reglas", en: "📜 rules" },
						{ es: "👋 bienvenida", en: "👋 welcome" },
						{ es: "💬 general" },
						{ es: "🖼️ memes-y-clips", en: "🖼️ memes-and-clips" },
						{ es: "🎮 juegos", en: "🎮 games" },
						{ es: "🎫 soporte", en: "🎫 support" },
						{ es: "🔊 canales de voz", en: "🔊 voice channels" },
					]}
				/>
				<Field
					name="roles"
					type="textarea"
					label={{ es: "Roles y permisos que necesitas", en: "Roles and permissions you need" }}
					maxlength={1000}
					rows={3}
					chips={[
						{ es: "👑 Owner" },
						{ es: "🛡️ Admin" },
						{ es: "🔨 Moderador", en: "🔨 Moderator" },
						{ es: "⭐ VIP / Booster" },
						{ es: "🤖 Bots" },
						{ es: "👤 Miembro", en: "👤 Member" },
					]}
				/>
				<Choices
					name="bots"
					type="checkbox"
					label={{ es: "Bots y funciones necesarias", en: "Bots and features needed" }}
					compact
					options={bots}
				>
					<div class="wz-presets" slot="before">
						{Object.entries(recommended).map(([purpose, values]) => (
							<button
								type="button"
								class="wz-chip"
								data-check-name="bots"
								data-check-values={values.join("|")}
								data-show-when={`proposito=${purpose}`}
							>
								✨ <T es="Marcar los recomendados para tu propósito" en="Tick the ones we recommend for your purpose" />
							</button>
						))}
					</div>
				</Choices>
			</Step>

			<Step id="detalles" n={6} total={total} {...steps[5]} intro={{ es: "Ya casi está.", en: "Almost there." }}>
				<Field
					name="plazo"
					label={{ es: "Plazo deseado", en: "Desired timeframe" }}
					maxlength={100}
					placeholder={{ es: "Ej. 1 semana", en: "e.g. 1 week" }}
					chipMode="replace"
					chips={[
						{ es: "Lo antes posible", en: "As soon as possible" },
						{ es: "1 semana", en: "1 week" },
						{ es: "2 semanas", en: "2 weeks" },
						{ es: "1 mes", en: "1 month" },
						{ es: "Sin prisa", en: "No rush" },
					]}
				/>
				<Field
					name="comentarios"
					type="textarea"
					label={{ es: "¿Algo más que debamos saber?", en: "Anything else we should know?" }}
					maxlength={1000}
					rows={4}
				/>
			</Step>

		</Wizard>

	</main>

	<Footer />

</Layout>

<script>
	import { initWizard } from "../scripts/wizard";

	initWizard({
		formId: "quest-form",
		buildPayload: (data) => {
			const get = (name: string) => (data.get(name) || "").toString().trim();
			const getAll = (name: string) => data.getAll(name).join(", ");

			return {
				form: "discord",
				nombre: get("nombre"),
				discord: get("discord"),
				email: get("email"),
				tipo: get("tipo"),
				invite: get("invite"),
				proposito: get("proposito"),
				proposito_detalle: get("proposito_detalle"),
				tamano: get("tamano"),
				estilo: get("estilo"),
				referencias: get("referencias"),
				canales: get("canales"),
				roles: get("roles"),
				bots: getAll("bots"),
				plazo: get("plazo"),
				comentarios: get("comentarios"),
			};
		},
	});
</script>
