---
import Layout from "../layouts/Layout.astro";
import "../styles/forms.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout
	title="Cuestionario | SpectroDinner™"
	description="Cuéntanos qué necesitas para tu servidor de Discord — creación, configuración o rediseño, 100% gratis."
>

	<Navbar />

	<main class="container form-page form-ui">

		<section class="hero">

			<span class="badge">
				<span data-lang="es">CUESTIONARIO</span>
				<span data-lang="en">QUESTIONNAIRE</span>
			</span>

			<h1>
				<span data-lang="es">Cuéntanos tu servidor de Discord</span>
				<span data-lang="en">Tell us about your Discord server</span>
			</h1>

			<p data-lang="es">
				Cuanta más información nos des, mejor podremos diseñar,
				configurar o rediseñar tu servidor a tu gusto. No hace falta
				que respondas todo — pero cuanto más detalle, mejor propuesta
				podremos prepararte.
			</p>

			<p data-lang="en">
				The more information you give us, the better we can design,
				configure or redesign your server exactly the way you want.
				You don't have to answer everything — but the more detail,
				the better proposal we can prepare for you.
			</p>

			<div class="free-badge">
				<span data-lang="es">✨ Recuerda: este servicio es 100% gratuito</span>
				<span data-lang="en">✨ Remember: this service is 100% free</span>
			</div>

		</section>


		<form id="quest-form" class="form" novalidate>


			<fieldset class="card">

				<legend>
					<span data-lang="es">1. Contacto</span>
					<span data-lang="en">1. Contact</span>
				</legend>

				<div class="grid two">

					<label>
						<span data-lang="es">Nombre *</span>
						<span data-lang="en">Name *</span>
						<input
							type="text"
							name="nombre"
							autocomplete="name"
							maxlength="80"
							required
							aria-describedby="err-nombre"
						/>
						<span id="err-nombre" class="field-error" aria-live="polite"></span>
					</label>

					<label>
						<span data-lang="es">Usuario de Discord (opcional)</span>
						<span data-lang="en">Discord username (optional)</span>
						<input
							type="text"
							name="discord"
							placeholder="usuario#0000"
							autocomplete="off"
							maxlength="50"
						/>
					</label>

				</div>

				<label>
					<span data-lang="es">Email *</span>
					<span data-lang="en">Email *</span>
					<input
						type="email"
						name="email"
						autocomplete="email"
						maxlength="120"
						required
						aria-describedby="err-email"
					/>
					<span id="err-email" class="field-error" aria-live="polite"></span>
				</label>

			</fieldset>



			<fieldset class="card">

				<legend>
					<span data-lang="es">2. Tipo de servicio</span>
					<span data-lang="en">2. Type of service</span>
				</legend>

				<div class="radio-group" role="radiogroup" aria-describedby="err-tipo">

					<label class="radio">
						<input type="radio" name="tipo" value="Crear un servidor nuevo" required />
						<span data-lang="es">Crear un servidor nuevo</span>
						<span data-lang="en">Create a new server</span>
					</label>

					<label class="radio">
						<input type="radio" name="tipo" value="Configurar mi servidor actual" />
						<span data-lang="es">Configurar mi servidor actual</span>
						<span data-lang="en">Configure my current server</span>
					</label>

					<label class="radio">
						<input type="radio" name="tipo" value="Rediseñar mi servidor actual" />
						<span data-lang="es">Rediseñar mi servidor actual</span>
						<span data-lang="en">Redesign my current server</span>
					</label>

				</div>
				<span id="err-tipo" class="field-error" aria-live="polite"></span>

				<label>
					<span data-lang="es">Enlace de invitación actual (opcional, si aplica)</span>
					<span data-lang="en">Current invite link (optional, if applicable)</span>
					<input
						type="text"
						name="invite"
						placeholder="discord.gg/..."
						autocomplete="off"
						maxlength="200"
					/>
				</label>

			</fieldset>



			<fieldset class="card">

				<legend>
					<span data-lang="es">3. Propósito del servidor</span>
					<span data-lang="en">3. Server purpose</span>
				</legend>

				<label>
					<span data-lang="es">¿Para qué es el servidor? *</span>
					<span data-lang="en">What is the server for? *</span>

					<select name="proposito" required aria-describedby="err-proposito">
						<option value="" disabled selected>-- </option>
						<option value="Comunidad de gaming">Comunidad de gaming / Gaming community</option>
						<option value="Marca o negocio">Marca o negocio / Brand or business</option>
						<option value="Creador de contenido">Creador de contenido / Content creator</option>
						<option value="Amigos / privado">Amigos / privado / Friends / private</option>
						<option value="Educación / aprendizaje">Educación / aprendizaje / Education / learning</option>
						<option value="Otro">Otro / Other</option>
					</select>
					<span id="err-proposito" class="field-error" aria-live="polite"></span>
				</label>

				<label>
					<span data-lang="es">Cuéntanos más sobre el propósito (opcional)</span>
					<span data-lang="en">Tell us more about the purpose (optional)</span>
					<textarea name="proposito_detalle" rows="3" maxlength="1000"></textarea>
				</label>

				<label>
					<span data-lang="es">Tamaño estimado de miembros (opcional)</span>
					<span data-lang="en">Estimated member size (optional)</span>

					<select name="tamano">
						<option value="">-- </option>
						<option value="Menos de 100">&lt; 100</option>
						<option value="100 - 1.000">100 - 1,000</option>
						<option value="1.000 - 10.000">1,000 - 10,000</option>
						<option value="Más de 10.000">10,000+</option>
					</select>
				</label>

			</fieldset>



			<fieldset class="card">

				<legend>
					<span data-lang="es">4. Diseño y estilo</span>
					<span data-lang="en">4. Design and style</span>
				</legend>

				<label>
					<span data-lang="es">Estilo deseado (opcional)</span>
					<span data-lang="en">Desired style (optional)</span>

					<select name="estilo">
						<option value="">-- </option>
						<option value="Minimalista">Minimalista / Minimalist</option>
						<option value="Colorido y vibrante">Colorido y vibrante / Colorful & vibrant</option>
						<option value="Oscuro / gaming">Oscuro / gaming / Dark / gaming</option>
						<option value="Elegante / corporativo">Elegante / corporativo / Elegant / corporate</option>
						<option value="Anime / arte personalizado">Anime / arte personalizado / Anime / custom art</option>
						<option value="Otro">Otro / Other</option>
					</select>
				</label>

				<label>
					<span data-lang="es">Colores, referencias, logos o servidores que te gusten — links (opcional)</span>
					<span data-lang="en">Colors, references, logos or servers you like — links (optional)</span>
					<textarea name="referencias" rows="3" maxlength="1000"></textarea>
				</label>

			</fieldset>



			<fieldset class="card">

				<legend>
					<span data-lang="es">5. Estructura</span>
					<span data-lang="en">5. Structure</span>
				</legend>

				<label>
					<span data-lang="es">Canales y categorías que necesitas (opcional)</span>
					<span data-lang="en">Channels and categories you need (optional)</span>
					<textarea name="canales" rows="3" maxlength="1000"></textarea>
				</label>

				<label>
					<span data-lang="es">Roles y permisos que necesitas (opcional)</span>
					<span data-lang="en">Roles and permissions you need (optional)</span>
					<textarea name="roles" rows="3" maxlength="1000"></textarea>
				</label>

				<span class="label-heading">
					<span data-lang="es">Bots y funciones necesarias (opcional)</span>
					<span data-lang="en">Bots and features needed (optional)</span>
				</span>

				<div class="checkbox-group">

					<label class="checkbox">
						<input type="checkbox" name="bots" value="Moderación" />
						<span data-lang="es">Moderación</span>
						<span data-lang="en">Moderation</span>
					</label>

					<label class="checkbox">
						<input type="checkbox" name="bots" value="Música" />
						<span data-lang="es">Música</span>
						<span data-lang="en">Music</span>
					</label>

					<label class="checkbox">
						<input type="checkbox" name="bots" value="Verificación" />
						<span data-lang="es">Verificación</span>
						<span data-lang="en">Verification</span>
					</label>

					<label class="checkbox">
						<input type="checkbox" name="bots" value="Sistema de tickets" />
						<span data-lang="es">Sistema de tickets</span>
						<span data-lang="en">Ticket system</span>
					</label>

					<label class="checkbox">
						<input type="checkbox" name="bots" value="Niveles / XP" />
						<span data-lang="es">Niveles / XP</span>
						<span data-lang="en">Leveling / XP</span>
					</label>

					<label class="checkbox">
						<input type="checkbox" name="bots" value="Economía" />
						<span data-lang="es">Economía</span>
						<span data-lang="en">Economy</span>
					</label>

					<label class="checkbox">
						<input type="checkbox" name="bots" value="Mensajes de bienvenida" />
						<span data-lang="es">Mensajes de bienvenida</span>
						<span data-lang="en">Welcome messages</span>
					</label>

					<label class="checkbox">
						<input type="checkbox" name="bots" value="Auto-moderación" />
						<span data-lang="es">Auto-moderación</span>
						<span data-lang="en">Auto-moderation</span>
					</label>

					<label class="checkbox">
						<input type="checkbox" name="bots" value="Roles por reacción" />
						<span data-lang="es">Roles por reacción</span>
						<span data-lang="en">Reaction roles</span>
					</label>

					<label class="checkbox">
						<input type="checkbox" name="bots" value="Anti-raid / Anti-spam" />
						<span data-lang="es">Anti-raid / Anti-spam</span>
						<span data-lang="en">Anti-raid / Anti-spam</span>
					</label>

					<label class="checkbox">
						<input type="checkbox" name="bots" value="Sorteos" />
						<span data-lang="es">Sorteos</span>
						<span data-lang="en">Giveaways</span>
					</label>

					<label class="checkbox">
						<input type="checkbox" name="bots" value="Logs del servidor" />
						<span data-lang="es">Logs del servidor</span>
						<span data-lang="en">Server logs</span>
					</label>

					<label class="checkbox">
						<input type="checkbox" name="bots" value="Notificaciones YouTube/Twitch" />
						<span data-lang="es">Notificaciones YouTube/Twitch</span>
						<span data-lang="en">YouTube/Twitch notifications</span>
					</label>

					<label class="checkbox">
						<input type="checkbox" name="bots" value="Sugerencias" />
						<span data-lang="es">Sugerencias</span>
						<span data-lang="en">Suggestions</span>
					</label>

					<label class="checkbox">
						<input type="checkbox" name="bots" value="Starboard" />
						<span data-lang="es">Starboard</span>
						<span data-lang="en">Starboard</span>
					</label>

					<label class="checkbox">
						<input type="checkbox" name="bots" value="Comandos personalizados" />
						<span data-lang="es">Comandos personalizados</span>
						<span data-lang="en">Custom commands</span>
					</label>

				</div>

			</fieldset>



			<fieldset class="card">

				<legend>
					<span data-lang="es">6. Plazo</span>
					<span data-lang="en">6. Timeline</span>
				</legend>

				<label>
					<span data-lang="es">Plazo deseado (opcional)</span>
					<span data-lang="en">Desired timeframe (optional)</span>
					<input
						type="text"
						name="plazo"
						placeholder="Ej./e.g. 1 semana - 1 week"
						autocomplete="off"
						maxlength="100"
					/>
				</label>

			</fieldset>



			<fieldset class="card">

				<legend>
					<span data-lang="es">7. Comentarios adicionales</span>
					<span data-lang="en">7. Additional comments</span>
				</legend>

				<label>
					<span data-lang="es">¿Algo más que debamos saber? (opcional)</span>
					<span data-lang="en">Anything else we should know? (optional)</span>
					<textarea name="comentarios" rows="4" maxlength="1000"></textarea>
				</label>

			</fieldset>


			<div class="security-note" role="note">
				<span data-lang="es">
					🔒 <strong>Nunca envíes contraseñas, claves de API,
					tokens ni ningún otro tipo de credencial secreta a
					través de este formulario.</strong>
				</span>
				<span data-lang="en">
					🔒 <strong>Never submit passwords, API keys, tokens
					or other secrets through this form.</strong>
				</span>
			</div>


			<div class="honeypot" aria-hidden="true">
				<label for="quest-website">Website</label>
				<input
					type="text"
					id="quest-website"
					name="website"
					tabindex="-1"
					autocomplete="off"
				/>
			</div>


			<p id="form-error-summary" class="status error" role="alert" hidden></p>


			<button type="submit" class="submit">
				<span class="submit-label">
					<span data-lang="es">Enviar cuestionario →</span>
					<span data-lang="en">Submit questionnaire →</span>
				</span>
				<span class="submit-label submit-loading" hidden>
					<span data-lang="es">Enviando…</span>
					<span data-lang="en">Sending…</span>
				</span>
			</button>

			<p id="quest-status" class="status" hidden>
				<span data-lang="es">
					✅ ¡Gracias! Hemos recibido tu cuestionario y te
					contactaremos pronto.
				</span>
				<span data-lang="en">
					✅ Thanks! We've received your questionnaire and
					will contact you soon.
				</span>
			</p>

			<p id="quest-error" class="status error" hidden>
				<span data-lang="es">
					⚠️ Ha ocurrido un error al enviar el formulario.
					Escríbenos directamente a
					<a href="mailto:oierps8@gmail.com">oierps8@gmail.com</a>.
				</span>
				<span data-lang="en">
					⚠️ Something went wrong submitting the form. Please
					email us directly at
					<a href="mailto:oierps8@gmail.com">oierps8@gmail.com</a>.
				</span>
			</p>

		</form>

	</main>

	<Footer />

</Layout>


<script>
	import { submitForm } from "../scripts/submit";

	const form = document.getElementById("quest-form") as HTMLFormElement | null;
	const status = document.getElementById("quest-status");
	const error = document.getElementById("quest-error");
	const errorSummary = document.getElementById("form-error-summary");

	const submitBtn = form?.querySelector<HTMLButtonElement>(".submit");
	const submitLabel = submitBtn?.querySelector(".submit-label:not(.submit-loading)");
	const submitLoading = submitBtn?.querySelector(".submit-loading");

	const messages = {
		es: { required: "Este campo es obligatorio.", choose: "Elige una opción.", email: "Introduce un email válido." },
		en: { required: "This field is required.", choose: "Please choose an option.", email: "Enter a valid email address." },
	};

	const currentLang = () => (document.documentElement.lang === "en" ? "en" : "es");

	const clearFieldError = (input: HTMLElement, errorId: string) => {
		input.removeAttribute("aria-invalid");
		const el = document.getElementById(errorId);
		if (el) el.textContent = "";
	};

	const setFieldError = (input: HTMLElement, errorId: string, text: string) => {
		input.setAttribute("aria-invalid", "true");
		const el = document.getElementById(errorId);
		if (el) el.textContent = text;
	};

	const validateForm = (): boolean => {
		if (!form) return false;

		let firstInvalid: HTMLElement | null = null;
		const lang = currentLang();

		const requiredTextFields = [
			{ name: "nombre", errorId: "err-nombre" },
			{ name: "email", errorId: "err-email" },
		];

		for (const { name, errorId } of requiredTextFields) {
			const input = form.elements.namedItem(name) as HTMLInputElement | null;
			if (!input) continue;

			if (!input.value.trim()) {
				setFieldError(input, errorId, messages[lang].required);
				firstInvalid ??= input;
			} else if (name === "email" && !input.checkValidity()) {
				setFieldError(input, errorId, messages[lang].email);
				firstInvalid ??= input;
			} else {
				clearFieldError(input, errorId);
			}
		}

		const proposito = form.elements.namedItem("proposito") as HTMLSelectElement | null;
		if (proposito) {
			if (!proposito.value) {
				setFieldError(proposito, "err-proposito", messages[lang].choose);
				firstInvalid ??= proposito;
			} else {
				clearFieldError(proposito, "err-proposito");
			}
		}

		const tipoRadios = form.querySelectorAll<HTMLInputElement>('input[name="tipo"]');
		const tipoChecked = Array.from(tipoRadios).some((r) => r.checked);
		const tipoError = document.getElementById("err-tipo");
		if (!tipoChecked) {
			if (tipoError) tipoError.textContent = messages[lang].choose;
			firstInvalid ??= tipoRadios[0];
		} else if (tipoError) {
			tipoError.textContent = "";
		}

		if (errorSummary) {
			if (firstInvalid) {
				errorSummary.textContent =
					lang === "es"
						? "Revisa los campos marcados en rojo antes de enviar."
						: "Please check the fields highlighted in red before submitting.";
				errorSummary.hidden = false;
			} else {
				errorSummary.hidden = true;
				errorSummary.textContent = "";
			}
		}

		firstInvalid?.focus();
		return !firstInvalid;
	};

	const COOLDOWN_MS = 8000;
	let cooling = false;

	const setSubmitting = (submitting: boolean) => {
		submitBtn?.toggleAttribute("disabled", submitting);
		submitLabel?.toggleAttribute("hidden", submitting);
		submitLoading?.toggleAttribute("hidden", !submitting);
	};

	form?.addEventListener("submit", async (e) => {
		e.preventDefault();
		if (cooling) return;

		status?.setAttribute("hidden", "");
		error?.setAttribute("hidden", "");

		const honeypot = form.elements.namedItem("website") as HTMLInputElement | null;
		if (honeypot?.value) {
			form.reset();
			status?.removeAttribute("hidden");
			return;
		}

		if (!validateForm()) return;

		const data = new FormData(form);
		const get = (name: string) => (data.get(name) || "").toString().trim();
		const getAll = (name: string) => data.getAll(name).join(", ");

		const payload = {
			form: "discord",
			nombre: get("nombre"),
			discord: get("discord"),
			email: get("email"),
			tipo: get("tipo"),
			invite: get("invite"),
			proposito: get("proposito"),
			proposito_detalle: get("proposito_detalle"),
			tamano: get("tamano"),
			estilo: get("estilo"),
			referencias: get("referencias"),
			canales: get("canales"),
			roles: get("roles"),
			bots: getAll("bots"),
			plazo: get("plazo"),
			comentarios: get("comentarios"),
		};

		setSubmitting(true);
		cooling = true;

		try {
			await submitForm(payload);

			form.reset();
			status?.removeAttribute("hidden");
		} catch (err) {
			error?.removeAttribute("hidden");
		} finally {
			setSubmitting(false);
			setTimeout(() => {
				cooling = false;
			}, COOLDOWN_MS);
		}
	});
</script>


