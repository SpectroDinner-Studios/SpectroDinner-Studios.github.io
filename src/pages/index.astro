---
import Layout from "../layouts/Layout.astro";

import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import T from "../components/T.astro";
import CTABanner from "../components/CTABanner.astro";

import Hero from "../components/index/Hero.astro";
import WhatIsSpectroDinner from "../components/index/WhatIsSpectroDinner.astro";
import WhatWeBuild from "../components/index/WhatWeBuild.astro";
import DiscordServices from "../components/index/DiscordServices.astro";
import QuestionnaireCTA from "../components/index/QuestionnaireCTA.astro";
import ExperimentalWork from "../components/index/ExperimentalWork.astro";
import Reviews from "../components/index/Reviews.astro";
import Leadership from "../components/index/Leadership.astro";

import FAQ from "../components/faq/FAQ.astro";
---

<Layout
	title="SpectroDinner™ | Independent Development Studio"
	description="SpectroDinner™ is an independent development studio building software, games, Minecraft plugins and Discord server setups."
>
	<Navbar />

	<main>
		<Hero />
		<WhatIsSpectroDinner />
		<WhatWeBuild />
		<DiscordServices />
		<QuestionnaireCTA />
		<ExperimentalWork />
		<Reviews />
		<Leadership />
		<FAQ />

		<CTABanner
			eyebrow={{ es: "Sigue explorando", en: "Continue exploring" }}
			title={{ es: "Descubre más de SpectroDinner Studios", en: "Discover more from SpectroDinner Studios" }}
			text={{
				es: "Explora nuestros proyectos y documentación a través de nuestras plataformas oficiales. Cada proyecto refleja nuestro compromiso con la calidad, el rendimiento y la mantenibilidad a largo plazo.",
				en: "Explore our projects and documentation through our official platforms. Every project reflects our commitment to quality, performance and long-term maintainability.",
			}}
		>
			<a href="https://github.com/elmoderador" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
				<T es="Perfil de GitHub ↗" en="GitHub Profile ↗" />
			</a>
			<a href="/documentation" class="btn btn-ghost">
				<T es="Documentación" en="Documentation" /> →
			</a>
		</CTABanner>
	</main>

	<Footer />
</Layout>
