---
import T from "./T.astro";

const accents = [
	{ id: "blue", value: "#0A84FF" },
	{ id: "purple", value: "#8B5CF6" },
	{ id: "green", value: "#22C55E" },
	{ id: "pink", value: "#EC4899" },
	{ id: "orange", value: "#F97316" },
	{ id: "red", value: "#EF4444" },
];
---

<div class="settings">

	<button type="button" class="settings-toggle" aria-label="Settings / Configuración" aria-expanded="false">
		<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
			<path
				fill="currentColor"
				d="M10 2h4v3h2v1h1v1h1v2h3v4h-3v2h-1v1h-1v1h-2v3h-4v-3H8v-1H7v-1H6v-2H3V9h3V7h1V6h1V5h2V2Zm0 8v4h4v-4h-4Z"
			/>
		</svg>
	</button>

	<div class="settings-panel">

		<div class="panel-head">
			<span><T es="Ajustes" en="Settings" /></span>
			<span class="panel-code">CFG.SYS</span>
		</div>

		<div class="settings-section">
			<span class="settings-label">
				<T es="Tema" en="Theme" />
			</span>

			<div class="theme-switch">
				<button type="button" class="theme-btn" data-theme-choice="system">
					<T es="🖥️ Sistema" en="🖥️ System" />
				</button>
				<button type="button" class="theme-btn" data-theme-choice="dark">
					<T es="🌙 Oscuro" en="🌙 Dark" />
				</button>
				<button type="button" class="theme-btn" data-theme-choice="light">
					<T es="☀️ Claro" en="☀️ Light" />
				</button>
				<button type="button" class="theme-btn" data-theme-choice="amoled">
					<T es="⚫ AMOLED" />
				</button>
				<button type="button" class="theme-btn" data-theme-choice="contrast">
					<T es="◐ Alto contraste" en="◐ High contrast" />
				</button>
			</div>
		</div>

		<div class="settings-section">
			<span class="settings-label">
				<T es="Color de acento" en="Accent color" />
			</span>

			<div class="swatches">
				{accents.map((accent) => (
					<button
						type="button"
						class="swatch"
						data-accent={accent.value}
						style={`--swatch-color: ${accent.value}`}
						aria-label={accent.id}
					/>
				))}
			</div>
		</div>

		<div class="settings-section">
			<span class="settings-label">
				<T es="Tamaño de texto" en="Text size" />
			</span>

			<div class="fontsize-switch">
				<button type="button" class="theme-btn" data-fontsize-choice="small">
					<T es="A Pequeño" en="A Small" />
				</button>
				<button type="button" class="theme-btn" data-fontsize-choice="normal">
					<T es="A Normal" />
				</button>
				<button type="button" class="theme-btn" data-fontsize-choice="large">
					<T es="A Grande" en="A Large" />
				</button>
			</div>
		</div>

		<div class="settings-section">
			<span class="settings-label">
				<T es="Movimiento reducido" en="Reduced motion" />
			</span>

			<div class="theme-switch">
				<button type="button" class="theme-btn" data-motion-choice="false">
					<T es="▶️ Activado" en="▶️ On" />
				</button>
				<button type="button" class="theme-btn" data-motion-choice="true">
					<T es="⏸️ Reducido" en="⏸️ Reduced" />
				</button>
			</div>
		</div>

	</div>

</div>

<script>
	const wrapper = document.querySelector(".settings");
	const toggle = wrapper?.querySelector<HTMLButtonElement>(".settings-toggle");
	const panel = wrapper?.querySelector<HTMLElement>(".settings-panel");

	const closePanel = () => {
		panel?.classList.remove("open");
		toggle?.setAttribute("aria-expanded", "false");
	};

	toggle?.addEventListener("click", (e) => {
		e.stopPropagation();
		const isOpen = panel?.classList.toggle("open");
		toggle.setAttribute("aria-expanded", String(!!isOpen));
	});

	document.addEventListener("click", (e) => {
		if (wrapper && !wrapper.contains(e.target as Node)) closePanel();
	});

	document.addEventListener("keydown", (e) => {
		if (e.key === "Escape") closePanel();
	});

	const FIXED_THEMES = ["light", "dark", "amoled", "contrast"];

	const updateActiveStates = () => {
		let storedTheme: string | null = null;
		let storedFontSize: string | null = null;
		let storedMotion: string | null = null;
		let storedAccent: string | null = null;
		try {
			storedTheme = localStorage.getItem("sd-theme");
			storedFontSize = localStorage.getItem("sd-fontsize");
			storedMotion = localStorage.getItem("sd-reduced-motion");
			storedAccent = localStorage.getItem("sd-accent");
		} catch (err) {}

		const activeTheme = FIXED_THEMES.includes(storedTheme ?? "")
			? storedTheme
			: "system";

		const activeFontSize = storedFontSize || "normal";
		const activeMotion = storedMotion === "true" ? "true" : "false";

		// The light theme darkens the default accent for contrast, so the
		// computed --primary no longer matches the blue swatch; fall back to
		// the default swatch when nothing has been chosen yet.
		const accent = (storedAccent || "#0A84FF").trim();

		wrapper?.querySelectorAll<HTMLButtonElement>("[data-theme-choice]").forEach((btn) => {
			btn.classList.toggle("active", btn.dataset.themeChoice === activeTheme);
		});

		wrapper?.querySelectorAll<HTMLButtonElement>("[data-fontsize-choice]").forEach((btn) => {
			btn.classList.toggle("active", btn.dataset.fontsizeChoice === activeFontSize);
		});

		wrapper?.querySelectorAll<HTMLButtonElement>("[data-motion-choice]").forEach((btn) => {
			btn.classList.toggle("active", btn.dataset.motionChoice === activeMotion);
		});

		wrapper?.querySelectorAll<HTMLButtonElement>(".swatch").forEach((btn) => {
			const isActive =
				btn.dataset.accent?.toLowerCase() === accent.toLowerCase();
			btn.classList.toggle("active", isActive);
		});
	};

	wrapper?.querySelectorAll<HTMLButtonElement>("[data-theme-choice]").forEach((btn) => {
		btn.addEventListener("click", () => {
			const theme = btn.dataset.themeChoice as string;
			try {
				localStorage.setItem("sd-theme", theme);
			} catch (err) {}
			(window as any).__sdApplyTheme?.();
			updateActiveStates();
		});
	});

	wrapper?.querySelectorAll<HTMLButtonElement>(".swatch").forEach((btn) => {
		btn.addEventListener("click", () => {
			const accent = btn.dataset.accent as string;
			document.documentElement.style.setProperty("--primary", accent);
			try {
				localStorage.setItem("sd-accent", accent);
			} catch (err) {}
			updateActiveStates();
		});
	});

	wrapper?.querySelectorAll<HTMLButtonElement>("[data-fontsize-choice]").forEach((btn) => {
		btn.addEventListener("click", () => {
			const size = btn.dataset.fontsizeChoice as string;
			try {
				localStorage.setItem("sd-fontsize", size);
			} catch (err) {}
			(window as any).__sdApplyFontSize?.();
			updateActiveStates();
		});
	});

	wrapper?.querySelectorAll<HTMLButtonElement>("[data-motion-choice]").forEach((btn) => {
		btn.addEventListener("click", () => {
			const reduced = btn.dataset.motionChoice as string;
			try {
				localStorage.setItem("sd-reduced-motion", reduced);
			} catch (err) {}
			// Scroll-reveal/counters are wired up once at load based on
			// this value, so a reload is the simplest way to apply it
			// consistently everywhere.
			location.reload();
		});
	});

	updateActiveStates();
</script>

<style>

.settings {
	position: relative;
}

.settings-toggle {
	display: grid;
	place-items: center;

	width: 42px;
	height: 42px;

	color: var(--text-muted);

	background: var(--surface-2);
	border: 1px solid var(--border-2);
	border-radius: var(--radius-xs);

	cursor: pointer;

	transition:
		color var(--transition),
		border-color var(--transition),
		background var(--transition);
}

.settings-toggle svg {
	transition: transform .5s cubic-bezier(.2, .8, .2, 1);
}

.settings-toggle:hover,
.settings-toggle[aria-expanded="true"] {
	color: var(--primary-light);
	border-color: var(--primary-border);
	background: var(--primary-bg);
}

.settings-toggle:hover svg,
.settings-toggle[aria-expanded="true"] svg {
	transform: rotate(90deg);
}

.settings-panel {
	position: absolute;
	top: calc(100% + 12px);
	right: 0;
	z-index: 60;

	display: flex;
	flex-direction: column;
	gap: 18px;

	width: min(320px, calc(100vw - 32px));
	padding: 16px;

	background: var(--bg-elevated);
	border: 1px solid var(--border-2);
	border-radius: var(--radius-sm);
	box-shadow: 0 24px 60px var(--shadow-color);

	opacity: 0;
	visibility: hidden;
	transform: translateY(-6px);

	transition:
		opacity .2s ease,
		transform .2s ease,
		visibility .2s;
}

.settings-panel.open {
	opacity: 1;
	visibility: visible;
	transform: none;
}

.panel-head {
	display: flex;
	justify-content: space-between;
	align-items: center;

	padding-bottom: 12px;

	font-family: var(--font-pixel);
	font-size: .8rem;
	letter-spacing: .06em;
	text-transform: uppercase;
	color: var(--text);

	border-bottom: 1px dashed var(--border-2);
}

.panel-code {
	color: var(--text-dim);
	font-size: .68rem;
}

.settings-section {
	display: flex;
	flex-direction: column;
	gap: 10px;
}

.settings-label {
	font-family: var(--font-pixel);
	font-size: .7rem;
	letter-spacing: .06em;
	text-transform: uppercase;
	color: var(--text-dim);
}

.theme-switch,
.fontsize-switch {
	display: flex;
	flex-wrap: wrap;
	gap: 6px;
}

.theme-btn {
	flex: 1 1 auto;

	padding: 8px 10px;

	font-family: var(--font-main);
	font-size: .82rem;
	color: var(--text-muted);

	background: var(--surface-1);
	border: 1px solid var(--border-1);
	border-radius: var(--radius-xs);

	cursor: pointer;

	transition:
		color var(--transition),
		border-color var(--transition),
		background var(--transition);
}

.theme-btn:hover {
	color: var(--text);
	border-color: var(--border-3);
}

.theme-btn.active {
	color: var(--text);
	background: var(--primary-bg);
	border-color: var(--primary);
	box-shadow: inset 0 -2px 0 var(--primary);
}

.swatches {
	display: flex;
	gap: 8px;
}

.swatch {
	width: 32px;
	height: 32px;

	background: var(--swatch-color);
	border: 2px solid transparent;
	border-radius: 2px;
	box-shadow:
		inset 0 2px 0 rgba(255, 255, 255, .25),
		inset 0 -3px 0 rgba(0, 0, 0, .3);

	cursor: pointer;

	transition: transform var(--transition);
}

.swatch:hover {
	transform: translateY(-2px);
}

.swatch.active {
	border-color: var(--text);
	outline: 2px solid var(--swatch-color);
	outline-offset: 2px;
}

</style>
