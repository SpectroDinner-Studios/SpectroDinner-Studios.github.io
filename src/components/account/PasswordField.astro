---
import T from "../T.astro";

// A password input with a show/hide button (wired by wirePasswordToggles in
// src/scripts/account.ts) and, for new passwords, a strength meter.
interface Props {
	id: string;
	name: string;
	label: { es: string; en: string };
	autocomplete: "current-password" | "new-password";
	meter?: boolean;
	hint?: { es: string; en: string };
}

const { id, name, label, autocomplete, meter = false, hint } = Astro.props;
---

<label class="acc-field" for={id}>
	<T es={label.es} en={label.en} />
	<span class="acc-input">
		<input
			id={id}
			name={name}
			type="password"
			autocomplete={autocomplete}
			minlength={autocomplete === "new-password" ? 8 : undefined}
			maxlength="200"
			required
		/>
		<button type="button" class="acc-eye" data-toggle-password={id} aria-pressed="false" aria-label="Mostrar contraseña / Show password">
			<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" />
				<circle cx="12" cy="12" r="3" />
			</svg>
		</button>
	</span>
	{meter && (
		<span class="acc-meter" data-meter-for={id} data-level="0" aria-hidden="true">
			<span></span><span></span><span></span><span></span>
		</span>
	)}
	{hint && <small><T es={hint.es} en={hint.en} /></small>}
</label>
