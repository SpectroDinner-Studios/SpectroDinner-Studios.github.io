---
import T from "../T.astro";
import SectionHeader from "../SectionHeader.astro";

const areas = [
	{
		icon: "💻",
		title: { es: "Ingeniería de software", en: "Software Engineering" },
		text: {
			es: "Aplicaciones, herramientas y sistemas modernos, diseñados pensando en escalabilidad, mantenibilidad y rendimiento.",
			en: "Modern applications, tools and systems designed with scalability, maintainability and performance in mind.",
		},
		tags: [{ es: "Java" }, { es: "TypeScript" }, { es: "Python" }],
	},
	{
		icon: "🎮",
		title: { es: "Desarrollo de videojuegos", en: "Game Development" },
		text: {
			es: "Mundos y experiencias interactivas que combinan tecnología, jugabilidad y diseño creativo.",
			en: "Interactive worlds and experiences that combine technology, gameplay and creative design.",
		},
		tags: [{ es: "Unity" }, { es: "Unreal Engine" }, { es: "Roblox" }],
	},
	{
		icon: "⛏️",
		title: { es: "Desarrollo de Minecraft", en: "Minecraft Development" },
		text: {
			es: "Experiencias, plugins y sistemas de juego a medida para Minecraft, con tecnologías de servidor potentes.",
			en: "Custom Minecraft experiences, plugins and gameplay systems built with powerful server-side technologies.",
		},
		tags: [{ es: "Paper API" }, { es: "Java" }, { es: "Bukkit" }],
	},
	{
		icon: "🧪",
		title: { es: "Tecnología experimental", en: "Experimental Technology" },
		text: {
			es: "Prototipado y pruebas de nuevas ideas, mecánicas y enfoques técnicos antes de convertirse en proyectos concretos.",
			en: "Prototyping and testing new ideas, mechanics and technical approaches before they become concrete projects.",
		},
		tags: [{ es: "Prototipos", en: "Prototypes" }, { es: "Investigación", en: "R&D" }],
	},
];
---

<section class="section">

	<div class="container">

		<SectionHeader
			index="02"
			eyebrow={{ es: "Áreas de desarrollo", en: "Areas of development" }}
			title={{ es: "Lo que desarrollamos.", en: "What we develop." }}
		>
			<T
				es="SpectroDinner Studios trabaja en software, juegos, desarrollo de Minecraft y tecnología experimental, con el rendimiento y la fiabilidad a largo plazo como prioridad."
				en="SpectroDinner Studios works across software, games, Minecraft development and experimental technology, with performance and long-term reliability as a priority."
			/>
		</SectionHeader>

		<div class="grid">

			{areas.map((area, i) => (
				<article class="hud-card interactive reveal" style={`--reveal-delay:${i * 70}ms`}>

					<div class="top">
						<span class="icon-tile">{area.icon}</span>
						<span class="code">0{i + 1}</span>
					</div>

					<h3><T {...area.title} /></h3>

					<p><T {...area.text} /></p>

					<div class="chips">
						{area.tags.map((tag) => (
							<span class="chip"><T {...tag} /></span>
						))}
					</div>

				</article>
			))}

		</div>

	</div>

</section>

<style>

.grid {
	display: grid;
	grid-template-columns: repeat(4, 1fr);
	gap: 18px;
}

.hud-card {
	display: flex;
	flex-direction: column;
	gap: 16px;
}

.top {
	display: flex;
	justify-content: space-between;
	align-items: flex-start;
}

.code {
	font-family: var(--font-pixel);
	font-size: 1.4rem;
	color: var(--border-3);
	line-height: 1;
}

h3 {
	font-size: 1.3rem;
	font-weight: 600;
}

p {
	flex-grow: 1;
	color: var(--text-muted);
	font-size: .95rem;
	line-height: 1.7;
}

@media (max-width: 1080px) {

	.grid {
		grid-template-columns: repeat(2, 1fr);
	}
}

@media (max-width: 600px) {

	.grid {
		grid-template-columns: 1fr;
	}
}

</style>
