---
import T from "../T.astro";
import SectionHeader from "../SectionHeader.astro";

// Rendered as a config file — key / value pairs, value colored by type.
const config = [
	{ key: { es: "nombre", en: "name" }, value: { es: '"SpectroDinner Studios"' }, type: "string" },
	{ key: { es: "tipo", en: "type" }, value: { es: '"independiente"', en: '"independent"' }, type: "string" },
	{ key: { es: "fundado", en: "founded" }, value: { es: "2024" }, type: "number" },
	{ key: { es: "areas", en: "areas" }, value: { es: "[software, juegos, minecraft, experimental]", en: "[software, games, minecraft, experimental]" }, type: "list" },
	{ key: { es: "principios", en: "principles" }, value: { es: "[arquitectura_limpia, rendimiento, mantenibilidad]", en: "[clean_architecture, performance, maintainability]" }, type: "list" },
	{ key: { es: "servicio_discord", en: "discord_service" }, value: { es: "true" }, type: "bool" },
];
---

<section class="section" id="estudio">

	<div class="container split">

		<div>

			<SectionHeader
				index="01"
				eyebrow={{ es: "Sobre nosotros", en: "About us" }}
				title={{ es: "¿Qué es SpectroDinner Studios?", en: "What is SpectroDinner Studios?" }}
			/>

			<div class="body reveal">
				<p>
					<T
						es="SpectroDinner Studios es un estudio de desarrollo independiente. No somos una gran corporación — somos un equipo pequeño que construye software, videojuegos y proyectos de Minecraft, y explora tecnología experimental por el camino."
						en="SpectroDinner Studios is an independent development studio. We're not a large corporation — we're a small team building software, games and Minecraft projects, while exploring experimental technology along the way."
					/>
				</p>
				<p>
					<T
						es="Cada proyecto sigue los mismos principios: arquitectura limpia, rendimiento y mantenibilidad a largo plazo."
						en="Every project follows the same principles: clean architecture, performance and long-term maintainability."
					/>
				</p>
				<a href="/about" class="btn btn-ghost btn-sm">
					<T es="Conócenos" en="Meet the studio" /> →
				</a>
			</div>

		</div>

		<div class="terminal reveal" aria-hidden="true">

			<div class="terminal-bar">
				<i></i><i></i><i></i>
				<span>~/spectrodinner/<T es="estudio" en="studio" />.cfg</span>
			</div>

			<div class="terminal-body">
				<p><span class="prompt">&gt;</span> cat <T es="estudio" en="studio" />.cfg</p>
				{config.map((row) => (
					<p class="row">
						<span class="key"><T {...row.key} /></span>
						<span class="eq">=</span>
						<span class={`val ${row.type}`}><T {...row.value} /></span>
					</p>
				))}
				<p><span class="prompt">&gt;</span> <span class="cursor"></span></p>
			</div>

		</div>

	</div>

</section>

<style>

.split {
	display: grid;
	grid-template-columns: 1fr 1fr;
	align-items: center;
	gap: 64px;
}

.split :global(.section-header) {
	margin-bottom: 28px;
}

.body {
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	gap: 18px;

	color: var(--text-muted);
	font-size: 1.05rem;
	line-height: 1.8;
}

.body .btn {
	margin-top: 8px;
}

.terminal {
	box-shadow: 0 30px 80px -30px var(--primary-glow);
}

.row {
	display: grid;
	grid-template-columns: 9.5em auto 1fr;
	gap: 10px;
}

.key {
	color: var(--primary-light);
}

.eq {
	color: var(--text-dim);
}

.val.string {
	color: var(--emerald);
}

.val.number,
.val.bool {
	color: var(--gold-text);
}

.val.list {
	color: var(--text);
}

@media (max-width: 960px) {

	.split {
		grid-template-columns: 1fr;
		gap: 40px;
	}
}

@media (max-width: 560px) {

	.terminal-body {
		font-size: .82rem;
	}

	.row {
		grid-template-columns: 1fr;
		gap: 0;
		margin-bottom: 6px;
	}

	.eq {
		display: none;
	}
}

</style>
