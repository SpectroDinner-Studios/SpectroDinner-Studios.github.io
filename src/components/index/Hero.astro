---
import T from "../T.astro";

// Floating "pixel particles" around the emblem: [x%, y%, size px, delay s]
const particles: [number, number, number, number][] = [
	[8, 18, 10, 0],
	[88, 12, 8, 1.2],
	[94, 58, 12, 2.1],
	[4, 72, 8, 0.6],
	[74, 92, 10, 1.6],
	[22, 94, 6, 2.6],
	[60, 4, 6, 0.9],
];
---

<section class="hero">

	<div class="container hero-grid">

		<div class="copy">

			<div class="status chip">
				<span class="status-dot" aria-hidden="true"></span>
				<T es="Estudio independiente · Est. 2024" en="Independent studio · Est. 2024" />
			</div>

			<h1 class="display">
				Spectro<span class="grad-text">Dinner</span><sup>™</sup>
			</h1>

			<p class="terminal-line mono" aria-hidden="true">
				<span class="prompt">&gt;</span>
				<T
					es="software · juegos · minecraft · tecnología experimental"
					en="software · games · minecraft · experimental tech"
				/><span class="cursor"></span>
			</p>

			<p class="sr-only">
				<T
					es="Software · Juegos · Minecraft · Tecnología Experimental"
					en="Software · Games · Minecraft · Experimental Technology"
				/>
			</p>

			<p class="lead">
				<T
					es="SpectroDinner Studios diseña y construye software, videojuegos y proyectos de Minecraft, además de explorar tecnología experimental. También ofrecemos un servicio gratuito de configuración de servidores de Discord."
					en="SpectroDinner Studios designs and builds software, games and Minecraft projects, while also exploring experimental technology. We also offer a free Discord server setup service."
				/>
			</p>

			<div class="actions">
				<a href="/projects" class="btn btn-primary">
					<T es="Explorar proyectos" en="Explore projects" /> →
				</a>
				<a href="#servicios" class="btn btn-ghost">
					<T es="Trabaja con nosotros" en="Work with us" />
				</a>
			</div>

			<dl class="hud-stats">
				<div>
					<dt><T es="Áreas" en="Areas" /></dt>
					<dd>04</dd>
				</div>
				<div>
					<dt><T es="Código" en="Code" /></dt>
					<dd><T es="Abierto" en="Open" /></dd>
				</div>
				<div>
					<dt><T es="Fundación" en="Founded" /></dt>
					<dd>2024</dd>
				</div>
			</dl>

		</div>

		<div class="emblem" aria-hidden="true">

			<svg class="rings" viewBox="0 0 400 400">
				<circle class="ring ring-outer" cx="200" cy="200" r="190" />
				<circle class="ring ring-mid" cx="200" cy="200" r="158" />
				<circle class="ring ring-inner" cx="200" cy="200" r="128" />
				<g class="ticks">
					<rect x="198" y="2" width="4" height="18" />
					<rect x="198" y="380" width="4" height="18" />
					<rect x="2" y="198" width="18" height="4" />
					<rect x="380" y="198" width="18" height="4" />
				</g>
			</svg>

			<div class="core">
				<img src="/logo.png" alt="" width="220" height="220" />
			</div>

			<span class="label label-tl">SD//01</span>
			<span class="label label-br">SYS.ONLINE</span>

			<i class="bracket b-tl"></i>
			<i class="bracket b-tr"></i>
			<i class="bracket b-bl"></i>
			<i class="bracket b-br"></i>

			{particles.map(([x, y, size, delay]) => (
				<i
					class="particle"
					style={`left:${x}%;top:${y}%;width:${size}px;height:${size}px;animation-delay:${delay}s`}
				></i>
			))}

		</div>

	</div>

	<a href="#estudio" class="scroll-cue" aria-label="Scroll">
		<span>SCROLL</span>
		<span class="arrow">▼</span>
	</a>

</section>

<style>

.hero {
	position: relative;

	display: flex;
	flex-direction: column;
	justify-content: center;

	min-height: 100svh;
	padding: calc(var(--header-h) + 48px) 0 96px;
}

.hero-grid {
	display: grid;
	grid-template-columns: 1.15fr 1fr;
	align-items: center;
	gap: 56px;
}


/* Copy */

.copy {
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	gap: 26px;
}

.status {
	gap: 10px;
	padding: 7px 12px;
	color: var(--text-muted);
}

.display sup {
	font-size: .32em;
	vertical-align: super;
	color: var(--text-dim);
	-webkit-text-fill-color: var(--text-dim);
}

.terminal-line {
	font-size: clamp(.92rem, 1.4vw, 1.05rem);
	line-height: 1.6;
	color: var(--text-muted);
}

.terminal-line .prompt {
	margin-right: 10px;
	color: var(--primary-light);
	font-weight: 700;
}

.lead {
	max-width: 600px;
}

.hud-stats {
	display: flex;
	flex-wrap: wrap;
	gap: 12px;

	margin: 8px 0 0;
}

.hud-stats div {
	display: flex;
	flex-direction: column;
	gap: 6px;

	min-width: 112px;
	padding: 12px 16px;

	background: var(--surface-1);
	border: 1px solid var(--border-1);
	border-left: 3px solid var(--primary);
	border-radius: var(--radius-xs);
}

.hud-stats dt {
	font-family: var(--font-pixel);
	font-size: .68rem;
	letter-spacing: .06em;
	text-transform: uppercase;
	color: var(--text-dim);
}

.hud-stats dd {
	margin: 0;
	font-family: var(--font-display);
	font-size: 1.45rem;
	font-weight: 700;
	line-height: 1;
}


/* Emblem */

.emblem {
	position: relative;
	aspect-ratio: 1;
	width: 100%;
	max-width: 480px;
	justify-self: center;
}

.rings {
	position: absolute;
	inset: 0;
	width: 100%;
	height: 100%;
	overflow: visible;
}

.ring {
	fill: none;
	transform-origin: 200px 200px;
}

.ring-outer {
	stroke: var(--border-2);
	stroke-width: 1.5;
	stroke-dasharray: 2 10;
	animation: spin 60s linear infinite;
}

.ring-mid {
	stroke: var(--primary);
	stroke-width: 3;
	stroke-dasharray: 120 40 20 40;
	opacity: .75;
	animation: spin 24s linear infinite reverse;
}

.ring-inner {
	stroke: var(--primary-2);
	stroke-width: 1.5;
	stroke-dasharray: 6 6;
	opacity: .6;
	animation: spin 40s linear infinite;
}

.ticks rect {
	fill: var(--primary-light);
	opacity: .8;
}

@keyframes spin {
	to { transform: rotate(360deg); }
}

.core {
	position: absolute;
	inset: 22%;

	display: grid;
	place-items: center;

	border-radius: 50%;
	background: radial-gradient(circle, color-mix(in srgb, var(--primary) 22%, transparent), transparent 70%);
}

.core img {
	width: 100%;
	height: auto;
	filter: drop-shadow(0 0 28px var(--primary-glow));
	animation: hover 6s ease-in-out infinite;
}

@keyframes hover {
	0%, 100% { transform: translateY(0); }
	50% { transform: translateY(-10px); }
}

.label {
	position: absolute;

	padding: 4px 8px;

	font-family: var(--font-pixel);
	font-size: .66rem;
	letter-spacing: .06em;
	color: var(--text-dim);

	background: var(--bg-elevated);
	border: 1px solid var(--border-1);
}

.label-tl {
	top: 6%;
	left: 0;
}

.label-br {
	right: 0;
	bottom: 8%;
	color: var(--emerald);
}

.bracket {
	position: absolute;
	width: 26px;
	height: 26px;
	border: 2px solid var(--primary);
	opacity: .7;
}

.b-tl { top: 0; left: 0; border-right: 0; border-bottom: 0; }
.b-tr { top: 0; right: 0; border-left: 0; border-bottom: 0; }
.b-bl { bottom: 0; left: 0; border-right: 0; border-top: 0; }
.b-br { bottom: 0; right: 0; border-left: 0; border-top: 0; }

.particle {
	position: absolute;
	background: var(--primary);
	box-shadow: 0 0 10px var(--primary-glow);
	opacity: .8;
	animation: float 7s ease-in-out infinite;
}

.particle:nth-of-type(3n) {
	background: var(--gold);
	box-shadow: 0 0 10px color-mix(in srgb, var(--gold) 60%, transparent);
}

.particle:nth-of-type(3n + 1) {
	background: var(--primary-2);
}

@keyframes float {
	0%, 100% { transform: translateY(0) rotate(0deg); opacity: .8; }
	50% { transform: translateY(-18px) rotate(45deg); opacity: .4; }
}


/* Scroll cue */

.scroll-cue {
	position: absolute;
	left: 50%;
	bottom: 28px;
	transform: translateX(-50%);

	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 6px;

	font-family: var(--font-pixel);
	font-size: .66rem;
	letter-spacing: .12em;
	text-decoration: none;
	color: var(--text-dim);
}

.scroll-cue .arrow {
	color: var(--primary-light);
	animation: bob 1.6s steps(2, jump-none) infinite;
}

@keyframes bob {
	50% { transform: translateY(4px); }
}


@media (max-width: 960px) {

	.hero {
		min-height: auto;
	}

	.hero-grid {
		grid-template-columns: 1fr;
		gap: 40px;
	}

	.emblem {
		order: -1;
		max-width: 300px;
	}

	.scroll-cue {
		display: none;
	}
}

</style>
