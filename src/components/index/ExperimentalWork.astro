---
import T from "../T.astro";

const slots = Array.from({ length: 8 });
---

<section class="section-sm">

	<div class="container">

		<div class="hud-card lab reveal">

			<div class="copy">

				<span class="eyebrow">
					<span class="idx">04 //</span>
					<T es="Tecnología experimental" en="Experimental technology" />
				</span>

				<h2 class="title">
					<T es="Experimentos y prototipos" en="Experiments & prototypes" />
				</h2>

				<p>
					<T
						es="Además de nuestros proyectos principales, SpectroDinner Studios dedica tiempo a probar nuevas ideas, mecánicas y tecnologías. No todo experimento se convierte en un proyecto público — esta sección se irá completando a medida que ese trabajo alcance un estado presentable."
						en="Alongside our main projects, SpectroDinner Studios spends time testing new ideas, mechanics and technologies. Not every experiment becomes a public project — this section will grow as that work reaches a presentable state."
					/>
				</p>

			</div>

			<div class="inventory" aria-hidden="true">

				<div class="inventory-head">
					<span>LAB.INV</span>
					<span>0 / {slots.length}</span>
				</div>

				<div class="slots">
					{slots.map(() => <span class="slot">?</span>)}
				</div>

				<span class="inventory-foot">
					<T es="Ranuras bloqueadas — próximamente" en="Locked slots — coming soon" />
				</span>

			</div>

		</div>

	</div>

</section>

<style>

.lab {
	display: grid;
	grid-template-columns: 1.3fr 1fr;
	align-items: center;
	gap: 48px;

	padding: 44px;
}

.copy {
	display: flex;
	flex-direction: column;
	gap: 18px;
}

.copy p {
	color: var(--text-muted);
	line-height: 1.8;
}

.inventory {
	display: flex;
	flex-direction: column;
	gap: 12px;

	padding: 16px;

	background: var(--bg-sunken);
	border: 1px solid var(--border-2);
	border-radius: var(--radius-xs);
}

.inventory-head,
.inventory-foot {
	display: flex;
	justify-content: space-between;

	font-family: var(--font-pixel);
	font-size: .68rem;
	letter-spacing: .06em;
	text-transform: uppercase;
	color: var(--text-dim);
}

.slots {
	display: grid;
	grid-template-columns: repeat(4, 1fr);
	gap: 6px;
}

.slot {
	display: grid;
	place-items: center;

	aspect-ratio: 1;

	font-family: var(--font-pixel);
	font-size: 1.3rem;
	color: var(--border-3);

	background: var(--surface-1);
	border: 2px solid var(--border-1);
	box-shadow:
		inset 2px 2px 0 rgba(0, 0, 0, .35),
		inset -2px -2px 0 rgba(255, 255, 255, .04);

	animation: slotPulse 3.2s ease-in-out infinite;
}

.slot:nth-child(2n) {
	animation-delay: .4s;
}

.slot:nth-child(3n) {
	animation-delay: .9s;
}

@keyframes slotPulse {
	0%, 100% { color: var(--border-3); }
	50% { color: var(--primary-light); }
}

@media (max-width: 900px) {

	.lab {
		grid-template-columns: 1fr;
		padding: 28px;
	}
}

</style>
