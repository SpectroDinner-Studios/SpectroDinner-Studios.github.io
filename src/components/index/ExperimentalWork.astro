---
import T from "../T.astro";

const slots = Array.from({ length: 8 });
---

<section class="section-sm">

	<div class="container">

		<div class="hud-card lab reveal">

			<div class="copy">

				<span class="eyebrow">
					<span class="idx">04 //</span>
					<T es="Tecnología experimental" en="Experimental technology" />
				</span>

				<h2 class="title">
					<T es="Experimentos y prototipos" en="Experiments & prototypes" />
				</h2>

				<p>
					<T
						es="Además de nuestros proyectos principales, SpectroDinner Studios dedica tiempo a probar nuevas ideas, mecánicas y tecnologías. En el LAB esperan 8 juegos experimentales: se desbloquean de uno en uno invitando a tus amigos."
						en="Alongside our main projects, SpectroDinner Studios spends time testing new ideas, mechanics and technologies. 8 experimental games are waiting in the LAB: they unlock one at a time by inviting your friends."
					/>
				</p>

				<a href="/juegos/" class="btn btn-primary btn-sm lab-cta" data-lab-link>
					🎮 <T es="Desbloquear juegos" en="Unlock games" /> →
				</a>

			</div>

			<div class="inventory" aria-hidden="true">

				<div class="inventory-head">
					<span>LAB.INV</span>
					<span data-lab-count>0 / {slots.length}</span>
				</div>

				<div class="slots" data-lab-slots>
					{slots.map(() => <span class="slot">?</span>)}
				</div>

				<span class="inventory-foot">
					<T es="Invita a 3 amigos por juego" en="Invite 3 friends per game" />
				</span>

			</div>

		</div>

	</div>

</section>

<script>
	import { apiUrl } from "../../scripts/api";
	import { ACCOUNT_ORIGIN } from "../../scripts/account";

	// Show this visitor's real progress in the inventory: unlocked games with
	// their icon, the one being unlocked highlighted.
	const slotsBox = document.querySelector<HTMLElement>("[data-lab-slots]");
	const count = document.querySelector<HTMLElement>("[data-lab-count]");
	const link = document.querySelector<HTMLAnchorElement>("[data-lab-link]");

	if (link && location.hostname.endsWith(".github.io")) link.href = ACCOUNT_ORIGIN + "/juegos/";

	type Game = { slot: number; state: string; icon: string };

	fetch(apiUrl("/api/games"), { credentials: "same-origin", cache: "no-store" })
		.then((res) => (res.ok ? res.json() : null))
		.then((data: { games: Game[]; me: { unlocked: number } | null } | null) => {
			if (!data || !slotsBox || !count) return;
			count.textContent = `${data.me?.unlocked ?? 0} / ${data.games.length}`;
			slotsBox.querySelectorAll<HTMLElement>(".slot").forEach((slot, i) => {
				const game = data.games[i];
				if (!game) return;
				slot.classList.toggle("is-unlocked", game.state === "unlocked");
				slot.classList.toggle("is-current", game.state === "current");
				if (game.state === "unlocked") slot.textContent = game.icon || "🎮";
			});
		})
		.catch(() => {});
</script>

<style>

.lab {
	display: grid;
	grid-template-columns: 1.3fr 1fr;
	align-items: center;
	gap: 48px;

	padding: 44px;
}

.copy {
	display: flex;
	flex-direction: column;
	gap: 18px;
}

.copy p {
	color: var(--text-muted);
	line-height: 1.8;
}

.lab-cta {
	align-self: flex-start;
}

.inventory {
	display: flex;
	flex-direction: column;
	gap: 12px;

	padding: 16px;

	background: var(--bg-sunken);
	border: 1px solid var(--border-2);
	border-radius: var(--radius-xs);
}

.inventory-head,
.inventory-foot {
	display: flex;
	justify-content: space-between;

	font-family: var(--font-pixel);
	font-size: .68rem;
	letter-spacing: .06em;
	text-transform: uppercase;
	color: var(--text-dim);
}

.slots {
	display: grid;
	grid-template-columns: repeat(4, 1fr);
	gap: 6px;
}

.slot {
	display: grid;
	place-items: center;

	aspect-ratio: 1;

	font-family: var(--font-pixel);
	font-size: 1.3rem;
	color: var(--border-3);

	background: var(--surface-1);
	border: 2px solid var(--border-1);
	box-shadow:
		inset 2px 2px 0 rgba(0, 0, 0, .35),
		inset -2px -2px 0 rgba(255, 255, 255, .04);

	animation: slotPulse 3.2s ease-in-out infinite;
}

.slot:nth-child(2n) {
	animation-delay: .4s;
}

.slot:nth-child(3n) {
	animation-delay: .9s;
}

.slot.is-unlocked {
	font-family: inherit;
	font-size: 1.6rem;
	background: color-mix(in srgb, var(--emerald) 14%, var(--surface-1));
	border-color: color-mix(in srgb, var(--emerald) 50%, transparent);
	animation: none;
}

.slot.is-current {
	border-color: var(--primary);
	box-shadow:
		inset 2px 2px 0 rgba(0, 0, 0, .35),
		0 0 14px var(--primary-glow);
}

@keyframes slotPulse {
	0%, 100% { color: var(--border-3); }
	50% { color: var(--primary-light); }
}

@media (max-width: 900px) {

	.lab {
		grid-template-columns: 1fr;
		padding: 28px;
	}
}

</style>
