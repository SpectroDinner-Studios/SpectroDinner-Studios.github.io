---
import "../../styles/forms.css";
import T from "../T.astro";
import SectionHeader from "../SectionHeader.astro";

/*
	Añade aquí las valoraciones reales de tus clientes.
	Ejemplo:

	{ name: "User123", rating: 5, service: "Creación de servidor", text: "Quedó genial, muy profesionales." }
*/
const reviews: {
	name: string;
	rating: number;
	service?: string;
	text: string;
}[] = [
	{
		name: "Eggchan00",
		rating: 5,
		service: "Helped redesign my discord and built it up",
		text: "He was the best person to do it it literally took him less than a day and you guys should try it too",
	},
	{
		name: "COR_braydzYT",
		rating: 5,
		service: "discord moderation",
		text: "hes so good and fast and kind",
	},
	{
		name: "IVN22",
		rating: 5,
		service: "Creación de bot personalizado, remodelación y moderación del servidor de Discord",
		text: "De lo mejor que puedes encontrar, muy rápido, perfecto",
	},
];

const count = reviews.length;

const average =
	count > 0
		? reviews.reduce((sum, r) => sum + r.rating, 0) / count
		: 0;

const stars = (rating: number) =>
	"★".repeat(rating) + "☆".repeat(5 - rating);
---

<section class="section" id="valoraciones">

	<div class="container">

		<SectionHeader
			index="05"
			eyebrow={{ es: "Valoraciones", en: "Reviews" }}
			title={{ es: "Lo que opinan nuestros clientes", en: "What our clients say" }}
		>
			<T
				es="Cada valoración es de un cliente real que ha usado nuestro servicio. Si ya trabajamos juntos, ¡nos encantaría leer tu opinión!"
				en="Every review comes from a real client who used our service. If we've already worked together, we'd love to hear your feedback!"
			/>
		</SectionHeader>

		{
			count > 0 ? (
				<>
					<div class="summary reveal">
						<strong class="score-number">{average.toFixed(1)}</strong>
						<div class="score-meta">
							<span class="score-stars" aria-hidden="true">{stars(Math.round(average))}</span>
							<span class="score-count">
								<span data-lang="es">basado en <b class="review-count">{count}</b> valoraciones</span>
								<span data-lang="en">based on <b class="review-count">{count}</b> reviews</span>
							</span>
						</div>
						<a href="#review-form" class="btn btn-ghost btn-sm">
							<T es="Deja la tuya" en="Leave yours" /> ↓
						</a>
					</div>

					{count > 3 ? (
						<div class="carousel reveal">
							<div class="carousel-track">
								{reviews.map((review) => (
									<article class="card hud-card gold" data-rating={review.rating}>
										<div class="author">
											<span class="avatar" aria-hidden="true">{review.name.charAt(0)}</span>
											<div>
												<strong>{review.name}</strong>
												{review.service && <span>{review.service}</span>}
											</div>
										</div>
										<span class="card-stars" aria-label={`${review.rating}/5`}>{stars(review.rating)}</span>
										<p class="text">"{review.text}"</p>
									</article>
								))}
							</div>

							<div class="carousel-dots">
								{reviews.map((_, i) => (
									<button
										type="button"
										class="dot"
										aria-label={`Review ${i + 1}`}
									/>
								))}
							</div>
						</div>
					) : (
						<div class="grid">
							{reviews.map((review, i) => (
								<article
									class="card hud-card gold interactive reveal"
									style={`--reveal-delay:${i * 80}ms`}
									data-rating={review.rating}
								>
									<div class="author">
										<span class="avatar" aria-hidden="true">{review.name.charAt(0)}</span>
										<div>
											<strong>{review.name}</strong>
											{review.service && <span>{review.service}</span>}
										</div>
									</div>
									<span class="card-stars" aria-label={`${review.rating}/5`}>{stars(review.rating)}</span>
									<p class="text">"{review.text}"</p>
								</article>
							))}
						</div>
					)}
				</>
			) : (
				<div class="empty hud-card reveal">
					<p>
						<T
							es="Todavía no tenemos valoraciones publicadas — ¡sé el primero en dejar la tuya!"
							en="We don't have any published reviews yet — be the first to leave one!"
						/>
					</p>
				</div>
			)
		}

		<!-- Card for reviews approved in /admin, filled in by the script below. -->
		<template id="review-template">
			<article class="card hud-card gold interactive">
				<div class="author">
					<span class="avatar" aria-hidden="true"></span>
					<div>
						<strong class="name"></strong>
						<span class="service"></span>
					</div>
				</div>
				<span class="card-stars"></span>
				<p class="text"></p>
			</article>
		</template>

		<div class="leave form-ui">

			<div class="leave-copy reveal">
				<span class="eyebrow"><T es="Tu turno" en="Your turn" /></span>
				<h3 class="title"><T es="¿Ya trabajamos juntos?" en="Have we worked together?" /></h3>
				<p>
					<T
						es="Cuéntanos qué tal fue. Revisamos cada valoración antes de publicarla aquí."
						en="Tell us how it went. We review every review before publishing it here."
					/>
				</p>
			</div>

			<div class="form-card reveal">

				<h3>
					<T es="Deja tu valoración" en="Leave your review" />
				</h3>

				<form id="review-form" novalidate>

					<div class="grid-fields">

						<label>
							<T es="Apodo *" en="Nickname *" />
							<input
								type="text"
								name="nombre"
								placeholder="Ej. Elmoderador / e.g. Elmoderador"
								autocomplete="username"
								maxlength="60"
								required
								aria-describedby="err-nombre"
							/>
							<span id="err-nombre" class="field-error" aria-live="polite"></span>
						</label>

						<label>
							<T es="Servicio recibido (opcional)" en="Service received (optional)" />
							<input
								type="text"
								name="servicio"
								placeholder="Ej. Creación de servidor"
								autocomplete="off"
								maxlength="120"
							/>
						</label>

					</div>

					<label>
						<T es="Valoración *" en="Rating *" />

						<select name="rating" required aria-describedby="err-rating">
							<option value="" disabled selected>-- </option>
							<option value="5">★★★★★ (5/5)</option>
							<option value="4">★★★★☆ (4/5)</option>
							<option value="3">★★★☆☆ (3/5)</option>
							<option value="2">★★☆☆☆ (2/5)</option>
							<option value="1">★☆☆☆☆ (1/5)</option>
						</select>
						<span id="err-rating" class="field-error" aria-live="polite"></span>
					</label>

					<label>
						<T es="Tu comentario *" en="Your comment *" />
						<textarea
							name="comentario"
							rows="4"
							maxlength="1000"
							required
							aria-describedby="err-comentario"
						></textarea>
						<span id="err-comentario" class="field-error" aria-live="polite"></span>
					</label>

					<div class="honeypot" aria-hidden="true">
						<label for="review-website">Website</label>
						<input
							type="text"
							id="review-website"
							name="website"
							tabindex="-1"
							autocomplete="off"
						/>
					</div>

					<p id="review-error-summary" class="status error" role="alert" hidden></p>

					<button type="submit" class="submit">
						<span class="submit-label">
							<T es="Enviar valoración →" en="Submit review →" />
						</span>
						<span class="submit-label submit-loading" hidden>
							<T es="Enviando…" en="Sending…" />
						</span>
					</button>

					<p class="hint">
						<T
							es="Tu valoración se envía directamente a nuestro equipo — la publicaremos en cuanto la revisemos. Nunca compartas contraseñas, claves de API ni otros datos secretos aquí."
							en="Your review is sent straight to our team — we'll publish it once we review it. Never share passwords, API keys or other secrets here."
						/>
					</p>

					<p id="review-status" class="status" hidden>
						<T es="✅ ¡Gracias! Hemos recibido tu valoración." en="✅ Thanks! We received your review." />
					</p>

					<p id="review-error" class="status error" hidden>
						<T
							es="⚠️ No hemos podido enviar tu valoración. Inténtalo de nuevo en unos segundos."
							en="⚠️ We couldn't send your review. Please try again in a moment."
						/>
					</p>

				</form>

			</div>

		</div>

	</div>

</section>

<script>
	import { submitForm } from "../../scripts/submit";

	const prefersReducedMotion = window.matchMedia(
		"(prefers-reduced-motion: reduce)"
	).matches;

	const track = document.querySelector<HTMLElement>(".carousel-track");

	if (track) {
		const cards = Array.from(track.querySelectorAll<HTMLElement>(".card"));
		const dots = document.querySelectorAll<HTMLButtonElement>(".carousel-dots .dot");

		if (dots.length) {
			dots.forEach((dot, i) => {
				dot.addEventListener("click", () => {
					cards[i]?.scrollIntoView({
						behavior: "smooth",
						inline: "start",
						block: "nearest",
					});
				});
			});

			const dotObserver = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) return;
						const index = cards.indexOf(entry.target as HTMLElement);
						dots.forEach((d, i) => d.classList.toggle("active", i === index));
					});
				},
				{ root: track, threshold: 0.6 }
			);

			cards.forEach((card) => dotObserver.observe(card));
		}

		if (!prefersReducedMotion && cards.length > 1) {
			let paused = false;

			track.addEventListener("mouseenter", () => (paused = true));
			track.addEventListener("mouseleave", () => (paused = false));

			setInterval(() => {
				if (paused) return;

				const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 5;

				if (atEnd) {
					track.scrollTo({ left: 0, behavior: "smooth" });
					return;
				}

				const next = cards.find((c) => c.offsetLeft > track.scrollLeft + 5);
				if (next) {
					track.scrollTo({ left: next.offsetLeft, behavior: "smooth" });
				}
			}, 3500);
		}
	}

	// Reviews approved from the admin panel. Only the Cloudflare copy of the
	// site has /api; anywhere else this quietly keeps the hard-coded reviews.
	const loadApprovedReviews = async () => {
		const container = document.querySelector<HTMLElement>(
			"#valoraciones .grid, #valoraciones .carousel-track"
		);
		const template = document.getElementById("review-template") as HTMLTemplateElement | null;
		if (!container || !template) return;

		let approved: { name: string; service: string; rating: number; text: string }[] = [];

		try {
			const res = await fetch("/api/reviews");
			if (!res.ok) return;
			approved = (await res.json()).reviews ?? [];
		} catch {
			return;
		}

		const starsFor = (rating: number) => "★".repeat(rating) + "☆".repeat(5 - rating);

		for (const review of approved) {
			const card = template.content.firstElementChild!.cloneNode(true) as HTMLElement;
			const rating = Math.min(5, Math.max(1, Math.round(review.rating)));

			card.dataset.rating = String(rating);
			card.querySelector(".avatar")!.textContent = review.name.charAt(0);
			card.querySelector(".name")!.textContent = review.name;

			const service = card.querySelector(".service")!;
			if (review.service) service.textContent = review.service;
			else service.remove();

			const cardStars = card.querySelector(".card-stars")!;
			cardStars.textContent = starsFor(rating);
			cardStars.setAttribute("aria-label", `${rating}/5`);

			card.querySelector(".text")!.textContent = `"${review.text}"`;

			container.append(card);
		}

		const ratings = Array.from(
			document.querySelectorAll<HTMLElement>("#valoraciones [data-rating]"),
			(card) => Number(card.dataset.rating)
		);
		if (!ratings.length) return;

		const average = ratings.reduce((sum, r) => sum + r, 0) / ratings.length;

		const scoreNumber = document.querySelector("#valoraciones .score-number");
		const scoreStars = document.querySelector("#valoraciones .score-stars");
		if (scoreNumber) scoreNumber.textContent = average.toFixed(1);
		if (scoreStars) scoreStars.textContent = starsFor(Math.round(average));
		document.querySelectorAll("#valoraciones .review-count").forEach((el) => {
			el.textContent = String(ratings.length);
		});
	};

	loadApprovedReviews();

	const form = document.getElementById("review-form") as HTMLFormElement | null;
	const status = document.getElementById("review-status");
	const error = document.getElementById("review-error");
	const errorSummary = document.getElementById("review-error-summary");
	const submitBtn = form?.querySelector<HTMLButtonElement>(".submit");
	const submitLabel = submitBtn?.querySelector(".submit-label:not(.submit-loading)");
	const submitLoading = submitBtn?.querySelector(".submit-loading");

	const messages = {
		es: { required: "Este campo es obligatorio.", choose: "Elige una valoración." },
		en: { required: "This field is required.", choose: "Please choose a rating." },
	};

	const currentLang = () => (document.documentElement.lang === "en" ? "en" : "es");

	const clearFieldError = (input: HTMLElement, errorId: string) => {
		input.removeAttribute("aria-invalid");
		const el = document.getElementById(errorId);
		if (el) el.textContent = "";
	};

	const setFieldError = (input: HTMLElement, errorId: string, text: string) => {
		input.setAttribute("aria-invalid", "true");
		const el = document.getElementById(errorId);
		if (el) el.textContent = text;
	};

	const validateForm = (): boolean => {
		if (!form) return false;

		let firstInvalid: HTMLElement | null = null;
		const lang = currentLang();

		const requiredFields = [
			{ name: "nombre", errorId: "err-nombre" },
			{ name: "rating", errorId: "err-rating", choose: true },
			{ name: "comentario", errorId: "err-comentario" },
		];

		for (const { name, errorId, choose } of requiredFields) {
			const input = form.elements.namedItem(name) as
				| HTMLInputElement
				| HTMLSelectElement
				| HTMLTextAreaElement
				| null;
			if (!input) continue;

			if (!input.value.trim()) {
				setFieldError(input, errorId, choose ? messages[lang].choose : messages[lang].required);
				firstInvalid ??= input;
			} else {
				clearFieldError(input, errorId);
			}
		}

		if (errorSummary) {
			if (firstInvalid) {
				errorSummary.textContent =
					lang === "es"
						? "Revisa los campos marcados en rojo antes de enviar."
						: "Please check the fields highlighted in red before submitting.";
				errorSummary.hidden = false;
			} else {
				errorSummary.hidden = true;
				errorSummary.textContent = "";
			}
		}

		firstInvalid?.focus();
		return !firstInvalid;
	};

	const COOLDOWN_MS = 8000;
	let cooling = false;

	const setSubmitting = (submitting: boolean) => {
		submitBtn?.toggleAttribute("disabled", submitting);
		submitLabel?.toggleAttribute("hidden", submitting);
		submitLoading?.toggleAttribute("hidden", !submitting);
	};

	form?.addEventListener("submit", async (e) => {
		e.preventDefault();
		if (cooling) return;

		status?.setAttribute("hidden", "");
		error?.setAttribute("hidden", "");

		const honeypot = form.elements.namedItem("website") as HTMLInputElement | null;
		if (honeypot?.value) {
			form.reset();
			status?.removeAttribute("hidden");
			return;
		}

		if (!validateForm()) return;

		const data = new FormData(form);
		const get = (name: string) => (data.get(name) || "").toString().trim();

		const payload = {
			form: "review",
			nickname: get("nombre"),
			service: get("servicio"),
			rating: Number(get("rating")),
			comment: get("comentario"),
		};

		setSubmitting(true);
		cooling = true;

		try {
			await submitForm(payload);

			form.reset();
			status?.removeAttribute("hidden");
		} catch (err) {
			error?.removeAttribute("hidden");
		} finally {
			setSubmitting(false);
			setTimeout(() => {
				cooling = false;
			}, COOLDOWN_MS);
		}
	});
</script>

<style>

/* Summary */

.summary {
	display: flex;
	flex-wrap: wrap;
	align-items: center;
	gap: 22px;

	margin-bottom: 26px;
	padding: 20px 24px;

	background: var(--gold-bg);
	border: 1px solid var(--gold-border);
	border-radius: var(--radius-sm);
}

.score-number {
	font-family: var(--font-display);
	font-size: 3rem;
	font-weight: 700;
	line-height: 1;
	color: var(--gold-text);
}

.score-meta {
	display: flex;
	flex-direction: column;
	gap: 4px;
	flex-grow: 1;
}

.score-stars,
.card-stars {
	color: var(--gold);
	letter-spacing: 3px;
	text-shadow: 0 0 12px color-mix(in srgb, var(--gold) 50%, transparent);
}

.score-stars {
	font-size: 1.5rem;
}

.score-count {
	font-family: var(--font-pixel);
	font-size: .72rem;
	letter-spacing: .05em;
	text-transform: uppercase;
	color: var(--text-muted);
}


/* Cards */

.grid {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 18px;
}

.card {
	display: flex;
	flex-direction: column;
	gap: 16px;
}

.author {
	display: flex;
	align-items: center;
	gap: 12px;
}

.avatar {
	display: grid;
	place-items: center;
	flex-shrink: 0;

	width: 44px;
	height: 44px;

	font-family: var(--font-pixel);
	font-size: 1.2rem;
	text-transform: uppercase;
	color: #1C1305;

	background: linear-gradient(135deg, #F8C552, #E39B1B);
	border-radius: var(--radius-xs);
	box-shadow:
		inset 0 2px 0 rgba(255, 255, 255, .3),
		inset 0 -3px 0 rgba(0, 0, 0, .25);
}

.author div {
	display: flex;
	flex-direction: column;
	gap: 2px;
	min-width: 0;
}

.author strong {
	font-family: var(--font-display);
	font-size: 1.05rem;
	font-weight: 600;
	overflow-wrap: anywhere;
}

.author div span {
	font-size: .82rem;
	line-height: 1.4;
	color: var(--text-dim);
}

.card-stars {
	font-size: 1.1rem;
}

.text {
	flex-grow: 1;
	font-size: 1rem;
	line-height: 1.7;
	color: var(--text);
}

.empty {
	text-align: center;
	color: var(--text-muted);
}


/* Carousel (4+ reviews) */

.carousel-track {
	display: flex;
	gap: 18px;

	overflow-x: auto;
	scroll-snap-type: x mandatory;
	scrollbar-width: none;

	padding: 4px 2px 8px;
}

.carousel-track::-webkit-scrollbar {
	display: none;
}

.carousel-track .card {
	flex: 0 0 calc((100% - 36px) / 3);
	scroll-snap-align: start;
}

.carousel-dots {
	display: flex;
	justify-content: center;
	gap: 8px;
	margin-top: 18px;
}

.dot {
	width: 10px;
	height: 10px;
	padding: 0;

	background: var(--border-2);
	border: 0;

	cursor: pointer;

	transition:
		background var(--transition),
		width var(--transition);
}

.dot.active {
	width: 26px;
	background: var(--gold);
}


/* Leave a review */

.leave {
	display: grid;
	grid-template-columns: .8fr 1.2fr;
	align-items: start;
	gap: 48px;

	margin-top: 72px;
}

.leave-copy {
	display: flex;
	flex-direction: column;
	gap: 16px;
	position: sticky;
	top: calc(var(--header-h) + 32px);
}

.leave-copy .title {
	font-size: clamp(1.8rem, 3.4vw, 2.6rem);
}

.leave-copy p {
	color: var(--text-muted);
	line-height: 1.8;
}

#review-form {
	display: flex;
	flex-direction: column;
	gap: 18px;
}


@media (max-width: 1000px) {

	.grid {
		grid-template-columns: 1fr 1fr;
	}

	.carousel-track .card {
		flex-basis: calc((100% - 18px) / 2);
	}

	.leave {
		grid-template-columns: 1fr;
		gap: 28px;
	}

	.leave-copy {
		position: static;
	}
}

@media (max-width: 640px) {

	.grid {
		grid-template-columns: 1fr;
	}

	.carousel-track .card {
		flex-basis: 88%;
	}
}

</style>
