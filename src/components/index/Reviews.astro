---
import "../../styles/forms.css";
import T from "../T.astro";
import SectionHeader from "../SectionHeader.astro";

// Every review lives in the database (including the ones that used to be
// written here by hand), so any of them can be hidden or deleted from /admin.
// The script below loads them from /api/reviews.
---

<section class="section" id="valoraciones">

	<div class="container">

		<SectionHeader
			index="05"
			eyebrow={{ es: "Valoraciones", en: "Reviews" }}
			title={{ es: "Lo que opinan nuestros clientes", en: "What our clients say" }}
		>
			<T
				es="Cada valoración es de un cliente real que ha usado nuestro servicio. Si ya trabajamos juntos, ¡nos encantaría leer tu opinión!"
				en="Every review comes from a real client who used our service. If we've already worked together, we'd love to hear your feedback!"
			/>
		</SectionHeader>

		<div class="summary" data-reviews-summary hidden>
			<strong class="score-number">–</strong>
			<div class="score-meta">
				<span class="score-stars" aria-hidden="true"></span>
				<span class="score-count">
					<span data-lang="es">basado en <b class="review-count">0</b> valoraciones</span>
					<span data-lang="en">based on <b class="review-count">0</b> reviews</span>
				</span>
			</div>
			<a href="#review-form" class="btn btn-ghost btn-sm">
				<T es="Deja la tuya" en="Leave yours" /> ↓
			</a>
		</div>

		<div class="grid is-collapsed" data-reviews aria-busy="true">
			<div class="card hud-card skeleton" aria-hidden="true"></div>
			<div class="card hud-card skeleton" aria-hidden="true"></div>
			<div class="card hud-card skeleton" aria-hidden="true"></div>
		</div>

		<div class="more" data-reviews-more-wrap hidden>
			<button type="button" class="btn btn-ghost btn-sm" data-reviews-more>
				<T es="Ver todas" en="See all" /> (<span data-reviews-total>0</span>) ↓
			</button>
		</div>

		<div class="empty hud-card" data-reviews-empty hidden>
			<p>
				<T
					es="Todavía no tenemos valoraciones publicadas — ¡sé el primero en dejar la tuya!"
					en="We don't have any published reviews yet — be the first to leave one!"
				/>
			</p>
		</div>

		<div class="empty hud-card" data-reviews-error hidden>
			<p>
				<T
					es="No hemos podido cargar las valoraciones ahora mismo. Vuelve a intentarlo en un rato."
					en="We couldn't load the reviews right now. Please try again in a while."
				/>
			</p>
		</div>

		<!-- One review card, filled in by the script below. -->
		<template id="review-template">
			<article class="card hud-card gold interactive">
				<div class="author">
					<span class="avatar" aria-hidden="true"></span>
					<div>
						<strong class="name"></strong>
						<span class="service"></span>
					</div>
				</div>
				<span class="card-stars"></span>
				<p class="text"></p>
			</article>
		</template>

		<div class="leave form-ui">

			<div class="leave-copy reveal">
				<span class="eyebrow"><T es="Tu turno" en="Your turn" /></span>
				<h3 class="title"><T es="¿Ya trabajamos juntos?" en="Have we worked together?" /></h3>
				<p data-when-instant>
					<T
						es="Cuéntanos qué tal fue. Tu valoración se publica aquí al momento."
						en="Tell us how it went. Your review goes live here right away."
					/>
				</p>
				<p data-when-moderated hidden>
					<T
						es="Cuéntanos qué tal fue. Revisamos cada valoración antes de publicarla aquí."
						en="Tell us how it went. We check every review before publishing it here."
					/>
				</p>
			</div>

			<div class="form-card reveal">

				<h3>
					<T es="Deja tu valoración" en="Leave your review" />
				</h3>

				<form id="review-form" novalidate>

					<div class="grid-fields">

						<label>
							<T es="Apodo *" en="Nickname *" />
							<input
								type="text"
								name="nombre"
								placeholder="Ej. Elmoderador / e.g. Elmoderador"
								autocomplete="username"
								maxlength="60"
								required
								aria-describedby="err-nombre"
							/>
							<span id="err-nombre" class="field-error" aria-live="polite"></span>
						</label>

						<label>
							<T es="Servicio recibido (opcional)" en="Service received (optional)" />
							<input
								type="text"
								name="servicio"
								placeholder="Ej. Creación de servidor"
								autocomplete="off"
								maxlength="120"
							/>
						</label>

					</div>

					<label>
						<T es="Valoración *" en="Rating *" />

						<select name="rating" required aria-describedby="err-rating">
							<option value="" disabled selected>-- </option>
							<option value="5">★★★★★ (5/5)</option>
							<option value="4">★★★★☆ (4/5)</option>
							<option value="3">★★★☆☆ (3/5)</option>
							<option value="2">★★☆☆☆ (2/5)</option>
							<option value="1">★☆☆☆☆ (1/5)</option>
						</select>
						<span id="err-rating" class="field-error" aria-live="polite"></span>
					</label>

					<label>
						<T es="Tu comentario *" en="Your comment *" />
						<textarea
							name="comentario"
							rows="4"
							maxlength="1000"
							required
							aria-describedby="err-comentario"
						></textarea>
						<span id="err-comentario" class="field-error" aria-live="polite"></span>
					</label>

					<div class="honeypot" aria-hidden="true">
						<label for="review-website">Website</label>
						<input
							type="text"
							id="review-website"
							name="website"
							tabindex="-1"
							autocomplete="off"
						/>
					</div>

					<p id="review-error-summary" class="status error" role="alert" hidden></p>

					<button type="submit" class="submit">
						<span class="submit-label">
							<T es="Enviar valoración →" en="Submit review →" />
						</span>
						<span class="submit-label submit-loading" hidden>
							<T es="Enviando…" en="Sending…" />
						</span>
					</button>

					<p class="hint">
						<span data-when-instant>
							<T
								es="Se publica al instante. Revisamos todas y eliminamos las que contengan insultos, spam o datos personales."
								en="It's published instantly. We check every review and remove any with insults, spam or personal data."
							/>
						</span>
						<span data-when-moderated hidden>
							<T
								es="La publicaremos en cuanto la revisemos. No publicamos las que contengan insultos, spam o datos personales."
								en="We'll publish it once we've checked it. Reviews with insults, spam or personal data aren't published."
							/>
						</span>
						<T
							es="Nunca compartas contraseñas, claves de API ni otros datos secretos aquí."
							en="Never share passwords, API keys or other secrets here."
						/>
					</p>

					<p id="review-status" class="status" hidden>
						<T es="✅ ¡Gracias! Tu valoración ya está publicada." en="✅ Thanks! Your review is now live." />
					</p>

					<p id="review-status-pending" class="status" hidden>
						<T es="✅ ¡Gracias! La publicaremos en cuanto la revisemos." en="✅ Thanks! We'll publish it once we've checked it." />
					</p>

					<p id="review-status-sent" class="status" hidden>
						<T es="✅ ¡Gracias! Hemos recibido tu valoración." en="✅ Thanks! We received your review." />
					</p>

					<p id="review-limit" class="status error" hidden>
						<T
							es="⚠️ Has enviado varias valoraciones seguidas. Inténtalo de nuevo más tarde."
							en="⚠️ You've sent several reviews in a row. Please try again later."
						/>
					</p>

					<p id="review-error" class="status error" hidden>
						<T
							es="⚠️ No hemos podido enviar tu valoración. Inténtalo de nuevo en unos segundos."
							en="⚠️ We couldn't send your review. Please try again in a moment."
						/>
					</p>

				</form>

			</div>

		</div>

	</div>

</section>

<script>
	import { apiUrl } from "../../scripts/api";
	import { SubmitError, submitForm } from "../../scripts/submit";

	const prefersReducedMotion = window.matchMedia(
		"(prefers-reduced-motion: reduce)"
	).matches;

	// ---------- Reviews (from /api/reviews) ----------

	type LiveReview = { id: number; name: string; service: string; rating: number; text: string };

	const VISIBLE = 6; // shown before "Ver todas"

	const grid = document.querySelector<HTMLElement>("[data-reviews]")!;
	const template = document.getElementById("review-template") as HTMLTemplateElement;
	const summary = document.querySelector<HTMLElement>("[data-reviews-summary]")!;
	const moreWrap = document.querySelector<HTMLElement>("[data-reviews-more-wrap]")!;
	const empty = document.querySelector<HTMLElement>("[data-reviews-empty]")!;
	const loadError = document.querySelector<HTMLElement>("[data-reviews-error]")!;

	const clampRating = (rating: number) => Math.min(5, Math.max(1, Math.round(rating)));
	const starsFor = (rating: number) => "★".repeat(rating) + "☆".repeat(5 - rating);

	const buildCard = (review: LiveReview) => {
		const card = template.content.firstElementChild!.cloneNode(true) as HTMLElement;
		const rating = clampRating(review.rating);

		card.dataset.reviewId = String(review.id);
		card.dataset.rating = String(rating);
		card.querySelector(".avatar")!.textContent = review.name.charAt(0);
		card.querySelector(".name")!.textContent = review.name;

		const service = card.querySelector(".service")!;
		if (review.service) service.textContent = review.service;
		else service.remove();

		const cardStars = card.querySelector(".card-stars")!;
		cardStars.textContent = starsFor(rating);
		cardStars.setAttribute("aria-label", `${rating}/5`);

		card.querySelector(".text")!.textContent = `"${review.text}"`;

		return card;
	};

	let lastKey: string | null = null;

	const renderLiveReviews = async () => {
		let live: LiveReview[];

		try {
			const res = await fetch(apiUrl("/api/reviews"), { cache: "no-store" });
			if (!res.ok) throw new Error(String(res.status));
			live = (await res.json()).reviews ?? [];
		} catch {
			// Keep whatever is shown; only say so if nothing ever loaded.
			if (lastKey === null) {
				grid.replaceChildren();
				grid.removeAttribute("aria-busy");
				loadError.hidden = false;
			}
			return;
		}

		// Nothing changed since the last check: leave the page alone.
		const key = JSON.stringify(live);
		if (key === lastKey) return;
		lastKey = key;

		grid.replaceChildren(...live.map(buildCard));
		grid.removeAttribute("aria-busy");
		loadError.hidden = true;
		empty.hidden = live.length > 0;
		summary.hidden = live.length === 0;
		moreWrap.hidden = !grid.classList.contains("is-collapsed") || live.length <= VISIBLE;
		document.querySelector("[data-reviews-total]")!.textContent = String(live.length);

		if (!live.length) return;

		const average = live.reduce((sum, r) => sum + clampRating(r.rating), 0) / live.length;
		summary.querySelector(".score-number")!.textContent = average.toFixed(1);
		summary.querySelector(".score-stars")!.textContent = starsFor(Math.round(average));
		summary.querySelectorAll(".review-count").forEach((el) => {
			el.textContent = String(live.length);
		});
	};

	document.querySelector("[data-reviews-more]")?.addEventListener("click", () => {
		grid.classList.remove("is-collapsed");
		moreWrap.hidden = true;
	});

	renderLiveReviews();

	// Keep open pages in step with moderation: a removed review disappears
	// within a minute, or at once when asked (the admin's review view does).
	setInterval(() => {
		if (!document.hidden) renderLiveReviews();
	}, 60_000);
	document.addEventListener("sd:reviews-refresh", () => renderLiveReviews());

	// Reviews can be set to wait for approval in /admin: say so instead.
	fetch(apiUrl("/api/settings"), { cache: "no-store" })
		.then((res) => (res.ok ? res.json() : null))
		.then((settings) => {
			if (settings?.reviews_instant !== false) return;
			document.querySelectorAll<HTMLElement>("[data-when-instant]").forEach((el) => (el.hidden = true));
			document.querySelectorAll<HTMLElement>("[data-when-moderated]").forEach((el) => (el.hidden = false));
		})
		.catch(() => {});

	// ---------- Leave a review ----------

	const form = document.getElementById("review-form") as HTMLFormElement | null;
	const status = document.getElementById("review-status");
	const statusPending = document.getElementById("review-status-pending");
	const statusSent = document.getElementById("review-status-sent");
	const limit = document.getElementById("review-limit");
	const error = document.getElementById("review-error");
	const errorSummary = document.getElementById("review-error-summary");
	const submitBtn = form?.querySelector<HTMLButtonElement>(".submit");
	const submitLabel = submitBtn?.querySelector(".submit-label:not(.submit-loading)");
	const submitLoading = submitBtn?.querySelector(".submit-loading");

	const messages = {
		es: { required: "Este campo es obligatorio.", choose: "Elige una valoración." },
		en: { required: "This field is required.", choose: "Please choose a rating." },
	};

	const currentLang = () => (document.documentElement.lang === "en" ? "en" : "es");

	const clearFieldError = (input: HTMLElement, errorId: string) => {
		input.removeAttribute("aria-invalid");
		const el = document.getElementById(errorId);
		if (el) el.textContent = "";
	};

	const setFieldError = (input: HTMLElement, errorId: string, text: string) => {
		input.setAttribute("aria-invalid", "true");
		const el = document.getElementById(errorId);
		if (el) el.textContent = text;
	};

	const validateForm = (): boolean => {
		if (!form) return false;

		let firstInvalid: HTMLElement | null = null;
		const lang = currentLang();

		const requiredFields = [
			{ name: "nombre", errorId: "err-nombre" },
			{ name: "rating", errorId: "err-rating", choose: true },
			{ name: "comentario", errorId: "err-comentario" },
		];

		for (const { name, errorId, choose } of requiredFields) {
			const input = form.elements.namedItem(name) as
				| HTMLInputElement
				| HTMLSelectElement
				| HTMLTextAreaElement
				| null;
			if (!input) continue;

			if (!input.value.trim()) {
				setFieldError(input, errorId, choose ? messages[lang].choose : messages[lang].required);
				firstInvalid ??= input;
			} else {
				clearFieldError(input, errorId);
			}
		}

		if (errorSummary) {
			if (firstInvalid) {
				errorSummary.textContent =
					lang === "es"
						? "Revisa los campos marcados en rojo antes de enviar."
						: "Please check the fields highlighted in red before submitting.";
				errorSummary.hidden = false;
			} else {
				errorSummary.hidden = true;
				errorSummary.textContent = "";
			}
		}

		firstInvalid?.focus();
		return !firstInvalid;
	};

	const COOLDOWN_MS = 8000;
	let cooling = false;

	const setSubmitting = (submitting: boolean) => {
		submitBtn?.toggleAttribute("disabled", submitting);
		submitLabel?.toggleAttribute("hidden", submitting);
		submitLoading?.toggleAttribute("hidden", !submitting);
	};

	form?.addEventListener("submit", async (e) => {
		e.preventDefault();
		if (cooling) return;

		status?.setAttribute("hidden", "");
		statusPending?.setAttribute("hidden", "");
		statusSent?.setAttribute("hidden", "");
		limit?.setAttribute("hidden", "");
		error?.setAttribute("hidden", "");

		const honeypot = form.elements.namedItem("website") as HTMLInputElement | null;
		if (honeypot?.value) {
			form.reset();
			statusSent?.removeAttribute("hidden");
			return;
		}

		if (!validateForm()) return;

		const data = new FormData(form);
		const get = (name: string) => (data.get(name) || "").toString().trim();

		const payload = {
			form: "review",
			nickname: get("nombre"),
			service: get("servicio"),
			rating: Number(get("rating")),
			comment: get("comentario"),
		};

		setSubmitting(true);
		cooling = true;

		try {
			const { id, published } = await submitForm(payload);

			form.reset();

			if (id === undefined) {
				// Sent without our backend (it couldn't be reached): received, not published.
				statusSent?.removeAttribute("hidden");
			} else if (!published) {
				statusPending?.removeAttribute("hidden");
			} else {
				status?.removeAttribute("hidden");
				await renderLiveReviews();

				const card = document.querySelector<HTMLElement>(`#valoraciones [data-review-id="${id}"]`);
				if (card) {
					card.classList.add("is-fresh");
					card.scrollIntoView({ behavior: prefersReducedMotion ? "auto" : "smooth", block: "center" });
				}
			}
		} catch (err) {
			if (err instanceof SubmitError && err.code === "rate_limited") limit?.removeAttribute("hidden");
			else error?.removeAttribute("hidden");
		} finally {
			setSubmitting(false);
			setTimeout(() => {
				cooling = false;
			}, COOLDOWN_MS);
		}
	});
</script>

<style>

/* Summary */

.summary {
	display: flex;
	flex-wrap: wrap;
	align-items: center;
	gap: 22px;

	margin-bottom: 26px;
	padding: 20px 24px;

	background: var(--gold-bg);
	border: 1px solid var(--gold-border);
	border-radius: var(--radius-sm);
}

.score-number {
	font-family: var(--font-display);
	font-size: 3rem;
	font-weight: 700;
	line-height: 1;
	color: var(--gold-text);
}

.score-meta {
	display: flex;
	flex-direction: column;
	gap: 4px;
	flex-grow: 1;
}

.score-stars,
.card-stars {
	color: var(--gold);
	letter-spacing: 3px;
	text-shadow: 0 0 12px color-mix(in srgb, var(--gold) 50%, transparent);
}

.score-stars {
	font-size: 1.5rem;
}

.score-count {
	font-family: var(--font-pixel);
	font-size: .72rem;
	letter-spacing: .05em;
	text-transform: uppercase;
	color: var(--text-muted);
}


/* Cards */

.grid {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 18px;
}

.card {
	display: flex;
	flex-direction: column;
	gap: 16px;
}

.author {
	display: flex;
	align-items: center;
	gap: 12px;
}

.avatar {
	display: grid;
	place-items: center;
	flex-shrink: 0;

	width: 44px;
	height: 44px;

	font-family: var(--font-pixel);
	font-size: 1.2rem;
	text-transform: uppercase;
	color: #1C1305;

	background: linear-gradient(135deg, #F8C552, #E39B1B);
	border-radius: var(--radius-xs);
	box-shadow:
		inset 0 2px 0 rgba(255, 255, 255, .3),
		inset 0 -3px 0 rgba(0, 0, 0, .25);
}

.author div {
	display: flex;
	flex-direction: column;
	gap: 2px;
	min-width: 0;
}

.author strong {
	font-family: var(--font-display);
	font-size: 1.05rem;
	font-weight: 600;
	overflow-wrap: anywhere;
}

.author div span {
	font-size: .82rem;
	line-height: 1.4;
	color: var(--text-dim);
}

.card-stars {
	font-size: 1.1rem;
}

.text {
	flex-grow: 1;
	font-size: 1rem;
	line-height: 1.7;
	color: var(--text);
}

.card.is-fresh {
	outline: 2px solid var(--gold);
	outline-offset: 4px;
	animation: freshReview 2.4s ease-out 1;
}

@keyframes freshReview {
	from { box-shadow: 0 0 0 0 color-mix(in srgb, var(--gold) 60%, transparent); }
	to { box-shadow: 0 0 0 18px transparent; }
}

.empty {
	text-align: center;
	color: var(--text-muted);
}


/* Loading, "Ver todas", empty and error states */

#valoraciones [hidden] {
	display: none !important;
}

.grid.is-collapsed > [data-review-id]:nth-child(n + 7) {
	display: none;
}

.card.skeleton {
	min-height: 190px;
	background: linear-gradient(90deg, var(--surface-1), var(--surface-2), var(--surface-1));
	background-size: 200% 100%;
	animation: reviewShimmer 1.3s linear infinite;
}

@keyframes reviewShimmer {
	to { background-position: -200% 0; }
}

.more {
	display: flex;
	justify-content: center;
	margin-top: 22px;
}


/* Leave a review */

.leave {
	display: grid;
	grid-template-columns: .8fr 1.2fr;
	align-items: start;
	gap: 48px;

	margin-top: 72px;
}

.leave-copy {
	display: flex;
	flex-direction: column;
	gap: 16px;
	position: sticky;
	top: calc(var(--header-h) + 32px);
}

.leave-copy .title {
	font-size: clamp(1.8rem, 3.4vw, 2.6rem);
}

.leave-copy p {
	color: var(--text-muted);
	line-height: 1.8;
}

#review-form {
	display: flex;
	flex-direction: column;
	gap: 18px;
}


@media (max-width: 1000px) {

	.grid {
		grid-template-columns: 1fr 1fr;
	}

	.leave {
		grid-template-columns: 1fr;
		gap: 28px;
	}

	.leave-copy {
		position: static;
	}
}

@media (max-width: 640px) {

	.grid {
		grid-template-columns: 1fr;
	}
}

</style>
