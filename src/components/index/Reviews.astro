---
/*
	Añade aquí las valoraciones reales de tus clientes.
	Ejemplo:

	{ name: "User123", rating: 5, service: "Creación de servidor", text: "Quedó genial, muy profesionales." }
*/
const reviews: {
	name: string;
	rating: number;
	service?: string;
	text: string;
}[] = [
	{
		name: "Eggchan00",
		rating: 5,
		service: "Helped redesign my discord and built it up",
		text: "He was the best person to do it it literally took him less than a day and you guys should try it too",
	},
	{
		name: "COR_braydzYT",
		rating: 5,
		service: "discord moderation",
		text: "hes so good and fast and kind",
	},
	{
		name: "IVN22",
		rating: 5,
		service: "Creación de bot personalizado, remodelación y moderación del servidor de Discord",
		text: "De lo mejor que puedes encontrar, muy rápido, perfecto",
	},
];

const count = reviews.length;

const average =
	count > 0
		? reviews.reduce((sum, r) => sum + r.rating, 0) / count
		: 0;

const stars = (rating: number) =>
	"★".repeat(rating) + "☆".repeat(5 - rating);
---

<section class="reviews" id="valoraciones">

	<div class="container">


		<div class="header reveal">

			<span>
				<span data-lang="es">VALORACIONES</span>
				<span data-lang="en">REVIEWS</span>
			</span>

			<h2>
				<span data-lang="es">Lo que opinan nuestros clientes</span>
				<span data-lang="en">What our clients say</span>
			</h2>

			<p data-lang="es">
				Cada valoración es de un cliente real que ha usado nuestro
				servicio. Si ya trabajamos juntos, ¡nos encantaría leer tu opinión!
			</p>

			<p data-lang="en">
				Every review comes from a real client who used our service.
				If we've already worked together, we'd love to hear your feedback!
			</p>

		</div>


		{
			count > 0 ? (
				<>
					<div class="summary reveal">
						<span class="score-stars">{stars(Math.round(average))}</span>
						<span class="score-number">{average.toFixed(1)} / 5</span>
						<span class="score-count">
							<span data-lang="es">basado en {count} valoraciones</span>
							<span data-lang="en">based on {count} reviews</span>
						</span>
					</div>

					{count > 3 ? (
						<div class="carousel reveal">
							<div class="carousel-track">
								{reviews.map((review) => (
									<div class="card spotlight">
										<span class="card-stars">{stars(review.rating)}</span>
										<p class="text">"{review.text}"</p>
										<div class="author">
											<strong>{review.name}</strong>
											{review.service && <span>{review.service}</span>}
										</div>
									</div>
								))}
							</div>

							<div class="carousel-dots">
								{reviews.map((_, i) => (
									<button
										type="button"
										class="dot"
										aria-label={`Review ${i + 1}`}
									/>
								))}
							</div>
						</div>
					) : (
						<div class="grid">
							{reviews.map((review) => (
								<div class="card reveal spotlight">
									<span class="card-stars">{stars(review.rating)}</span>
									<p class="text">"{review.text}"</p>
									<div class="author">
										<strong>{review.name}</strong>
										{review.service && <span>{review.service}</span>}
									</div>
								</div>
							))}
						</div>
					)}
				</>
			) : (
				<div class="empty reveal">
					<p data-lang="es">
						Todavía no tenemos valoraciones publicadas —
						¡sé el primero en dejar la tuya!
					</p>
					<p data-lang="en">
						We don't have any published reviews yet —
						be the first to leave one!
					</p>
				</div>
			)
		}


		<div class="form-card reveal">

			<h3>
				<span data-lang="es">Deja tu valoración</span>
				<span data-lang="en">Leave your review</span>
			</h3>

			<form id="review-form">

				<div class="grid-fields">

					<label>
						<span data-lang="es">Apodo *</span>
						<span data-lang="en">Nickname *</span>
						<input
							type="text"
							name="nombre"
							placeholder="Ej. Eggchan00 / e.g. Eggchan00"
							required
						/>
					</label>

					<label>
						<span data-lang="es">Servicio recibido</span>
						<span data-lang="en">Service received</span>
						<input type="text" name="servicio" placeholder="Ej. Creación de servidor" />
					</label>

				</div>

				<label>
					<span data-lang="es">Valoración *</span>
					<span data-lang="en">Rating *</span>

					<select name="rating" required>
						<option value="" disabled selected>-- </option>
						<option value="5">★★★★★ (5/5)</option>
						<option value="4">★★★★☆ (4/5)</option>
						<option value="3">★★★☆☆ (3/5)</option>
						<option value="2">★★☆☆☆ (2/5)</option>
						<option value="1">★☆☆☆☆ (1/5)</option>
					</select>
				</label>

				<label>
					<span data-lang="es">Tu comentario *</span>
					<span data-lang="en">Your comment *</span>
					<textarea name="comentario" rows="4" required></textarea>
				</label>

				<button type="submit" class="submit">
					<span data-lang="es">Enviar valoración →</span>
					<span data-lang="en">Submit review →</span>
				</button>

				<p class="hint">
					<span data-lang="es">
						Tu valoración se envía directamente a nuestro equipo —
						la publicaremos en cuanto la revisemos.
					</span>
					<span data-lang="en">
						Your review is sent straight to our team —
						we'll publish it once we review it.
					</span>
				</p>

				<p id="review-status" class="status" hidden>
					<span data-lang="es">
						✅ ¡Gracias! Hemos recibido tu valoración.
					</span>
					<span data-lang="en">
						✅ Thanks! We received your review.
					</span>
				</p>

				<p id="review-error" class="status error" hidden>
					<span data-lang="es">
						⚠️ No hemos podido enviar tu valoración. Inténtalo de nuevo en unos segundos.
					</span>
					<span data-lang="en">
						⚠️ We couldn't send your review. Please try again in a moment.
					</span>
				</p>

			</form>

		</div>

	</div>

</section>


<script>
	const prefersReducedMotion = window.matchMedia(
		"(prefers-reduced-motion: reduce)"
	).matches;

	const track = document.querySelector<HTMLElement>(".carousel-track");

	if (track) {
		const cards = Array.from(track.querySelectorAll<HTMLElement>(".card"));
		const dots = document.querySelectorAll<HTMLButtonElement>(".carousel-dots .dot");

		if (dots.length) {
			dots.forEach((dot, i) => {
				dot.addEventListener("click", () => {
					cards[i]?.scrollIntoView({
						behavior: "smooth",
						inline: "start",
						block: "nearest",
					});
				});
			});

			const dotObserver = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) return;
						const index = cards.indexOf(entry.target as HTMLElement);
						dots.forEach((d, i) => d.classList.toggle("active", i === index));
					});
				},
				{ root: track, threshold: 0.6 }
			);

			cards.forEach((card) => dotObserver.observe(card));
		}

		if (!prefersReducedMotion && cards.length > 1) {
			let paused = false;

			track.addEventListener("mouseenter", () => (paused = true));
			track.addEventListener("mouseleave", () => (paused = false));

			setInterval(() => {
				if (paused) return;

				const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 5;

				if (atEnd) {
					track.scrollTo({ left: 0, behavior: "smooth" });
					return;
				}

				const next = cards.find((c) => c.offsetLeft > track.scrollLeft + 5);
				if (next) {
					track.scrollTo({ left: next.offsetLeft, behavior: "smooth" });
				}
			}, 3500);
		}
	}

	const MAKE_WEBHOOK_URL =
		"https://hook.eu1.make.com/0k965b8ykue9xfa4wuny31jj5w5liinb";

	const form = document.getElementById("review-form") as HTMLFormElement | null;
	const status = document.getElementById("review-status");
	const error = document.getElementById("review-error");
	const submitBtn = form?.querySelector<HTMLButtonElement>(".submit");

	form?.addEventListener("submit", async (e) => {
		e.preventDefault();

		status?.setAttribute("hidden", "");
		error?.setAttribute("hidden", "");

		const data = new FormData(form);
		const get = (name: string) => (data.get(name) || "").toString().trim();

		const payload = {
			nickname: get("nombre"),
			service: get("servicio"),
			rating: Number(get("rating")),
			comment: get("comentario"),
		};

		submitBtn?.setAttribute("disabled", "");

		try {
			const response = await fetch(MAKE_WEBHOOK_URL, {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify(payload),
			});

			if (!response.ok) throw new Error("Request failed");

			form.reset();
			status?.removeAttribute("hidden");
		} catch (err) {
			error?.removeAttribute("hidden");
		} finally {
			submitBtn?.removeAttribute("disabled");
		}
	});
</script>


<style>

.reviews {

	padding:120px 32px;

}


.container {

	max-width:1100px;

	margin:auto;

}


.header {

	text-align:center;

	margin-bottom:60px;

}


.header span:first-child {

	font-size:.85rem;

	font-weight:700;

	letter-spacing:3px;

	color:var(--primary);

}


.header h2 {

	margin-top:20px;

	font-size:clamp(2.5rem,5vw,4rem);

	color:var(--text);

	letter-spacing:-2px;

}


.header p {

	max-width:650px;

	margin:20px auto 0;

	color:var(--text-muted);

	line-height:1.8;

	font-size:1.05rem;

}


.summary {

	display:flex;

	flex-direction:column;

	align-items:center;

	gap:8px;

	margin-bottom:50px;

}


.score-stars {

	font-size:2.2rem;

	color:#FFC94A;

	letter-spacing:4px;

}


.score-number {

	font-size:1.3rem;

	font-weight:800;

	color:var(--text);

}


.score-count {

	color:var(--text-muted);

	font-size:.95rem;

}


.empty {

	text-align:center;

	padding:40px;

	margin-bottom:50px;

	border-radius:22px;

	background:var(--surface-1);

	border:1px solid var(--border-1);

	color:var(--text-muted);

	font-size:1.05rem;

}


.grid {

	display:grid;

	grid-template-columns:repeat(3,1fr);

	gap:24px;

	margin-bottom:50px;

}


.card {

	padding:30px;

	border-radius:22px;

	background:var(--surface-1);

	border:1px solid var(--border-1);

	display:flex;

	flex-direction:column;

	gap:16px;

	transition:.3s ease;

}


.card:hover {

	transform:translateY(-6px);

	border-color:var(--primary-border);

	box-shadow:0 20px 45px color-mix(in srgb, var(--primary) 15%, transparent);

}


.grid .card:nth-child(2) { transition-delay: .08s; }
.grid .card:nth-child(3) { transition-delay: .16s; }


.carousel {

	margin-bottom:50px;

}


.carousel-track {

	display:flex;

	gap:24px;

	overflow-x:auto;

	scroll-snap-type:x mandatory;

	scrollbar-width:none;

	padding-bottom:4px;

}


.carousel-track::-webkit-scrollbar {

	display:none;

}


.carousel-track .card {

	scroll-snap-align:start;

	flex:0 0 calc((100% - 48px) / 3);

	min-width:260px;

}


.carousel-dots {

	display:flex;

	justify-content:center;

	gap:10px;

	margin-top:24px;

}


.dot {

	width:9px;

	height:9px;

	padding:0;

	border-radius:50%;

	border:none;

	background:var(--border-2);

	cursor:pointer;

	transition:.25s ease;

}


.dot:hover {

	background:var(--primary-light);

}


.dot.active {

	background:var(--primary);

	width:22px;

	border-radius:999px;

}


.card-stars {

	color:#FFC94A;

	font-size:1.2rem;

	letter-spacing:2px;

}


.card .text {

	color:var(--text-muted);

	line-height:1.8;

	font-size:.95rem;

	flex-grow:1;

}


.author {

	display:flex;

	flex-direction:column;

	gap:2px;

}


.author strong {

	color:var(--text);

	font-size:.95rem;

}


.author span {

	color:var(--primary-light);

	font-size:.85rem;

}


.form-card {

	padding:44px;

	border-radius:28px;

	background:var(--surface-1);

	border:1px solid var(--border-1);

	backdrop-filter:blur(15px);

}


.form-card h3 {

	margin:0 0 26px;

	color:var(--text);

	font-size:1.5rem;

}


#review-form {

	display:flex;

	flex-direction:column;

	gap:20px;

}


.grid-fields {

	display:grid;

	grid-template-columns:1fr 1fr;

	gap:20px;

}


label {

	display:flex;

	flex-direction:column;

	gap:8px;

	color:var(--text-muted);

	font-size:.95rem;

	font-weight:600;

}


input[type="text"],
select,
textarea {

	padding:12px 14px;

	border-radius:12px;

	background:var(--surface-2);

	border:1px solid var(--border-2);

	color:var(--text);

	font-family:inherit;

	font-size:.95rem;

	font-weight:400;

	transition:.2s ease;

}


input[type="text"]:focus,
select:focus,
textarea:focus {

	outline:none;

	border-color:color-mix(in srgb, var(--primary) 60%, transparent);

	background:var(--surface-3);

}


textarea {

	resize:vertical;

}


.submit {

	align-self:flex-start;

	padding:15px 32px;

	border-radius:14px;

	border:none;

	background:var(--primary);

	color:white;

	font-weight:700;

	font-size:1rem;

	cursor:pointer;

	transition:.25s ease;

}


.submit:hover {

	transform:translateY(-3px);

	box-shadow:0 15px 40px var(--primary-glow);

}


.submit:disabled {

	opacity:.6;

	cursor:not-allowed;

	transform:none;

}


.hint {

	color:var(--text-muted);

	font-size:.88rem;

	line-height:1.6;

}


.status {

	padding:14px 18px;

	border-radius:14px;

	background:var(--primary-bg);

	border:1px solid var(--primary-border);

	color:var(--primary-light);

	font-size:.92rem;

}


.status.error {

	background:rgba(255,69,58,.1);

	border-color:rgba(255,69,58,.35);

	color:#FFD4D1;

}


@media (max-width:900px) {

	.grid {

		grid-template-columns:1fr;

	}


	.carousel-track .card {

		flex-basis:calc((100% - 24px) / 2);

	}

}


@media (max-width:700px) {

	.reviews {

		padding:90px 20px;

	}


	.form-card {

		padding:28px;

	}


	.grid-fields {

		grid-template-columns:1fr;

	}


	.submit {

		width:100%;

	}


	.carousel-track .card {

		flex-basis:88%;

		min-width:0;

	}

}

</style>
