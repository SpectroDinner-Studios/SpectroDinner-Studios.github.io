---
import T from "../T.astro";
import SectionHeader from "../SectionHeader.astro";

const services = [
	{
		icon: "✨",
		title: { es: "Creación de servidores", en: "Server Creation" },
		text: {
			es: "Construimos tu servidor desde cero: estructura de canales, roles, permisos, bots y diseño visual, todo pensado para tu comunidad.",
			en: "We build your server from scratch: channel structure, roles, permissions, bots and visual design, all built around your community.",
		},
		tags: [{ es: "Canales", en: "Channels" }, { es: "Roles y permisos", en: "Roles & permissions" }, { es: "Diseño visual", en: "Visual design" }],
	},
	{
		icon: "⚙️",
		title: { es: "Configuración", en: "Configuration" },
		text: {
			es: "¿Ya tienes servidor? Lo configuramos y optimizamos: bots de moderación, verificación, tickets, niveles, economía y automatizaciones.",
			en: "Already have a server? We configure and optimize it: moderation bots, verification, tickets, leveling, economy and automations.",
		},
		tags: [{ es: "Moderación", en: "Moderation" }, { es: "Bots" }, { es: "Automatización", en: "Automation" }],
	},
	{
		icon: "🎨",
		title: { es: "Rediseño", en: "Redesign" },
		text: {
			es: "Renovamos por completo la identidad de tu servidor: nueva estética, banners, iconos y reorganización total para que se vea profesional.",
			en: "We completely renew your server's identity: new aesthetics, banners, icons and full reorganization so it looks professional.",
		},
		tags: [{ es: "Identidad visual", en: "Visual identity" }, { es: "Reorganización", en: "Reorganization" }, { es: "Branding" }],
	},
	{
		icon: "📋",
		title: { es: "Gratis y a tu medida", en: "Free & Custom" },
		text: {
			es: "Cada proyecto empieza con nuestro cuestionario: nos cuentas el estilo, la temática, el tamaño de tu comunidad y lo que necesitas.",
			en: "Every project starts with our questionnaire: you tell us the style, theme, community size and what you need.",
		},
		tags: [{ es: "Cuestionario", en: "Questionnaire" }, { es: "A medida", en: "Tailored" }],
		gold: true,
	},
];
---

<section class="section" id="servicios">

	<div class="container">

		<SectionHeader
			index="03"
			eyebrow={{ es: "Nuestros servicios", en: "Our services" }}
			title={{ es: "Tu servidor de Discord, a tu gusto.", en: "Your Discord server, your way." }}
		>
			<T
				es="Trabajamos contigo desde el primer mensaje hasta la entrega final. Cada servidor se diseña según el diseño, la temática y el propósito que nos cuentes en el cuestionario."
				en="We work with you from the first message to final delivery. Every server is designed around the design, theme and purpose you tell us about in the questionnaire."
			/>
		</SectionHeader>

		<div class="grid">

			{services.map((service, i) => (
				<article
					class:list={["hud-card", "interactive", "reveal", { gold: service.gold }]}
					style={`--reveal-delay:${i * 70}ms`}
				>

					<span class:list={["icon-tile", { gold: service.gold }]}>{service.icon}</span>

					<div class="text">

						<h3><T {...service.title} /></h3>

						<p><T {...service.text} /></p>

						<div class="chips">
							{service.tags.map((tag) => (
								<span class:list={["chip", { "chip-gold": service.gold }]}><T {...tag} /></span>
							))}
						</div>

					</div>

				</article>
			))}

		</div>

	</div>

</section>

<style>

.grid {
	display: grid;
	grid-template-columns: repeat(2, 1fr);
	gap: 18px;
}

.hud-card {
	display: flex;
	gap: 20px;
}

.icon-tile {
	flex-shrink: 0;
}

.text {
	display: flex;
	flex-direction: column;
	gap: 12px;
}

h3 {
	font-size: 1.3rem;
	font-weight: 600;
}

p {
	color: var(--text-muted);
	font-size: .96rem;
	line-height: 1.7;
}

.chips {
	margin-top: 4px;
}

@media (max-width: 860px) {

	.grid {
		grid-template-columns: 1fr;
	}
}

@media (max-width: 480px) {

	.hud-card {
		flex-direction: column;
	}
}

</style>
