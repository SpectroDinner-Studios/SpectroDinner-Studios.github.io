<section class="leadership">

	<div class="container">


		<div class="header reveal">

			<span>
				<span data-lang="es">LIDERAZGO</span>
				<span data-lang="en">LEADERSHIP</span>
			</span>


			<h2>
				<span data-lang="es">La visión detrás de SpectroDinner Studios</span>
				<span data-lang="en">The vision behind SpectroDinner Studios</span>
			</h2>


			<p>
				<span data-lang="es">
					La persona responsable de la visión, la
					arquitectura y el desarrollo de cada proyecto.
				</span>
				<span data-lang="en">
					The person responsible for the vision,
					architecture and development behind every project.
				</span>
			</p>

		</div>



		<div class="profile reveal spotlight">


			<div class="avatar-container">

				<div class="glow"></div>


				<img
					src="https://avatars.githubusercontent.com/Elmoderador"
					alt="Elmoderador"
				/>

			</div>




			<div class="content">


				<h3>
					Elmoderador
				</h3>


				<h4>
					<span data-lang="es">Fundador y Lead Developer</span>
					<span data-lang="en">Founder & Lead Developer</span>
				</h4>



				<p>
					<span data-lang="es">
						Fundador de SpectroDinner Studios, al frente
						de la dirección del estudio, la arquitectura
						de software y el proceso de desarrollo.
						Centrado en crear software, juegos y proyectos
						de Minecraft, con el rendimiento y la calidad
						como prioridad.
					</span>
					<span data-lang="en">
						Founder of SpectroDinner Studios, leading the
						studio's direction, software architecture and
						development process. Focused on creating
						modern software, games and Minecraft projects,
						with performance and quality in mind.
					</span>
				</p>




				<div class="stats">


					<div>

						<strong data-counter="2024">
							2024
						</strong>

						<span>
							<span data-lang="es">Fundación</span>
							<span data-lang="en">Founded</span>
						</span>

					</div>



					<div>

						<strong>
							<span data-lang="es">Varias</span>
							<span data-lang="en">Multiple</span>
						</strong>

						<span>
							<span data-lang="es">Tecnologías</span>
							<span data-lang="en">Technologies</span>
						</span>

					</div>



					<div>

						<strong>
							<span data-lang="es">Abierto</span>
							<span data-lang="en">Open</span>
						</strong>

						<span>
							<span data-lang="es">Desarrollo</span>
							<span data-lang="en">Development</span>
						</span>

					</div>


				</div>



				<div class="buttons">


					<a
						href="https://github.com/Elmoderador"
						target="_blank"
						rel="noopener noreferrer"
						class="primary"
					>
						<span data-lang="es">Perfil de GitHub ↗</span>
						<span data-lang="en">GitHub Profile ↗</span>
					</a>



					<a
						href="/projects"
						class="secondary"
					>
						<span data-lang="es">Ver Proyectos</span>
						<span data-lang="en">View Projects</span>
					</a>


				</div>


			</div>


		</div>


	</div>

</section>



<style>

.leadership {

	padding:120px 32px;

}



.container {

	max-width:1200px;

	margin:auto;

}



.header {

	text-align:center;

	margin-bottom:80px;

}



.header span {

	font-size:.85rem;

	font-weight:700;

	letter-spacing:3px;

	color:var(--primary);

}



.header h2 {

	margin-top:25px;

	color:var(--text);

	font-size:

		clamp(2.5rem,5vw,4rem);


	letter-spacing:-2px;

}



.header p {

	max-width:700px;

	margin:25px auto 0;

	color:var(--text-muted);

	line-height:1.9;

}



.profile {

	display:grid;

	grid-template-columns:350px 1fr;

	gap:80px;

	align-items:center;


	padding:70px;


	border-radius:35px;


	background:

		var(--surface-1);


	border:

		1px solid

		var(--border-1);


	backdrop-filter:

		blur(20px);


	overflow:hidden;

	position:relative;

}



.profile::before {

	content:"";


	position:absolute;

	width:500px;

	height:500px;

	right:-200px;

	top:-200px;


	background:

		radial-gradient(

			circle,

			color-mix(in srgb, var(--primary) 18%, transparent),

			transparent 70%

		);


	filter:blur(40px);

}



.avatar-container {

	position:relative;

	display:flex;

	justify-content:center;

	align-items:center;

	min-width:0;

}



.avatar-container .glow {

	position:absolute;

	width:280px;

	height:280px;


	background:

		radial-gradient(

			circle,

			color-mix(in srgb, var(--primary) 45%, transparent),

			transparent 70%

		);


	filter:blur(45px);

}



.avatar-container img {

	position:relative;


	width:240px;

	height:240px;


	border-radius:50%;


	aspect-ratio:1 / 1;


	object-fit:cover;


	border:

		4px solid

		var(--border-2);


	box-shadow:

		0 20px 60px

		var(--shadow-color);

}



.content {

	min-width:0;

}



.content h3 {

	margin:0;


	font-size:3rem;


	color:var(--text);


	letter-spacing:-2px;

	overflow-wrap:break-word;

}



.content h4 {

	margin:

		15px 0 35px;


	color:var(--primary);


	font-size:1.2rem;

}



.content p {

	color:var(--text-muted);


	line-height:2;


	font-size:1.05rem;


	max-width:650px;


	margin-bottom:45px;

}



.stats {

	display:flex;


	gap:25px;


	margin-top:50px;

}



.stats div {

	flex:1;


	padding:25px;


	border-radius:20px;


	background:

		var(--surface-2);


	border:

		1px solid

		var(--border-1);

}



.stats strong {

	display:block;

	color:var(--text);

	font-size:1.6rem;

	margin-bottom:8px;

}



.stats span {

	color:var(--text-muted);

	font-size:.9rem;

}



.buttons {

	display:flex;


	gap:20px;


	margin-top:50px;

}



.buttons a {

	padding:15px 32px;

	border-radius:14px;

	text-decoration:none;

	font-weight:600;

	transition:.25s ease;

}



.primary {

	background:var(--primary);

	color:white;

}



.primary:hover {

	transform:translateY(-3px);


	box-shadow:

		0 15px 40px

		var(--primary-glow);

}



.secondary {

	color:var(--text);


	border:

		1px solid

		var(--border-2);

}



.secondary:hover {

	background:

		var(--surface-3);


	transform:

		translateY(-3px);

}



@media(max-width:900px) {


	.profile {

		grid-template-columns:1fr;

		padding:40px;


		text-align:center;

	}


	.content h3 {

		font-size:2.2rem;

	}



	.stats {

		flex-direction:column;

	}



	.buttons {

		flex-direction:column;

	}



	.avatar-container img {

		width:200px;

		height:200px;

	}

}

</style>