---
import T from "../T.astro";
import SectionHeader from "../SectionHeader.astro";
---

<section class="section">

	<div class="container">

		<SectionHeader
			index="06"
			eyebrow={{ es: "Liderazgo", en: "Leadership" }}
			title={{ es: "La visión detrás de SpectroDinner Studios", en: "The vision behind SpectroDinner Studios" }}
		>
			<T
				es="La persona responsable de la visión, la arquitectura y el desarrollo de cada proyecto."
				en="The person responsible for the vision, architecture and development behind every project."
			/>
		</SectionHeader>

		<article class="profile hud-card reveal">

			<div class="avatar-frame">

				<img
					src="https://avatars.githubusercontent.com/Elmoderador"
					alt="Elmoderador"
					width="220"
					height="220"
					loading="lazy"
				/>

				<span class="tag">
					<span class="status-dot" aria-hidden="true"></span>
					PLAYER 01
				</span>

			</div>

			<div class="content">

				<div class="name">
					<h3>Elmoderador</h3>
					<span class="chip chip-primary">
						<T es="Fundador y Lead Developer" en="Founder & Lead Developer" />
					</span>
				</div>

				<p>
					<T
						es="Fundador de SpectroDinner Studios, al frente de la dirección del estudio, la arquitectura de software y el proceso de desarrollo. Centrado en crear software, juegos y proyectos de Minecraft, con el rendimiento y la calidad como prioridad."
						en="Founder of SpectroDinner Studios, leading the studio's direction, software architecture and development process. Focused on creating modern software, games and Minecraft projects, with performance and quality in mind."
					/>
				</p>

				<div class="readouts">
					<div class="readout">
						<strong data-counter="2024">2024</strong>
						<span><T es="Fundación" en="Founded" /></span>
					</div>
					<div class="readout">
						<strong><T es="Varias" en="Multiple" /></strong>
						<span><T es="Tecnologías" en="Technologies" /></span>
					</div>
					<div class="readout">
						<strong><T es="Abierto" en="Open" /></strong>
						<span><T es="Desarrollo" en="Development" /></span>
					</div>
				</div>

				<div class="actions">
					<a
						href="https://github.com/Elmoderador"
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-primary"
					>
						<T es="Perfil de GitHub ↗" en="GitHub Profile ↗" />
					</a>
					<a href="/projects" class="btn btn-ghost">
						<T es="Ver proyectos" en="View projects" />
					</a>
				</div>

			</div>

		</article>

	</div>

</section>

<style>

.profile {
	display: grid;
	grid-template-columns: 280px 1fr;
	align-items: center;
	gap: 48px;

	padding: 40px;
}

.avatar-frame {
	position: relative;
	padding: 10px;

	background:
		linear-gradient(135deg, var(--primary), var(--primary-2));
	clip-path: polygon(16px 0, 100% 0, 100% calc(100% - 16px), calc(100% - 16px) 100%, 0 100%, 0 16px);
}

.avatar-frame img {
	display: block;
	width: 100%;
	height: auto;
	aspect-ratio: 1;
	object-fit: cover;

	clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);
}

.tag {
	position: absolute;
	left: 18px;
	bottom: 18px;

	display: inline-flex;
	align-items: center;
	gap: 8px;

	padding: 5px 9px;

	font-family: var(--font-pixel);
	font-size: .66rem;
	letter-spacing: .06em;
	color: #FFFFFF;

	background: rgba(0, 0, 0, .7);
	border: 1px solid rgba(255, 255, 255, .2);
}

.content {
	display: flex;
	flex-direction: column;
	gap: 22px;
}

.name {
	display: flex;
	flex-wrap: wrap;
	align-items: center;
	gap: 14px;
}

.name h3 {
	font-size: clamp(2rem, 4vw, 2.8rem);
	font-weight: 700;
}

.content > p {
	color: var(--text-muted);
	font-size: 1.04rem;
	line-height: 1.8;
}

@media (max-width: 860px) {

	.profile {
		grid-template-columns: 1fr;
		padding: 28px;
	}

	.avatar-frame {
		max-width: 240px;
	}
}

</style>
