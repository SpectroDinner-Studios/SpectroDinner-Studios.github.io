<style>

.leadership {

	padding:120px 32px;

}



.container {

	max-width:1200px;

	margin:auto;

}



.header {

	text-align:center;

	margin-bottom:80px;

}



.header span {

	font-size:.85rem;

	font-weight:700;

	letter-spacing:3px;

	color:#0A84FF;

}



.header h2 {

	margin-top:25px;

	color:white;

	font-size:

		clamp(2.5rem,5vw,4rem);


	letter-spacing:-2px;

}



.header p {

	max-width:700px;

	margin:25px auto 0;

	color:#9CA3AF;

	line-height:1.9;

}



.profile {

	display:grid;

	grid-template-columns:350px 1fr;

	gap:80px;

	align-items:center;


	padding:70px;


	border-radius:35px;


	background:

		rgba(255,255,255,.04);


	border:

		1px solid

		rgba(255,255,255,.1);


	backdrop-filter:

		blur(20px);


	overflow:hidden;

	position:relative;

}



.profile::before {

	content:"";


	position:absolute;

	width:500px;

	height:500px;

	right:-200px;

	top:-200px;


	background:

		radial-gradient(

			circle,

			rgba(10,132,255,.18),

			transparent 70%

		);


	filter:blur(40px);

}



.avatar-container {

	position:relative;

	display:flex;

	justify-content:center;

	align-items:center;

}



.avatar-container .glow {

	position:absolute;

	width:280px;

	height:280px;


	background:

		radial-gradient(

			circle,

			rgba(10,132,255,.45),

			transparent 70%

		);


	filter:blur(45px);

}



.avatar-container img {

	position:relative;


	width:240px;

	height:240px;


	border-radius:50%;


	aspect-ratio:1 / 1;


	object-fit:cover;


	border:

		4px solid

		rgba(255,255,255,.15);


	box-shadow:

		0 20px 60px

		rgba(0,0,0,.4);

}



.content h3 {

	margin:0;


	font-size:3rem;


	color:white;


	letter-spacing:-2px;

}



.content h4 {

	margin:

		15px 0 35px;


	color:#0A84FF;


	font-size:1.2rem;

}



.content p {

	color:#B6BDC9;


	line-height:2;


	font-size:1.05rem;


	max-width:650px;


	margin-bottom:45px;

}



.stats {

	display:flex;


	gap:25px;


	margin-top:50px;

}



.stats div {

	flex:1;


	padding:25px;


	border-radius:20px;


	background:

		rgba(255,255,255,.05);


	border:

		1px solid

		rgba(255,255,255,.08);

}



.stats strong {

	display:block;

	color:white;

	font-size:1.6rem;

	margin-bottom:8px;

}



.stats span {

	color:#9CA3AF;

	font-size:.9rem;

}



.buttons {

	display:flex;


	gap:20px;


	margin-top:50px;

}



.buttons a {

	padding:15px 32px;

	border-radius:14px;

	text-decoration:none;

	font-weight:600;

	transition:.25s ease;

}



.primary {

	background:#0A84FF;

	color:white;

}



.primary:hover {

	transform:translateY(-3px);


	box-shadow:

		0 15px 40px

		rgba(10,132,255,.35);

}



.secondary {

	color:white;


	border:

		1px solid

		rgba(255,255,255,.15);

}



.secondary:hover {

	background:

		rgba(255,255,255,.08);


	transform:

		translateY(-3px);

}



@media(max-width:900px) {


	.profile {

		grid-template-columns:1fr;

		padding:40px;


		text-align:center;

	}



	.stats {

		flex-direction:column;

	}



	.buttons {

		flex-direction:column;

	}



	.avatar-container img {

		width:200px;

		height:200px;

	}

}

</style>