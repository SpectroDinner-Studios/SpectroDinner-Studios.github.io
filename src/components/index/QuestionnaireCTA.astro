---
import T from "../T.astro";

const points = [
	{ icon: "🎯", es: "Para qué es tu servidor", en: "What your server is for" },
	{ icon: "🎨", es: "Diseño y temática", en: "Design and theme" },
	{ icon: "🧩", es: "Estructura, roles y bots", en: "Structure, roles and bots" },
	{ icon: "💸", es: "100% gratis, sin sorpresas", en: "100% free, no surprises" },
];

const quests = [
	{
		href: "/cuestionario",
		icon: "💬",
		code: "QUEST // DC",
		title: { es: "Servicio de Discord", en: "Discord Service" },
		text: { es: "Crear, configurar o rediseñar tu servidor.", en: "Create, configure or redesign your server." },
	},
	{
		href: "/cuestionario-minecraft",
		icon: "⛏️",
		code: "QUEST // MC",
		title: { es: "Servicio de Minecraft", en: "Minecraft Service" },
		text: { es: "Permisos, rangos, optimización y parches.", en: "Permissions, ranks, optimization and patches." },
	},
];
---

<section class="section-sm">

	<div class="container">

		<div class="panel reveal">

			<div class="intro">

				<span class="eyebrow">
					<T es="Empieza tu proyecto" en="Start your project" />
				</span>

				<h2 class="title">
					<T es="Cuéntanos tu visión" en="Tell us your vision" />
				</h2>

				<p class="lead">
					<T
						es="Elige tu servicio y rellena el cuestionario correspondiente: cuéntanos el diseño, la temática, el propósito y todo lo que necesitas. Con esa información preparamos una propuesta a tu medida."
						en="Pick your service and fill out the matching questionnaire: tell us the design, theme, purpose and everything you need. With that information we put together a proposal made for you."
					/>
				</p>

				<ul class="points">
					{points.map((point) => (
						<li>
							<span class="tick" aria-hidden="true">{point.icon}</span>
							<T es={point.es} en={point.en} />
						</li>
					))}
				</ul>

			</div>

			<div class="quests">

				<span class="quests-label">
					<T es="Elige tu misión" en="Choose your quest" />
				</span>

				{quests.map((quest) => (
					<a href={quest.href} class="quest">
						<span class="quest-icon">{quest.icon}</span>
						<span class="quest-text">
							<small>{quest.code}</small>
							<strong><T {...quest.title} /></strong>
							<span><T {...quest.text} /></span>
						</span>
						<span class="quest-go" aria-hidden="true">▶</span>
					</a>
				))}

			</div>

		</div>

	</div>

</section>

<style>

.panel {
	position: relative;

	display: grid;
	grid-template-columns: 1.2fr 1fr;
	gap: 48px;

	padding: 56px;

	background:
		radial-gradient(circle at 0% 0%, color-mix(in srgb, var(--primary) 18%, transparent), transparent 55%),
		radial-gradient(circle at 100% 100%, color-mix(in srgb, var(--primary-2) 16%, transparent), transparent 55%),
		var(--bg-elevated);
	border: 1px solid var(--primary-border);
	border-radius: var(--radius-md);

	box-shadow: 0 40px 100px -40px var(--primary-glow);

	overflow: hidden;
}

.panel::before {
	content: "";
	position: absolute;
	inset: 0;
	pointer-events: none;
	background-image:
		linear-gradient(var(--grid-line) 1px, transparent 1px),
		linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
	background-size: 32px 32px;
	mask-image: linear-gradient(90deg, transparent, #000);
}

.intro,
.quests {
	position: relative;
	display: flex;
	flex-direction: column;
	gap: 20px;
}

.points {
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 12px;

	margin: 8px 0 0;
	padding: 0;

	list-style: none;
}

.points li {
	display: flex;
	align-items: center;
	gap: 10px;

	font-size: .95rem;
	color: var(--text);
}

.tick {
	display: grid;
	place-items: center;
	flex-shrink: 0;

	width: 32px;
	height: 32px;

	background: var(--surface-2);
	border: 1px solid var(--border-1);
	border-radius: var(--radius-xs);
}

.quests {
	justify-content: center;
	gap: 14px;
}

.quests-label {
	font-family: var(--font-pixel);
	font-size: .74rem;
	letter-spacing: .08em;
	text-transform: uppercase;
	color: var(--text-dim);
}

.quest {
	display: flex;
	align-items: center;
	gap: 16px;

	padding: 18px 20px;

	text-decoration: none;
	color: var(--text);

	background: var(--surface-2);
	border: 1px solid var(--border-2);
	border-left: 3px solid var(--primary);
	border-radius: var(--radius-xs);

	transition:
		transform var(--transition),
		border-color var(--transition),
		background var(--transition);
}

.quest:hover {
	transform: translateX(6px);
	background: var(--primary-bg);
	border-color: var(--primary-border);
	border-left-color: var(--primary);
}

.quest-icon {
	display: grid;
	place-items: center;
	flex-shrink: 0;

	width: 52px;
	height: 52px;

	font-size: 1.5rem;

	background: var(--bg-sunken);
	border: 1px solid var(--border-1);
	border-radius: var(--radius-xs);
}

.quest-text {
	display: flex;
	flex-direction: column;
	gap: 3px;
	flex-grow: 1;
}

.quest-text small {
	font-family: var(--font-pixel);
	font-size: .66rem;
	letter-spacing: .06em;
	color: var(--primary-light);
}

.quest-text strong {
	font-family: var(--font-display);
	font-size: 1.2rem;
	font-weight: 600;
}

.quest-text > span {
	font-size: .9rem;
	color: var(--text-muted);
}

.quest-go {
	font-size: .9rem;
	color: var(--primary-light);
	transition: transform var(--transition);
}

.quest:hover .quest-go {
	transform: translateX(4px);
}

@media (max-width: 960px) {

	.panel {
		grid-template-columns: 1fr;
		padding: 36px 28px;
	}
}

@media (max-width: 520px) {

	.points {
		grid-template-columns: 1fr;
	}

	.panel {
		padding: 28px 20px;
	}
}

</style>
