<button type="button" class="lang-toggle" aria-label="Switch language / Cambiar idioma">
	<span class="globe">🌐</span>
	<span data-lang="es">EN</span>
	<span data-lang="en">ES</span>
</button>

<script>
	document.querySelectorAll(".lang-toggle").forEach((btn) => {
		btn.addEventListener("click", () => {
			const current =
				document.documentElement.getAttribute("lang") === "en" ? "en" : "es";

			const next = current === "es" ? "en" : "es";

			document.documentElement.setAttribute("lang", next);

			try {
				localStorage.setItem("sd-lang", next);
			} catch (e) {}

			window.dispatchEvent(
				new CustomEvent("sd-langchange", { detail: { lang: next } })
			);
		});
	});
</script>

<style>
.lang-toggle {
	display: flex;

	align-items: center;

	gap: 8px;

	padding: 10px 16px;

	border-radius: 12px;

	background: var(--surface-2);

	border: 1px solid var(--border-2);

	color: var(--text);

	font-weight: 700;

	font-size: 0.85rem;

	cursor: pointer;

	transition: 0.25s ease;
}

.lang-toggle:hover {
	background: var(--surface-hover);

	border-color: color-mix(in srgb, var(--primary) 40%, transparent);

	transform: translateY(-2px);
}

.globe {
	font-size: 0.95rem;
}
</style>
