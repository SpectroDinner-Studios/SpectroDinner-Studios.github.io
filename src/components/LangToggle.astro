<button type="button" class="lang-toggle" aria-label="Switch language / Cambiar idioma">
	<span class="lang-opt" data-opt="es">ES</span>
	<span class="lang-sep" aria-hidden="true">/</span>
	<span class="lang-opt" data-opt="en">EN</span>
</button>

<script>
	document.querySelectorAll(".lang-toggle").forEach((btn) => {
		btn.addEventListener("click", () => {
			const current =
				document.documentElement.getAttribute("lang") === "en" ? "en" : "es";

			const next = current === "es" ? "en" : "es";

			document.documentElement.setAttribute("lang", next);

			try {
				localStorage.setItem("sd-lang", next);
			} catch (e) {}

			window.dispatchEvent(
				new CustomEvent("sd-langchange", { detail: { lang: next } })
			);
		});
	});
</script>

<style>

.lang-toggle {
	display: inline-flex;
	align-items: center;
	gap: 5px;

	height: 42px;
	padding: 0 12px;

	font-family: var(--font-pixel);
	font-size: .78rem;
	letter-spacing: .04em;
	color: var(--text-dim);

	background: var(--surface-2);
	border: 1px solid var(--border-2);
	border-radius: var(--radius-xs);

	cursor: pointer;

	transition:
		border-color var(--transition),
		background var(--transition);
}

.lang-toggle:hover {
	border-color: var(--primary-border);
	background: var(--primary-bg);
}

.lang-sep {
	opacity: .5;
}

:global(html:not([lang="en"])) .lang-opt[data-opt="es"],
:global(html[lang="en"]) .lang-opt[data-opt="en"] {
	color: var(--primary-light);
}

/* On small screens show only the active language to save room. */
@media (max-width: 480px) {

	.lang-toggle {
		padding: 0 10px;
	}

	.lang-sep,
	:global(html:not([lang="en"])) .lang-opt[data-opt="en"],
	:global(html[lang="en"]) .lang-opt[data-opt="es"] {
		display: none;
	}
}

</style>
