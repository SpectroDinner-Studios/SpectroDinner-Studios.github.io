---
interface Props {

	title: string | { es: string; en: string };

	description?: string;

}

const {

	title,

	description

} = Astro.props;
---

<section class="faq-category reveal">

	<div class="header">


		<div class="line"></div>


		<div class="titles">

			<h2>

				{typeof title === "string" ? (
					title
				) : (
					<>
						<span data-lang="es">{title.es}</span>
						<span data-lang="en">{title.en}</span>
					</>
				)}

			</h2>


			{
				description && (

					<p>

						{description}

					</p>

				)
			}

		</div>


	</div>



	<div class="items">

		<slot />

	</div>

</section>



<style>

.faq-category {

	position:relative;

	margin-top:90px;

}



.header {

	display:flex;

	align-items:center;

	gap:26px;

	margin-bottom:45px;

}



.line {

	position:relative;

	width:6px;

	height:80px;

	border-radius:999px;


	background:

		linear-gradient(

			to bottom,

			var(--primary),

			color-mix(in srgb, var(--primary) 15%, transparent)

		);


	box-shadow:

		0 0 20px

		color-mix(in srgb, var(--primary) 45%, transparent);

}



.line::before {

	content:"";

	position:absolute;

	left:50%;

	top:0;


	transform:

		translateX(-50%);


	width:16px;

	height:16px;


	border-radius:50%;


	background:var(--primary);


	box-shadow:

		0 0 25px

		color-mix(in srgb, var(--primary) 80%, transparent);

}



.titles {

	display:flex;

	flex-direction:column;

	gap:12px;

}



.titles h2 {

	margin:0;


	font-size:

		clamp(2rem,4vw,2.8rem);


	font-weight:800;


	letter-spacing:-1.5px;


	color:var(--text);

}



.titles p {

	margin:0;


	max-width:720px;


	color:var(--text-muted);


	font-size:1rem;


	line-height:1.8;

}



.items {

	display:flex;

	flex-direction:column;

	gap:24px;

}



@media (max-width:768px) {

	.faq-category {

		margin-top:70px;

	}



	.header {

		align-items:flex-start;

		gap:18px;

		margin-bottom:35px;

	}



	.line {

		height:60px;

	}



	.titles h2 {

		font-size:2rem;

	}



	.titles p {

		font-size:.96rem;

		line-height:1.7;

	}

}



@media (max-width:500px) {

	.header {

		flex-direction:column;

		gap:20px;

	}



	.line {

		width:100%;

		height:4px;

	}



	.line::before {

		top:50%;

		left:0;

		transform:

			translate(-50%,-50%);

	}



	.titles {

		width:100%;

	}

}

</style>