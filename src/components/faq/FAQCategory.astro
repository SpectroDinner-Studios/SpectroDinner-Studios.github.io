---
import T from "../T.astro";

interface Props {
	title: string | { es: string; en: string };
	description?: string;
}

const { title, description } = Astro.props;
---

<section class="faq-category reveal">

	<h3 class="heading">
		{typeof title === "string" ? title : <T {...title} />}
	</h3>

	{description && <p class="description">{description}</p>}

	<div class="items">
		<slot />
	</div>

</section>

<style>

.faq-category {
	display: flex;
	flex-direction: column;
	gap: 14px;
}

.heading {
	display: flex;
	align-items: center;
	gap: 14px;

	font-family: var(--font-pixel);
	font-size: .8rem;
	font-weight: 400;
	letter-spacing: .08em;
	text-transform: uppercase;
	color: var(--primary-light);
}

.heading::after {
	content: "";
	flex-grow: 1;
	height: 1px;
	background: linear-gradient(90deg, var(--border-2), transparent);
}

.description {
	color: var(--text-muted);
}

.items {
	display: flex;
	flex-direction: column;
	gap: 10px;
}

</style>
