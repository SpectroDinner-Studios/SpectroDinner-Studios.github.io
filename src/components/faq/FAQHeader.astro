---
---

<section class="faq-header">

	<div class="background-glow glow-left"></div>

	<div class="background-glow glow-right"></div>



	<div class="content reveal">


		<span class="badge">
			FAQ
		</span>



		<h2>
			Frequently Asked Questions
		</h2>



		<p class="description">
			Everything you need to know about SpectroDinner™,
			our philosophy, projects, technologies and the
			development process behind every product.

			<br><br>

			This knowledge base provides answers to the most
			common questions regarding the studio, featured
			projects and future development plans.
		</p>




		<div class="stats">


			<div class="card">

				<h3 data-counter="11" data-counter-suffix="+">
					11+
				</h3>

				<span>
					Questions
				</span>

			</div>



			<div class="card">

				<h3 data-counter="2024">
					2024
				</h3>

				<span>
					Founded
				</span>

			</div>



			<div class="card">

				<h3>
					Open
				</h3>

				<span>
					Development
				</span>

			</div>



			<div class="card">

				<h3 data-counter="100" data-counter-suffix="%">
					100%
				</h3>

				<span>
					Passion
				</span>

			</div>


		</div>





		<div class="divider">

			<span></span>

		</div>



	</div>

</section>



<style>

.faq-header {

	position:relative;

	padding:40px 0 20px;

	overflow:hidden;

}



.content {

	position:relative;

	z-index:2;

	text-align:center;

}



.badge {

	display:inline-flex;

	align-items:center;

	justify-content:center;

	padding:10px 20px;

	border-radius:999px;

	background:

		var(--primary-bg);

	border:

		1px solid

		var(--primary-border);

	color:var(--primary);

	font-size:.85rem;

	font-weight:700;

	letter-spacing:3px;

	text-transform:uppercase;

	backdrop-filter:blur(15px);

}



h2 {

	margin-top:30px;

	margin-bottom:0;

	font-size:

		clamp(3rem,6vw,4.8rem);

	font-weight:800;

	letter-spacing:-3px;

	color:var(--text);

}



.description {

	max-width:820px;

	margin:35px auto 0;

	color:var(--text-muted);

	font-size:1.08rem;

	line-height:2;

}



.stats {

	margin-top:70px;

	display:grid;

	grid-template-columns:

		repeat(4,1fr);

	gap:25px;

}

	.card {

		position:relative;

		padding:32px 24px;

		border-radius:24px;

		background:

			var(--surface-1);

		border:

			1px solid

			var(--border-1);

		backdrop-filter:

			blur(20px);

		transition:

			.3s ease;

		overflow:hidden;

	}



	.card::before {

		content:"";

		position:absolute;

		inset:0;

		background:

			linear-gradient(

				135deg,

				color-mix(in srgb, var(--primary) 10%, transparent),

				transparent 60%

			);

		opacity:0;

		transition:.3s;

	}



	.card:hover {

		transform:

			translateY(-6px);

		border-color:

			var(--primary-border);

		box-shadow:

			0 20px 45px

			color-mix(in srgb, var(--primary) 15%, transparent);

	}



	.card:hover::before {

		opacity:1;

	}



	.card h3 {

		margin:0;

		font-size:2rem;

		font-weight:800;

		color:var(--text);

	}



	.card span {

		display:block;

		margin-top:10px;

		color:var(--text-muted);

		font-size:.95rem;

		letter-spacing:.5px;

	}



	.divider {

		display:flex;

		justify-content:center;

		margin-top:80px;

	}



	.divider span {

		width:180px;

		height:4px;

		border-radius:999px;

		background:

			linear-gradient(

				90deg,

				transparent,

				var(--primary),

				transparent

			);

		box-shadow:

			0 0 25px

			color-mix(in srgb, var(--primary) 45%, transparent);

	}



	.background-glow {

		position:absolute;

		width:500px;

		height:500px;

		border-radius:50%;

		filter:blur(90px);

		z-index:0;

		pointer-events:none;

	}



	.glow-left {

		top:-180px;

		left:-180px;

		background:

			radial-gradient(

				circle,

				color-mix(in srgb, var(--primary) 18%, transparent),

				transparent 70%

			);

	}



	.glow-right {

		right:-180px;

		bottom:-220px;

		background:

			radial-gradient(

				circle,

				color-mix(in srgb, var(--primary) 12%, transparent),

				transparent 70%

			);

	}



	@media (max-width:900px) {

		.stats {

			grid-template-columns:

				repeat(2,1fr);

		}

	}



	@media (max-width:600px) {

		.faq-header {

			padding:20px 0;

		}



		h2 {

			font-size:2.4rem;

		}



		.description {

			font-size:1rem;

			line-height:1.8;

		}



		.stats {

			grid-template-columns:1fr;

			gap:18px;

			margin-top:50px;

		}



		.card {

			padding:26px;

		}



		.divider {

			margin-top:55px;

		}

	}

</style>