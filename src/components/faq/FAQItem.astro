---
import T from "../T.astro";

interface Props {
	icon: string;
	question: string | { es: string; en: string };
}

const { icon, question } = Astro.props;
---

<details class="faq-item">

	<summary>

		<span class="icon" aria-hidden="true">{icon}</span>

		<span class="question">
			{typeof question === "string" ? question : <T {...question} />}
		</span>

		<span class="expand" aria-hidden="true"></span>

	</summary>

	<div class="content">
		<slot />
	</div>

</details>

<style>

.faq-item {
	background: var(--surface-1);
	border: 1px solid var(--border-1);
	border-left: 3px solid var(--border-2);
	border-radius: var(--radius-xs);

	transition:
		border-color var(--transition),
		background var(--transition);
}

.faq-item:hover {
	border-color: var(--border-2);
	border-left-color: var(--primary);
}

.faq-item[open] {
	background: var(--surface-2);
	border-color: var(--primary-border);
	border-left-color: var(--primary);
}

summary {
	display: flex;
	align-items: center;
	gap: 14px;

	padding: 16px 18px;

	list-style: none;
	cursor: pointer;
}

summary::-webkit-details-marker {
	display: none;
}

.icon {
	display: grid;
	place-items: center;
	flex-shrink: 0;

	width: 36px;
	height: 36px;

	font-size: 1.05rem;

	background: var(--bg-sunken);
	border: 1px solid var(--border-1);
	border-radius: var(--radius-xs);
}

.question {
	flex-grow: 1;

	font-family: var(--font-display);
	font-size: 1.08rem;
	font-weight: 600;
	line-height: 1.35;
}

/* Pixel plus that turns into a minus */
.expand {
	position: relative;
	flex-shrink: 0;
	width: 14px;
	height: 14px;
}

.expand::before,
.expand::after {
	content: "";
	position: absolute;
	background: var(--primary-light);
	transition: transform var(--transition);
}

.expand::before {
	left: 0;
	right: 0;
	top: 6px;
	height: 2px;
}

.expand::after {
	top: 0;
	bottom: 0;
	left: 6px;
	width: 2px;
}

.faq-item[open] .expand::after {
	transform: scaleY(0);
}

.content {
	display: flex;
	flex-direction: column;
	gap: 12px;

	padding: 0 18px 20px 68px;

	color: var(--text-muted);
	line-height: 1.75;
}

.content :global(strong) {
	color: var(--text);
}

.content :global(a) {
	color: var(--primary-light);
	text-decoration: none;
	font-weight: 500;
}

.content :global(a:hover) {
	text-decoration: underline;
}

@media (max-width: 560px) {

	.content {
		padding-left: 18px;
	}
}

</style>
