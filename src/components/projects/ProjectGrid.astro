---
import T from "../T.astro";
import SectionHeader from "../SectionHeader.astro";

const areas = [
	{
		icon: "💻",
		title: { es: "Ingeniería de software", en: "Software Engineering" },
		text: {
			es: "Herramientas y aplicaciones internas, centradas en automatización y productividad.",
			en: "Internal tools and applications, focused on automation and developer productivity.",
		},
		tags: ["TypeScript", "Python"],
	},
	{
		icon: "⛏️",
		title: { es: "Desarrollo de Minecraft", en: "Minecraft Development" },
		text: {
			es: "Plugins, configuración de servidores y sistemas a medida sobre la Paper API — la misma base con la que construimos TimeEconomyPlugin.",
			en: "Plugins, server setup and custom systems built on the Paper API — the same foundation behind TimeEconomyPlugin.",
		},
		tags: ["Java", "Paper API"],
	},
	{
		icon: "🎮",
		title: { es: "Desarrollo de videojuegos", en: "Game Development" },
		text: {
			es: "Prototipado y experimentación con mecánicas de juego, explorando ideas antes de convertirlas en proyectos concretos.",
			en: "Prototyping and experimenting with game mechanics, exploring ideas before they become concrete projects.",
		},
		tags: ["Unity", "C#"],
	},
	{
		icon: "🧪",
		title: { es: "Tecnología experimental", en: "Experimental Technology" },
		text: {
			es: "Pruebas de nuevas ideas y enfoques técnicos que pueden convertirse en proyectos concretos en el futuro.",
			en: "Testing new ideas and technical approaches that may become concrete projects in the future.",
		},
		tags: [],
	},
];
---

<section class="section">

	<div class="container">

		<SectionHeader
			index="02"
			eyebrow={{ es: "Áreas de desarrollo", en: "Development areas" }}
			title={{ es: "En qué trabajamos.", en: "What we work on." }}
		>
			<T
				es="Estas no son proyectos individuales, sino las áreas de desarrollo en las que trabaja SpectroDinner Studios. Nuestros proyectos concretos, como TimeEconomyPlugin, nacen dentro de estas áreas."
				en="These aren't individual projects — they're the development areas SpectroDinner Studios works in. Our concrete projects, like TimeEconomyPlugin, are built within these areas."
			/>
		</SectionHeader>

		<div class="grid">

			{areas.map((area, i) => (
				<article class="hud-card interactive reveal" style={`--reveal-delay:${i * 70}ms`}>

					<span class="icon-tile">{area.icon}</span>

					<h3><T {...area.title} /></h3>

					<p><T {...area.text} /></p>

					<div class="chips">
						{area.tags.map((tag) => <span class="chip">{tag}</span>)}
						{area.tags.length === 0 && (
							<>
								<span class="chip"><T es="Prototipos" en="Prototypes" /></span>
								<span class="chip"><T es="Investigación" en="R&D" /></span>
							</>
						)}
					</div>

				</article>
			))}

		</div>

	</div>

</section>

<style>

.grid {
	display: grid;
	grid-template-columns: repeat(2, 1fr);
	gap: 18px;
}

.hud-card {
	display: flex;
	flex-direction: column;
	gap: 14px;
}

h3 {
	font-size: 1.3rem;
	font-weight: 600;
}

p {
	flex-grow: 1;
	color: var(--text-muted);
	line-height: 1.7;
}

@media (max-width: 760px) {

	.grid {
		grid-template-columns: 1fr;
	}
}

</style>
