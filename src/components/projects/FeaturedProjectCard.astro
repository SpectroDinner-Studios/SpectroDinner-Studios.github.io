---
import ProjectStatus from "./ProjectStatus.astro";
---

<section class="flagship">

	<div class="container">


		<span class="eyebrow reveal">
			<span data-lang="es">PROYECTO PRINCIPAL</span>
			<span data-lang="en">FLAGSHIP PROJECT</span>
		</span>


		<div class="card reveal spotlight">


			<div class="preview">

				<img
					src="/TEP.png"
					alt="TimeEconomyPlugin Preview"
					class="TEP"
				/>

				<div class="status">
					<ProjectStatus status="in-development" />
				</div>

			</div>



			<div class="info">

				<h2>
					TimeEconomyPlugin
				</h2>


				<p>
					<span data-lang="es">
						Un plugin de Minecraft a gran escala construido
						con la Paper API, que introduce una economía
						basada en tiempo y un sistema de progresión
						sobre mecánicas de juego personalizadas y
						funciones avanzadas del lado del servidor.
						Diseñado para el rendimiento, la escalabilidad
						y el mantenimiento a largo plazo.
					</span>
					<span data-lang="en">
						A large-scale Minecraft plugin built with the
						Paper API, introducing a time-based economy and
						progression system on top of custom gameplay
						mechanics and advanced server-side features.
						Designed for performance, scalability and
						long-term maintainability.
					</span>
				</p>


				<div class="tags">

					<span>Java</span>

					<span>Paper API</span>

					<span>Minecraft</span>

					<span>Plugin Development</span>

				</div>


				<div class="buttons">

					<a
						href="https://github.com/elmoderador"
						target="_blank"
						rel="noopener noreferrer"
						class="primary"
					>
						<span data-lang="es">Perfil de GitHub ↗</span>
						<span data-lang="en">GitHub Profile ↗</span>
					</a>

					<a
						href="/documentation"
						class="secondary"
					>
						<span data-lang="es">Documentación</span>
						<span data-lang="en">Documentation</span>
					</a>

				</div>

			</div>


		</div>


	</div>

</section>



<style>

.flagship {

	padding:100px 32px 0;

}



.container {

	max-width:1200px;

	margin:auto;

}



.eyebrow {

	display:block;

	font-size:.85rem;

	letter-spacing:3px;

	color:var(--primary);

	font-weight:700;

	margin-bottom:30px;

}



.card {

	display:grid;

	grid-template-columns:1fr 1fr;

	gap:50px;

	padding:50px;

	border-radius:30px;

	background:

		var(--surface-1);

	border:

		1px solid

		var(--border-1);

	backdrop-filter:

		blur(20px);

}



.preview {

	position:relative;

	display:flex;

	align-items:center;

	justify-content:center;

	min-width:0;

}



.preview img {

	width:75%;

	max-height:280px;

	object-fit:contain;

	border-radius:18px;

	box-shadow:

		0 15px 40px

		var(--shadow-color);

}



.status {

	position:absolute;

	bottom:10px;

	left:50%;

	transform:translateX(-50%);

}



.info {

	min-width:0;

}



.info h2 {

	margin:0 0 20px;

	font-size:2.2rem;

	color:var(--text);

	letter-spacing:-1px;

}



.info p {

	color:var(--text-muted);

	line-height:1.8;

}



.tags {

	display:flex;

	flex-wrap:wrap;

	gap:12px;

	margin-top:30px;

}



.tags span {

	padding:8px 16px;

	border-radius:999px;

	background:

		var(--primary-bg);

	color:var(--primary-light);

	font-size:.9rem;

}



.buttons {

	display:flex;

	gap:15px;

	margin-top:40px;

}



.buttons a {

	padding:14px 28px;

	border-radius:14px;

	text-decoration:none;

	font-weight:600;

	transition:.25s ease;

}



.primary {

	background:var(--primary);

	color:white;

}



.primary:hover {

	transform:translateY(-3px);

	box-shadow:

		0 15px 40px

		var(--primary-glow);

}



.secondary {

	border:

		1px solid

		var(--border-2);

	color:var(--text);

}



.secondary:hover {

	background:

		var(--surface-3);

	transform:translateY(-3px);

}



@media(max-width:900px) {

	.card {

		grid-template-columns:1fr;

		padding:30px;

	}

	.buttons {

		flex-direction:column;

	}

	.preview img {

		width:90%;

	}

}

</style>
