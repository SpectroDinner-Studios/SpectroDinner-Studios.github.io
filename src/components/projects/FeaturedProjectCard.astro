---
import { Image } from "astro:assets";
import tepLogo from "../../assets/tep.png";
import T from "../T.astro";
import ProjectStatus from "./ProjectStatus.astro";
---

<article class="project hud-card gold interactive reveal">

	<a href="/tep" class="preview" tabindex="-1" aria-hidden="true">
		<Image src={tepLogo} alt="" widths={[280, 560]} sizes="280px" class="tep" />
	</a>

	<div class="info">

		<div class="meta">
			<span class="code">PRJ-001</span>
			<ProjectStatus status="reviving" />
		</div>

		<h3>
			<a href="/tep">TimeEconomy<span>Plugin</span></a>
		</h3>

		<p>
			<T
				es="Un plugin de Minecraft a gran escala construido con la Paper API, que introduce una economía basada en tiempo y un sistema de progresión sobre mecánicas de juego personalizadas y funciones avanzadas del lado del servidor."
				en="A large-scale Minecraft plugin built with the Paper API, introducing a time-based economy and progression system on top of custom gameplay mechanics and advanced server-side features."
			/>
		</p>

		<div class="chips">
			<span class="chip">Java</span>
			<span class="chip">Paper API</span>
			<span class="chip">Minecraft</span>
			<span class="chip"><T es="Plugin" /></span>
		</div>

		<div class="actions">
			<a href="/tep" class="btn btn-gold btn-sm">
				<T es="Ver T.E.P." en="View T.E.P." /> →
			</a>
			<a
				href="https://github.com/elmoderador"
				target="_blank"
				rel="noopener noreferrer"
				class="btn btn-ghost btn-sm"
			>
				GitHub ↗
			</a>
		</div>

	</div>

</article>

<style>

.project {
	display: grid;
	grid-template-columns: 260px 1fr;
	align-items: center;
	gap: 36px;

	padding: 32px;
}

.preview {
	display: grid;
	place-items: center;

	aspect-ratio: 1;

	background:
		radial-gradient(circle, color-mix(in srgb, var(--gold) 22%, transparent), transparent 70%),
		var(--bg-sunken);
	border: 1px solid var(--gold-border);
	border-radius: var(--radius-xs);
}

.tep {
	width: 92%;
	height: auto;
	filter: drop-shadow(0 10px 24px rgba(0, 0, 0, .5));
	transition: transform .5s cubic-bezier(.2, .8, .2, 1);
}

.project:hover .tep {
	transform: scale(1.04) rotate(-2deg);
}

.info {
	display: flex;
	flex-direction: column;
	gap: 16px;
}

.meta {
	display: flex;
	align-items: center;
	gap: 12px;
}

.code {
	font-family: var(--font-pixel);
	font-size: .72rem;
	letter-spacing: .06em;
	color: var(--text-dim);
}

h3 {
	font-size: clamp(1.7rem, 3vw, 2.3rem);
	font-weight: 700;
}

h3 a {
	text-decoration: none;
}

h3 span {
	color: var(--gold-text);
}

p {
	color: var(--text-muted);
	line-height: 1.75;
}

@media (max-width: 760px) {

	.project {
		grid-template-columns: 1fr;
		padding: 24px;
	}

	.preview {
		max-width: 220px;
	}
}

</style>
