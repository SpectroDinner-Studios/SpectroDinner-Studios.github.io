---
import T from "../T.astro";

export type Status = "released" | "active" | "in-development" | "experimental" | "planned" | "archived";

interface Props {
	status: Status;
}

const { status } = Astro.props;

const labels: Record<Status, { es: string; en: string }> = {
	released: { es: "Publicado", en: "Released" },
	active: { es: "Activo", en: "Active" },
	"in-development": { es: "En desarrollo", en: "In development" },
	experimental: { es: "Experimental", en: "Experimental" },
	planned: { es: "Planeado", en: "Planned" },
	archived: { es: "Archivado", en: "Archived" },
};
---

<span class={`project-status status-${status}`}>
	<span class="dot" aria-hidden="true"></span>
	<T {...labels[status]} />
</span>

<style>

.project-status {
	--status-color: var(--primary);

	display: inline-flex;
	align-items: center;
	gap: 8px;

	padding: 5px 10px;

	font-family: var(--font-pixel);
	font-size: .7rem;
	letter-spacing: .05em;
	text-transform: uppercase;
	color: var(--status-color);

	background: color-mix(in srgb, var(--status-color) 12%, var(--bg-elevated));
	border: 1px solid color-mix(in srgb, var(--status-color) 40%, transparent);
	border-radius: 2px;
}

.dot {
	width: 7px;
	height: 7px;
	background: var(--status-color);
	box-shadow: 0 0 8px var(--status-color);
	animation: statusBlink 2.4s steps(2, jump-none) infinite;
}

.status-released,
.status-active { --status-color: var(--emerald); }
.status-in-development { --status-color: var(--gold); }
.status-experimental { --status-color: var(--violet); }
.status-planned { --status-color: var(--primary-light); }
.status-archived { --status-color: var(--text-dim); }

</style>
