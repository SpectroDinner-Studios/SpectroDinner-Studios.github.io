---
import LangToggle from "./LangToggle.astro";
import SettingsPanel from "./SettingsPanel.astro";
import T from "./T.astro";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const links = [
	{ href: "/projects", es: "Proyectos", en: "Projects" },
	{ href: "/tep", es: "T.E.P.", en: "T.E.P.", gold: true },
	{ href: "/documentation", es: "Documentación", en: "Docs" },
	{ href: "/about", es: "Nosotros", en: "About" },
	{ href: "/voluntariado", es: "Voluntariado", en: "Volunteer" },
];

const onQuestionnaire = path.startsWith("/cuestionario");
---

<header class="navbar">

	<div class="nav-inner">

		<a href="/" class="brand" aria-label="SpectroDinner™">

			<img src="/logo.png" alt="" width="36" height="36" class="logo" />

			<span class="wordmark">
				SPECTRO<span>DINNER</span><sup>™</sup>
			</span>

		</a>

		<nav class="links" aria-label="Principal / Main">

			{links.map((link) => (
				<a
					href={link.href}
					class:list={["nav-link", { gold: link.gold }]}
					aria-current={path === link.href ? "page" : undefined}
				>
					<T es={link.es} en={link.en} />
					{link.gold && <span class="gold-dot" aria-hidden="true"></span>}
				</a>
			))}

			<a
				href="https://github.com/elmoderador"
				class="nav-link"
				target="_blank"
				rel="noopener noreferrer"
			>
				GitHub ↗
			</a>

			<div class="cta-dropdown">

				<button
					type="button"
					class:list={["cta", "cta-toggle", { current: onQuestionnaire }]}
					aria-expanded="false"
				>
					<T es="Cuestionario" en="Questionnaire" />
					<span class="caret" aria-hidden="true">▾</span>
				</button>

				<div class="cta-panel">

					<a href="/cuestionario">
						<span class="cta-panel-icon">💬</span>
						<span class="cta-panel-text">
							<strong><T es="Servicio de Discord" en="Discord Service" /></strong>
							<small><T es="Crear, configurar o rediseñar" en="Create, configure or redesign" /></small>
						</span>
					</a>

					<a href="/cuestionario-minecraft">
						<span class="cta-panel-icon">⛏️</span>
						<span class="cta-panel-text">
							<strong><T es="Servicio de Minecraft" en="Minecraft Service" /></strong>
							<small><T es="Permisos, rangos y optimización" en="Permissions, ranks and optimization" /></small>
						</span>
					</a>

				</div>

			</div>

		</nav>

		<div class="tools">

			<a href="/entrar/" class="account-link" data-account-link>
				<span class="account-icon" aria-hidden="true">👤</span>
				<span class="account-text" data-account-out><T es="Entrar" en="Sign in" /></span>
				<span class="account-text" data-account-in hidden><T es="Mi cuenta" en="My account" /></span>
				<span class="account-badge" data-account-badge hidden></span>
			</a>

			<LangToggle />

			<SettingsPanel />

			<button type="button" class="menu-toggle" aria-label="Menu" aria-expanded="false">
				<span></span>
				<span></span>
				<span></span>
			</button>

		</div>

	</div>

</header>

<script>
	import { ACCOUNT_ORIGIN, signedInHint } from "../scripts/account";

	// "Entrar" or "Mi cuenta" (with a dot for unread replies). Accounts live on
	// the Cloudflare site, so the GitHub Pages copy links there.
	const accountLink = document.querySelector<HTMLAnchorElement>("[data-account-link]");
	if (accountLink) {
		const base = location.hostname.endsWith(".github.io") ? ACCOUNT_ORIGIN : "";
		accountLink.href = base + "/entrar/";

		if (signedInHint()) {
			const setSignedIn = (signedIn: boolean) => {
				accountLink.href = base + (signedIn ? "/cuenta/" : "/entrar/");
				accountLink.querySelector<HTMLElement>("[data-account-out]")!.hidden = signedIn;
				accountLink.querySelector<HTMLElement>("[data-account-in]")!.hidden = !signedIn;
			};
			setSignedIn(true);

			fetch("/api/auth/me", { credentials: "same-origin", cache: "no-store" })
				.then((res) => (res.ok ? res.json() : null))
				.then((data) => {
					if (!data) return;
					if (!data.user) return setSignedIn(false);
					const badge = accountLink.querySelector<HTMLElement>("[data-account-badge]")!;
					badge.textContent = String(data.user.unread);
					badge.hidden = !data.user.unread;
				})
				.catch(() => {});
		}
	}

	const toggle = document.querySelector(".navbar .menu-toggle");
	const links = document.querySelector(".navbar .links");

	const closeMenu = () => {
		links?.classList.remove("open");
		toggle?.classList.remove("active");
		toggle?.setAttribute("aria-expanded", "false");
	};

	toggle?.addEventListener("click", () => {
		const isOpen = links?.classList.toggle("open");
		toggle.classList.toggle("active", !!isOpen);
		toggle.setAttribute("aria-expanded", String(!!isOpen));
	});

	links?.querySelectorAll("a").forEach((a) => {
		a.addEventListener("click", closeMenu);
	});

	const ctaToggle = document.querySelector<HTMLButtonElement>(".cta-toggle");
	const ctaPanel = document.querySelector<HTMLElement>(".cta-panel");

	const closeCta = () => {
		ctaPanel?.classList.remove("open");
		ctaToggle?.setAttribute("aria-expanded", "false");
	};

	ctaToggle?.addEventListener("click", (e) => {
		e.stopPropagation();
		const isOpen = ctaPanel?.classList.toggle("open");
		ctaToggle.setAttribute("aria-expanded", String(!!isOpen));
	});

	document.addEventListener("click", (e) => {
		if (
			ctaPanel &&
			!ctaPanel.contains(e.target as Node) &&
			!ctaToggle?.contains(e.target as Node)
		) {
			closeCta();
		}
	});

	document.addEventListener("keydown", (e) => {
		if (e.key !== "Escape") return;
		closeCta();
		closeMenu();
	});
</script>

<style>

.navbar {
	position: fixed;
	top: 0;
	left: 0;
	right: 0;
	z-index: 50;

	height: var(--header-h);

	border-bottom: 1px solid transparent;

	transition:
		background var(--transition),
		border-color var(--transition),
		backdrop-filter var(--transition);
}

.navbar.scrolled {
	background: color-mix(in srgb, var(--background) 78%, transparent);
	border-bottom-color: var(--border-1);
	backdrop-filter: blur(16px) saturate(1.2);
}

.navbar.scrolled::after {
	content: "";
	position: absolute;
	left: 0;
	right: 0;
	bottom: -1px;
	height: 1px;
	background: linear-gradient(90deg, transparent, var(--primary), var(--primary-2), transparent);
	opacity: .6;
}

.nav-inner {
	display: flex;
	align-items: center;
	gap: 24px;

	height: 100%;
	max-width: 1320px;
	margin: 0 auto;
	padding: 0 28px;
}


/* Brand */

.brand {
	display: flex;
	align-items: center;
	gap: 12px;

	text-decoration: none;
	flex-shrink: 0;
}

.logo {
	width: 36px;
	height: 36px;
	filter: drop-shadow(0 0 10px var(--primary-glow));
	transition: transform .6s cubic-bezier(.2, .8, .2, 1);
}

.brand:hover .logo {
	transform: rotate(90deg);
}

.wordmark {
	font-family: var(--font-display);
	font-size: 1.12rem;
	font-weight: 700;
	letter-spacing: .06em;
	color: var(--text);
}

.wordmark span {
	color: var(--primary-light);
}

.wordmark sup {
	font-size: .55em;
	color: var(--text-dim);
	margin-left: 1px;
}


/* Links */

.links {
	display: flex;
	align-items: center;
	gap: 4px;

	margin-left: auto;
}

.nav-link {
	position: relative;

	display: inline-flex;
	align-items: center;
	gap: 7px;

	padding: 9px 12px;

	font-size: .93rem;
	font-weight: 500;
	text-decoration: none;
	color: var(--text-muted);

	border-radius: var(--radius-xs);

	transition:
		color var(--transition),
		background var(--transition);
}

.nav-link::after {
	content: "";
	position: absolute;
	left: 12px;
	right: 12px;
	bottom: 3px;
	height: 2px;
	background: var(--primary);
	transform: scaleX(0);
	transform-origin: left;
	transition: transform var(--transition);
}

.nav-link:hover {
	color: var(--text);
	background: var(--surface-1);
}

.nav-link:hover::after,
.nav-link[aria-current="page"]::after {
	transform: scaleX(1);
}

.nav-link[aria-current="page"] {
	color: var(--text);
}

.nav-link.gold::after {
	background: var(--gold);
}

.gold-dot {
	width: 6px;
	height: 6px;
	background: var(--gold);
	box-shadow: 0 0 8px var(--gold);
}


/* Questionnaire dropdown */

.cta-dropdown {
	position: relative;
	margin-left: 8px;
}

.cta {
	display: inline-flex;
	align-items: center;
	gap: 8px;

	min-height: 40px;
	padding: 0 16px;

	font-family: var(--font-display);
	font-size: .93rem;
	font-weight: 600;
	color: #FFFFFF;

	background: linear-gradient(135deg, var(--primary), var(--primary-2));
	border: 0;

	cursor: pointer;

	clip-path: polygon(9px 0, 100% 0, 100% calc(100% - 9px), calc(100% - 9px) 100%, 0 100%, 0 9px);
	box-shadow:
		inset 0 2px 0 rgba(255, 255, 255, .16),
		inset 0 -3px 0 rgba(0, 0, 0, .3);

	transition:
		filter var(--transition),
		transform var(--transition);
}

.cta:hover {
	filter: brightness(1.12);
	transform: translateY(-1px);
}

.cta:focus-visible {
	clip-path: none;
}

.caret {
	font-size: .8em;
	transition: transform var(--transition);
}

.cta[aria-expanded="true"] .caret {
	transform: rotate(180deg);
}

.cta-panel {
	position: absolute;
	top: calc(100% + 12px);
	right: 0;

	display: flex;
	flex-direction: column;
	gap: 4px;

	width: 290px;
	padding: 8px;

	background: var(--bg-elevated);
	border: 1px solid var(--border-2);
	border-radius: var(--radius-sm);
	box-shadow: 0 24px 60px var(--shadow-color);

	opacity: 0;
	visibility: hidden;
	transform: translateY(-6px);

	transition:
		opacity .2s ease,
		transform .2s ease,
		visibility .2s;
}

.cta-panel.open {
	opacity: 1;
	visibility: visible;
	transform: none;
}

.cta-panel a {
	display: flex;
	align-items: center;
	gap: 12px;

	padding: 10px 12px;

	text-decoration: none;
	color: var(--text);

	border: 1px solid transparent;
	border-radius: var(--radius-xs);

	transition:
		background var(--transition),
		border-color var(--transition);
}

.cta-panel a:hover {
	background: var(--primary-bg);
	border-color: var(--primary-border);
}

.cta-panel-icon {
	display: grid;
	place-items: center;
	flex-shrink: 0;

	width: 38px;
	height: 38px;

	font-size: 1.15rem;

	background: var(--surface-2);
	border: 1px solid var(--border-1);
	border-radius: var(--radius-xs);
}

.cta-panel-text {
	display: flex;
	flex-direction: column;
	gap: 2px;
}

.cta-panel-text strong {
	font-size: .93rem;
	font-weight: 600;
}

.cta-panel-text small {
	font-size: .8rem;
	color: var(--text-dim);
}


/* Tools */

.tools {
	display: flex;
	align-items: center;
	gap: 8px;
	flex-shrink: 0;
}

.account-link {
	position: relative;
	display: inline-flex;
	align-items: center;
	gap: 8px;

	height: 42px;
	padding: 0 12px;

	font-family: var(--font-display);
	font-size: .9rem;
	font-weight: 600;
	color: var(--text-muted);
	text-decoration: none;

	background: var(--surface-2);
	border: 1px solid var(--border-2);
	border-radius: var(--radius-xs);

	transition:
		border-color var(--transition),
		background var(--transition),
		color var(--transition);
}

.account-link:hover {
	color: var(--text);
	border-color: var(--primary-border);
	background: var(--primary-bg);
}

.account-link [hidden] {
	display: none;
}

.account-badge {
	position: absolute;
	top: -6px;
	right: -6px;

	min-width: 18px;
	height: 18px;
	padding: 0 5px;

	font-family: var(--font-pixel);
	font-size: .62rem;
	line-height: 18px;
	text-align: center;
	color: #fff;

	background: var(--primary);
	border-radius: 9px;
	box-shadow: 0 0 10px var(--primary);
}


/* Mobile menu toggle */

.menu-toggle {
	display: none;

	flex-direction: column;
	justify-content: center;
	gap: 5px;

	width: 42px;
	height: 42px;
	padding: 0 11px;

	background: var(--surface-2);
	border: 1px solid var(--border-2);
	border-radius: var(--radius-xs);

	cursor: pointer;
}

.menu-toggle span {
	display: block;
	height: 2px;
	background: var(--text);
	transition:
		transform var(--transition),
		opacity var(--transition);
}

.menu-toggle.active span:nth-child(1) {
	transform: translateY(7px) rotate(45deg);
}

.menu-toggle.active span:nth-child(2) {
	opacity: 0;
}

.menu-toggle.active span:nth-child(3) {
	transform: translateY(-7px) rotate(-45deg);
}


@media (max-width: 1100px) {

	.nav-inner {
		gap: 12px;
		padding: 0 20px;
	}

	.tools {
		margin-left: auto;
	}

	.menu-toggle {
		display: flex;
	}

	.links {
		position: absolute;
		top: calc(var(--header-h) - 1px);
		left: 0;
		right: 0;

		flex-direction: column;
		align-items: stretch;
		gap: 2px;

		max-height: calc(100vh - var(--header-h));
		overflow-y: auto;

		margin: 0;
		padding: 14px 20px 22px;

		background: var(--bg-elevated);
		border-bottom: 1px solid var(--border-2);
		box-shadow: 0 30px 60px var(--shadow-color);

		opacity: 0;
		visibility: hidden;
		transform: translateY(-8px);

		transition:
			opacity .2s ease,
			transform .2s ease,
			visibility .2s;
	}

	.links.open {
		opacity: 1;
		visibility: visible;
		transform: none;
	}

	.nav-link {
		padding: 13px 12px;
		font-size: 1rem;
	}

	.nav-link::after {
		left: 0;
		right: auto;
		top: 10px;
		bottom: 10px;
		width: 3px;
		height: auto;
		transform: scaleY(0);
	}

	.nav-link:hover::after,
	.nav-link[aria-current="page"]::after {
		transform: scaleY(1);
	}

	.cta-dropdown {
		margin: 10px 0 0;
	}

	.cta {
		width: 100%;
		justify-content: center;
		min-height: 46px;
	}

	.cta-panel {
		position: static;
		width: 100%;
		margin-top: 8px;
		display: none;
		box-shadow: none;
	}

	.cta-panel.open {
		display: flex;
	}
}

@media (max-width: 480px) {

	.nav-inner {
		padding: 0 14px;
		gap: 10px;
	}

	.account-link {
		padding: 0 10px;
	}

	.account-text {
		display: none;
	}

	.brand {
		gap: 10px;
	}

	.logo {
		width: 32px;
		height: 32px;
	}

	.wordmark {
		font-size: .92rem;
		letter-spacing: .03em;
	}

	.wordmark sup {
		display: none;
	}

	.tools {
		gap: 6px;
	}
}

</style>
