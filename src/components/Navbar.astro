---
import LangToggle from "./LangToggle.astro";
import SettingsPanel from "./SettingsPanel.astro";
---

<nav class="navbar">

	<a href="/" class="brand">

		<img src="/logo.png" alt="SpectroDinner Logo" class="logo"/>

		<span>
			SpectroDinner™
		</span>

	</a>


	<button type="button" class="menu-toggle" aria-label="Menu" aria-expanded="false">
		<span></span>
		<span></span>
		<span></span>
	</button>


	<div class="links">

		<a href="/">
			<span data-lang="es">Inicio</span>
			<span data-lang="en">Home</span>
		</a>


		<a href="/projects">
			<span data-lang="es">Proyectos</span>
			<span data-lang="en">Projects</span>
		</a>


		<a href="/documentation">
			<span data-lang="es">Documentación</span>
			<span data-lang="en">Documentation</span>
		</a>


		<a href="/about">
			<span data-lang="es">Sobre Nosotros</span>
			<span data-lang="en">About</span>
		</a>


		<a href="/voluntariado">
			<span data-lang="es">Voluntariado</span>
			<span data-lang="en">Volunteer</span>
		</a>


		<a
			href="https://github.com/elmoderador"
			class="github"
			target="_blank"
			rel="noopener noreferrer"
		>
			GitHub ↗
		</a>


		<div class="cta-dropdown">

			<button type="button" class="cta cta-toggle" aria-expanded="false">
				<span data-lang="es">Cuestionario</span>
				<span data-lang="en">Questionnaire</span>
				<span class="caret">▾</span>
			</button>

			<div class="cta-panel">

				<a href="/cuestionario">
					<span class="cta-panel-icon">💬</span>
					<span data-lang="es">Servicio de Discord</span>
					<span data-lang="en">Discord Service</span>
				</a>

				<a href="/cuestionario-minecraft">
					<span class="cta-panel-icon">⛏️</span>
					<span data-lang="es">Servicio de Minecraft</span>
					<span data-lang="en">Minecraft Service</span>
				</a>

			</div>

		</div>


		<LangToggle />

		<SettingsPanel />

	</div>

</nav>


<script>
	const toggle = document.querySelector(".navbar .menu-toggle");
	const links = document.querySelector(".navbar .links");

	const closeMenu = () => {
		links?.classList.remove("open");
		toggle?.classList.remove("active");
		toggle?.setAttribute("aria-expanded", "false");
	};

	toggle?.addEventListener("click", () => {
		const isOpen = links?.classList.toggle("open");
		toggle.classList.toggle("active", !!isOpen);
		toggle.setAttribute("aria-expanded", String(!!isOpen));
	});

	links?.querySelectorAll("a").forEach((a) => {
		a.addEventListener("click", closeMenu);
	});


	const ctaToggle = document.querySelector<HTMLButtonElement>(".cta-toggle");
	const ctaPanel = document.querySelector<HTMLElement>(".cta-panel");

	const closeCta = () => {
		ctaPanel?.classList.remove("open");
		ctaToggle?.setAttribute("aria-expanded", "false");
	};

	ctaToggle?.addEventListener("click", (e) => {
		e.stopPropagation();
		const isOpen = ctaPanel?.classList.toggle("open");
		ctaToggle.setAttribute("aria-expanded", String(!!isOpen));
	});

	document.addEventListener("click", (e) => {
		if (
			ctaPanel &&
			!ctaPanel.contains(e.target as Node) &&
			!ctaToggle?.contains(e.target as Node)
		) {
			closeCta();
		}
	});
</script>


<style>

.navbar {

	max-width:1400px;

	margin:24px auto;

	padding:20px 32px;


	display:flex;

	justify-content:space-between;

	align-items:center;


	background:
		var(--surface-2);


	border:
		1px solid
		var(--border-2);


	border-radius:18px;


	backdrop-filter:
		blur(15px);


	box-shadow:
		0 10px 40px
		var(--shadow-color);


	position:sticky;

	top:16px;

	z-index:100;


	transition:
		background .3s ease,
		box-shadow .3s ease,
		border-color .3s ease;

}



.navbar.scrolled {

	background:
		color-mix(in srgb, var(--bg-elevated) 75%, transparent);


	border-color:
		var(--border-3);


	box-shadow:
		0 15px 45px
		var(--shadow-color);

}



.brand {

	display:flex;

	align-items:center;

	gap:14px;


	color:var(--text);

	text-decoration:none;


	font-weight:700;

	font-size:1.2rem;


	transition:.25s ease;

}



.brand:hover {

	transform:
		translateY(-2px);

}



.brand img {

	width:44px;

	height:44px;


	object-fit:contain;


	border-radius:12px;


	transition:.25s ease;

}



.brand:hover img {

	filter:
		drop-shadow(
			0 0 12px
			color-mix(in srgb, var(--primary) 60%, transparent)
		);

}



.links {

	display:flex;

	align-items:center;

	gap:16px;

}



.links a {

	text-decoration:none;

	color:var(--text-muted);


	font-weight:500;


	transition:.25s ease;

}



.links a:hover {

	color:var(--primary);

}



.github {

	color:var(--text-muted);


	font-weight:500;

}



.github:hover {

	color:var(--primary);

}



.cta-dropdown {

	position:relative;

}



.cta {

	display:flex;

	align-items:center;

	gap:6px;


	padding:
		10px 18px;


	background:
		var(--primary);


	border:none;


	border-radius:
		12px;


	color:white !important;


	font-weight:600 !important;

	font-family:inherit;

	font-size:1rem;

	cursor:pointer;

	transition:.25s ease;

}



.cta:hover {

	background:
		var(--primary-hover);


	transform:
		translateY(-2px);


	box-shadow:
		0 10px 25px
		var(--primary-glow);

}



.caret {

	font-size:.75rem;

	transition:transform .25s ease;

}



.cta-toggle[aria-expanded="true"] .caret {

	transform:rotate(180deg);

}



.cta-panel {

	position:absolute;

	top:calc(100% + 12px);

	right:0;

	width:240px;

	padding:10px;

	display:flex;

	flex-direction:column;

	gap:6px;

	border-radius:16px;

	background:var(--bg-elevated);

	border:1px solid var(--border-2);

	backdrop-filter:blur(20px);

	box-shadow:0 20px 50px var(--shadow-color);

	opacity:0;

	visibility:hidden;

	transform:translateY(-8px);

	transition:opacity .25s ease, transform .25s ease, visibility .25s;

	pointer-events:none;

	z-index:200;

}



.cta-panel.open {

	opacity:1;

	visibility:visible;

	transform:none;

	pointer-events:auto;

}



.cta-panel a {

	display:flex;

	align-items:center;

	gap:10px;

	padding:12px 14px;

	border-radius:10px;

	color:var(--text) !important;

	font-weight:600 !important;

	text-decoration:none;

	transition:.2s ease;

}



.cta-panel a:hover {

	background:var(--surface-hover);

	color:var(--primary) !important;

}



.cta-panel-icon {

	font-size:1.05rem;

}



.menu-toggle {

	display:none;

	flex-direction:column;

	justify-content:center;

	align-items:center;

	gap:5px;


	width:38px;

	height:38px;


	background:
		var(--surface-2);


	border:
		1px solid
		var(--border-2);


	border-radius:10px;


	cursor:pointer;

}



.menu-toggle span {

	width:18px;

	height:2px;

	border-radius:999px;

	background:var(--text);

	transition:.3s ease;

}



.menu-toggle.active span:nth-child(1) {

	transform:translateY(7px) rotate(45deg);

}



.menu-toggle.active span:nth-child(2) {

	opacity:0;

}



.menu-toggle.active span:nth-child(3) {

	transform:translateY(-7px) rotate(-45deg);

}



@media(max-width:1100px) {


	.navbar {

		margin:15px;

		padding:14px 18px;

	}



	.menu-toggle {

		display:flex;

	}



	.links {

		position:absolute;

		top:calc(100% + 12px);

		left:0;

		right:0;


		flex-direction:column;

		align-items:stretch;

		gap:14px;


		padding:22px;


		background:
			color-mix(in srgb, var(--bg-elevated) 95%, transparent);


		border:
			1px solid
			var(--border-2);


		border-radius:18px;


		backdrop-filter:
			blur(20px);


		opacity:0;

		visibility:hidden;

		transform:translateY(-10px);


		transition:
			opacity .25s ease,
			transform .25s ease,
			visibility .25s;


		pointer-events:none;

	}



	.links.open {

		opacity:1;

		visibility:visible;

		transform:none;

		pointer-events:auto;

	}



	.links a {

		text-align:center;

		padding:10px 0;

	}



	.brand {

		font-size:1.1rem;

	}



	.cta-panel {

		right:auto;

		left:50%;

		transform:translate(-50%,-8px);

	}



	.cta-panel.open {

		transform:translate(-50%,0);

	}

}


</style>