---
import LangToggle from "./LangToggle.astro";
import SettingsPanel from "./SettingsPanel.astro";
---

<nav class="navbar">

	<a href="/" class="brand">

		<img src="/logo.png" alt="SpectroDinner Logo" class="logo"/>

		<span>
			SpectroDinner™
		</span>

	</a>


	<button type="button" class="menu-toggle" aria-label="Menu" aria-expanded="false">
		<span></span>
		<span></span>
		<span></span>
	</button>


	<div class="links">

		<a href="/">
			<span data-lang="es">Inicio</span>
			<span data-lang="en">Home</span>
		</a>


		<a href="/projects">
			<span data-lang="es">Proyectos</span>
			<span data-lang="en">Projects</span>
		</a>


		<a href="/documentation">
			<span data-lang="es">Documentación</span>
			<span data-lang="en">Documentation</span>
		</a>


		<a href="/about">
			<span data-lang="es">Sobre Nosotros</span>
			<span data-lang="en">About</span>
		</a>


		<a
			href="https://github.com/elmoderador"
			class="github"
			target="_blank"
			rel="noopener noreferrer"
		>
			GitHub ↗
		</a>


		<a href="/cuestionario" class="cta">
			<span data-lang="es">Cuestionario →</span>
			<span data-lang="en">Questionnaire →</span>
		</a>


		<LangToggle />

		<SettingsPanel />

	</div>

</nav>


<script>
	const toggle = document.querySelector(".navbar .menu-toggle");
	const links = document.querySelector(".navbar .links");

	const closeMenu = () => {
		links?.classList.remove("open");
		toggle?.classList.remove("active");
		toggle?.setAttribute("aria-expanded", "false");
	};

	toggle?.addEventListener("click", () => {
		const isOpen = links?.classList.toggle("open");
		toggle.classList.toggle("active", !!isOpen);
		toggle.setAttribute("aria-expanded", String(!!isOpen));
	});

	links?.querySelectorAll("a").forEach((a) => {
		a.addEventListener("click", closeMenu);
	});
</script>


<style>

.navbar {

	max-width:1400px;

	margin:24px auto;

	padding:20px 32px;


	display:flex;

	justify-content:space-between;

	align-items:center;


	background:
		var(--surface-2);


	border:
		1px solid
		var(--border-2);


	border-radius:18px;


	backdrop-filter:
		blur(15px);


	box-shadow:
		0 10px 40px
		var(--shadow-color);


	position:sticky;

	top:16px;

	z-index:100;


	transition:
		background .3s ease,
		box-shadow .3s ease,
		border-color .3s ease;

}



.navbar.scrolled {

	background:
		color-mix(in srgb, var(--bg-elevated) 75%, transparent);


	border-color:
		var(--border-3);


	box-shadow:
		0 15px 45px
		var(--shadow-color);

}



.brand {

	display:flex;

	align-items:center;

	gap:14px;


	color:var(--text);

	text-decoration:none;


	font-weight:700;

	font-size:1.2rem;


	transition:.25s ease;

}



.brand:hover {

	transform:
		translateY(-2px);

}



.brand img {

	width:44px;

	height:44px;


	object-fit:contain;


	border-radius:12px;


	transition:.25s ease;

}



.brand:hover img {

	filter:
		drop-shadow(
			0 0 12px
			color-mix(in srgb, var(--primary) 60%, transparent)
		);

}



.links {

	display:flex;

	align-items:center;

	gap:30px;

}



.links a {

	text-decoration:none;

	color:var(--text-muted);


	font-weight:500;


	transition:.25s ease;

}



.links a:hover {

	color:var(--primary);

}



.github {

	color:var(--text-muted);


	font-weight:500;

}



.github:hover {

	color:var(--primary);

}



.cta {

	padding:
		10px 18px;


	background:
		var(--primary);


	border-radius:
		12px;


	color:white !important;


	font-weight:600 !important;

}



.cta:hover {

	background:
		var(--primary-hover);


	transform:
		translateY(-2px);


	box-shadow:
		0 10px 25px
		var(--primary-glow);

}



.menu-toggle {

	display:none;

	flex-direction:column;

	justify-content:center;

	align-items:center;

	gap:5px;


	width:38px;

	height:38px;


	background:
		var(--surface-2);


	border:
		1px solid
		var(--border-2);


	border-radius:10px;


	cursor:pointer;

}



.menu-toggle span {

	width:18px;

	height:2px;

	border-radius:999px;

	background:var(--text);

	transition:.3s ease;

}



.menu-toggle.active span:nth-child(1) {

	transform:translateY(7px) rotate(45deg);

}



.menu-toggle.active span:nth-child(2) {

	opacity:0;

}



.menu-toggle.active span:nth-child(3) {

	transform:translateY(-7px) rotate(-45deg);

}



@media(max-width:768px) {


	.navbar {

		margin:15px;

		padding:14px 18px;

	}



	.menu-toggle {

		display:flex;

	}



	.links {

		position:absolute;

		top:calc(100% + 12px);

		left:0;

		right:0;


		flex-direction:column;

		align-items:stretch;

		gap:14px;


		padding:22px;


		background:
			color-mix(in srgb, var(--bg-elevated) 95%, transparent);


		border:
			1px solid
			var(--border-2);


		border-radius:18px;


		backdrop-filter:
			blur(20px);


		opacity:0;

		visibility:hidden;

		transform:translateY(-10px);


		transition:
			opacity .25s ease,
			transform .25s ease,
			visibility .25s;


		pointer-events:none;

	}



	.links.open {

		opacity:1;

		visibility:visible;

		transform:none;

		pointer-events:auto;

	}



	.links a {

		text-align:center;

		padding:10px 0;

	}



	.brand {

		font-size:1.1rem;

	}

}


</style>