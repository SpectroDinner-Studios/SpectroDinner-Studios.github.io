# Cloudflare Pages response headers (ignored by GitHub Pages).
# /admin and /api/admin/* get their private headers from the Functions.

/acceso
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Cache-Control: no-store

/acceso/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Cache-Control: no-store

# Account pages: never framed (no clickjacking of sign-in forms), cached or indexed.
/entrar
  X-Frame-Options: DENY
  X-Robots-Tag: noindex
  Referrer-Policy: same-origin
/entrar/*
  X-Frame-Options: DENY
  X-Robots-Tag: noindex
  Referrer-Policy: same-origin
/registro
  X-Frame-Options: DENY
  X-Robots-Tag: noindex
  Referrer-Policy: same-origin
/registro/*
  X-Frame-Options: DENY
  X-Robots-Tag: noindex
  Referrer-Policy: same-origin
/cuenta/*
  X-Frame-Options: DENY
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer
  Cache-Control: no-store
/invitacion
  X-Frame-Options: DENY
  X-Robots-Tag: noindex
  Referrer-Policy: no-referrer
/invitacion/*
  X-Frame-Options: DENY
  X-Robots-Tag: noindex
  Referrer-Policy: no-referrer
/juegos
  X-Frame-Options: DENY
/juegos/*
  X-Frame-Options: DENY

# Classroom survey: never framed, cached or indexed.
/cuestionarios
  X-Frame-Options: DENY
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  Referrer-Policy: no-referrer
  Cache-Control: no-store
/cuestionarios/*
  X-Frame-Options: DENY
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  Referrer-Policy: no-referrer
  Cache-Control: no-store
